# SPEC_042: dikta.me Website Environment Variables
# DO NOT COMMIT THIS FILE TO GIT

# Supabase Configuration
# Use "Publishable Key" (new) or "anon key" (legacy)
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here

# Server-side only (NEVER expose to client)
# Use "Secret Key" (new) or "service_role key" (legacy)
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key-here

# Gemini API Key (operator master key for wallet proxy)
GEMINI_API_KEY=your-gemini-api-key-here

# Deepgram API Key (operator master key for wallet proxy STT)
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# Budget Cap (monthly safety limit in USD)
BUDGET_CAP_USD=80.00

# ── Wallet Edge Function Secrets ──
# Set these via: supabase secrets set KEY=value

# LemonSqueezy webhook signing secret (for signature validation)
# LEMON_SIGNING_SECRET=your-lemonsqueezy-signing-secret

# Admin secret (for manual grants and Operation Liquidity)
# ADMIN_SECRET=your-admin-secret-here

# Dev grant secret (for testing only — remove before go-live)
# DEV_SECRET=your-dev-secret-here

# Ko-fi webhook verification token (Edge Function secret)
# Set via: supabase secrets set KOFI_VERIFICATION_TOKEN=your-token
# KOFI_VERIFICATION_TOKEN=your-kofi-verification-token

# ── Admin Dashboard ──

# LemonSqueezy API key (for sales data in admin dashboard)
# LEMON_SQUEEZY_API_KEY=your-lemonsqueezy-api-key

# Resend API key (for email notifications — license gifts)
# RESEND_API_KEY=your-resend-api-key

# ── Analytics & Tracking ──

# Meta (Facebook) Pixel ID — enables fbevents.js via MetaPixel.tsx component
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id
