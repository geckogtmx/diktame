# EditorConfig — dIKta.me V2
# https://editorconfig.org

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,csx}]
indent_size = 4

# C# code style settings
[*.cs]

# Namespace declarations
csharp_style_namespace_declarations = file_scoped:warning

# Use 'var' when type is apparent
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expression-bodied members
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# Pattern matching
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning

# Null checking
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion

# Code block
csharp_prefer_braces = true:warning

# Usings
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Formatting
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Naming conventions
dotnet_naming_rule.interface_should_be_begins_with_i.severity = warning
dotnet_naming_rule.interface_should_be_begins_with_i.symbols = interface
dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i

dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.interface.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected

dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

dotnet_naming_rule.private_field_should_be_underscore_camel.severity = warning
dotnet_naming_rule.private_field_should_be_underscore_camel.symbols = private_field
dotnet_naming_rule.private_field_should_be_underscore_camel.style = underscore_camel

dotnet_naming_symbols.private_field.applicable_kinds = field
dotnet_naming_symbols.private_field.applicable_accessibilities = private

dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# ── Meziantou.Analyzer ──────────────────────────────────────────────────
# AI-coding safeguards: culture sensitivity, method length, disposal, threading

# MA0002: Use IEqualityComparer<string> — suppress (ordinal is fine for internal keys)
dotnet_diagnostic.MA0002.severity = none

# MA0003: Add [MethodImpl(AggressiveInlining)] — noise, micro-optimization
dotnet_diagnostic.MA0003.severity = none

# MA0004: Use ConfigureAwait(false) — disabled (WinUI 3 needs sync context)
dotnet_diagnostic.MA0004.severity = none

# MA0006: Use string.Equals — warning (AI uses == for strings without thinking about culture)
dotnet_diagnostic.MA0006.severity = warning

# MA0009: Add regex evaluation timeout — none (our regexes are short, bounded input)
dotnet_diagnostic.MA0009.severity = none

# MA0011: Use IFormatProvider — AI often forgets culture-invariant formatting
dotnet_diagnostic.MA0011.severity = warning

# MA0016: Prefer returning collection abstraction — none (we return concrete types intentionally)
dotnet_diagnostic.MA0016.severity = none

# MA0038: Use ConcurrentDictionary instead of locking Dictionary
dotnet_diagnostic.MA0038.severity = suggestion

# MA0046: Use EventHandler<T> — none (we use custom delegate signatures for pipeline events)
dotnet_diagnostic.MA0046.severity = none

# MA0048: File name must match type name — we have multi-type files intentionally
dotnet_diagnostic.MA0048.severity = none

# MA0049: Type name must match file name — same reason
dotnet_diagnostic.MA0049.severity = none

# MA0051: Method too long — AI generates bloated methods
# Pipeline RunAsync methods are sequential stage orchestrators (inherently long).
# 150 lines / 80 statements still catches genuinely bloated methods.
dotnet_diagnostic.MA0051.severity = warning
MA0051.maximum_lines_per_method = 150
MA0051.maximum_statements_per_method = 80

# MA0074: Avoid implicit culture-sensitive ToString
dotnet_diagnostic.MA0074.severity = warning

# MA0132: Do not convert implicitly to DateTimeOffset — none (not applicable)
dotnet_diagnostic.MA0132.severity = none

[*.{xml,xaml,csproj,props,targets}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
