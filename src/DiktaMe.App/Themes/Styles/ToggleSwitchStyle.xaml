<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Modern ToggleSwitch — compact sizing, theme-aware colors.
         Color customization is via ThemeResource key overrides in SharedResources.xaml
         (ToggleSwitchFillOn, ToggleSwitchKnobFillOff, etc.), mutated by ThemeService.
         The default WinUI 3 ControlTemplate is preserved. -->

    <!-- Override built-in theme resources to make toggle more compact.
         ToggleSwitchThemeMinWidth defaults to 154px (!), PreContent/PostContent add 10px row margins. -->
    <x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double>
    <x:Double x:Key="ToggleSwitchPreContentMargin">0</x:Double>
    <x:Double x:Key="ToggleSwitchPostContentMargin">0</x:Double>

    <Style TargetType="ToggleSwitch">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

</ResourceDictionary>
