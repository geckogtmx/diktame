<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- SegmentedButton: Boxed iOS-style Cloud/Local toggle
         Usage: Container StackPanel with Padding/Border manages layout.
         These simply swap Backgrounds on active/inactive. -->

    <!-- Shared base style (INACTIVE) -->
    <Style x:Key="SegmentedButtonBase" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource AppTextDimBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="24,6"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <!-- ACTIVE style: Subtle glass background, bright text -->
    <Style x:Key="SegmentedActiveStyle" TargetType="Button" BasedOn="{StaticResource SegmentedButtonBase}">
        <Setter Property="Background" Value="{StaticResource AppSurfaceTranslucentBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
    </Style>

    <!-- Legacy names kept so AIEngineSettingsPage bindings don't break -->
    <Style x:Key="SegmentedLeftStyle" TargetType="Button" BasedOn="{StaticResource SegmentedButtonBase}"/>
    <Style x:Key="SegmentedRightStyle" TargetType="Button" BasedOn="{StaticResource SegmentedButtonBase}"/>

    <Style x:Key="SegmentedLeftActiveStyle" TargetType="Button" BasedOn="{StaticResource SegmentedActiveStyle}"/>
    <Style x:Key="SegmentedRightActiveStyle" TargetType="Button" BasedOn="{StaticResource SegmentedActiveStyle}"/>

</ResourceDictionary>
