<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Ember — Warm Dark Theme (Amber/Purple accents) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0D0806"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="AppSurface2Brush" Color="#252525"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#FFFFFF14"/>
    <SolidColorBrush x:Key="AppNavActiveBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="AppAccentBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="AppTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppTextDimBrush" Color="#FFFFFF99"/>
    <SolidColorBrush x:Key="AppPerfGreenBrush" Color="#7aff9e"/>

</ResourceDictionary>
