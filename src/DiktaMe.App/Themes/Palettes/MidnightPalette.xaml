<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Midnight — Cool Dark Theme (Blue/Cyan accents) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0A0918"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#16152E"/>
    <SolidColorBrush x:Key="AppSurface2Brush" Color="#1E1D38"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#FFFFFF14"/>
    <SolidColorBrush x:Key="AppNavActiveBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AppAccentBrush" Color="#5DEBFF"/>
    <SolidColorBrush x:Key="AppTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppTextDimBrush" Color="#FFFFFF99"/>
    <SolidColorBrush x:Key="AppPerfGreenBrush" Color="#7aff9e"/>

</ResourceDictionary>
