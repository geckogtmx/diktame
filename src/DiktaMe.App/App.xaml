<Application
    x:Class="DiktaMe.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DiktaMe.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/SharedResources.xaml"/>
                <ResourceDictionary Source="ms-appx:///Themes/Styles/ToggleSwitchStyle.xaml"/>
                <ResourceDictionary Source="ms-appx:///Themes/Styles/SliderStyle.xaml"/>
                <ResourceDictionary Source="ms-appx:///Themes/Styles/InputStyles.xaml"/>
                <ResourceDictionary Source="ms-appx:///Themes/Styles/SegmentedButtonStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ── App Theme Brush Placeholders ──────────────────────────────
                 These live at the ROOT flat level (not in a MergedDictionary)
                 so ThemeService.ApplyTheme() can find and mutate them via
                 resources.TryGetValue() — guaranteed same object identity as
                 what XAML {StaticResource} bindings hold.
                 Initial values match Midnight palette as safe fallback.
                 DO NOT tune colors here — edit ThemePalette in ThemeService.cs.
                 ─────────────────────────────────────────────────────────────── -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0A0918"/>
            <SolidColorBrush x:Key="AppBackgroundTranslucentBrush" Color="#D00A0918"/>
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#16152E"/>
            <SolidColorBrush x:Key="AppSurfaceTranslucentBrush" Color="#A016152E"/>
            <SolidColorBrush x:Key="AppSurface2Brush" Color="#1E1D38"/>
            <SolidColorBrush x:Key="AppSurface2TranslucentBrush" Color="#701E1D38"/>
            <SolidColorBrush x:Key="AppBorderBrush" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="AppNavActiveBrush" Color="#3B82F6"/>
            <SolidColorBrush x:Key="AppAccentBrush" Color="#5DEBFF"/>
            <SolidColorBrush x:Key="AppTextBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AppTextDimBrush" Color="#99FFFFFF"/>
            <SolidColorBrush x:Key="AppPerfGreenBrush" Color="#7aff9e"/>

            <!-- ── WinUI Control ThemeResource Placeholder Brushes ─────────────
                 These brush objects exist SOLELY as mutation targets for ThemeService.
                 Their initial color values are overwritten by ThemeService.ApplyTheme()
                 before the UI becomes visible (called during app startup).

                 DO NOT manually tune colors here. All color definitions live in
                 ThemeService.Palettes (ThemePalette records in ThemeService.cs).
                 Adding a new theme requires ONLY a new ThemePalette entry there.

                 Both "Default" and "Light" dictionaries must contain the same keys
                 so ThemeService can find and mutate brushes regardless of which
                 ElementTheme is currently active.
                 ─────────────────────────────────────────────────────────────── -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- System accent color overrides -->
                    <Color x:Key="SystemAccentColor">#5DEBFF</Color>
                    <Color x:Key="SystemAccentColorLight1">#5DEBFF</Color>
                    <Color x:Key="SystemAccentColorLight2">#5DEBFF</Color>
                    <Color x:Key="SystemAccentColorLight3">#5DEBFF</Color>
                    <Color x:Key="SystemAccentColorDark1">#5DEBFF</Color>
                    <Color x:Key="SystemAccentColorDark2">#5DEBFF</Color>
                    <Color x:Key="SystemAccentColorDark3">#5DEBFF</Color>

                    <!-- Slider -->
                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#5DEBFF"/>
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#5DEBFF"/>
                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#5DEBFF"/>
                    <SolidColorBrush x:Key="SliderTrackFill" Color="#1E1D38"/>
                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#1E1D38"/>
                    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#1E1D38"/>
                    <SolidColorBrush x:Key="SliderThumbBackground" Color="White"/>
                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White"/>
                    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#E0E0E0"/>

                    <!-- TextBox -->
                    <SolidColorBrush x:Key="TextControlBackground" Color="#1E1D38"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1E1D38"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1D38"/>
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#0AFFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#40FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#5DEBFF"/>
                    <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#99FFFFFF"/>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0,0,0,2</Thickness>

                    <!-- ComboBox -->
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#1E1D38"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#1E1D38"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#1E1D38"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#0AFFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#40FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#5DEBFF"/>
                    <SolidColorBrush x:Key="ComboBoxForeground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#1E1D38"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#18FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#18FFFFFF"/>

                    <!-- ListView — selected item -->
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#1AFFFFFF"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#22FFFFFF"/>
                    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#3B82F6"/>

                    <!-- Sub-nav selected item (settings pages only) -->
                    <SolidColorBrush x:Key="SubNavItemBackgroundSelected" Color="#3B82F6"/>
                    <SolidColorBrush x:Key="SubNavItemForegroundSelected" Color="#0A0918"/>

                    <!-- ToggleSwitch — track fill -->
                    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#70E0FF"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#70E0FF"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#70E0FF"/>

                    <!-- ToggleSwitch — track stroke -->
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#99FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#99FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#70E0FF"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#70E0FF"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#70E0FF"/>

                    <!-- ToggleSwitch — knob fill -->
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#99FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#99FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#99FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#E0E0E0"/>

                    <!-- ToggleSwitch — container -->
                    <SolidColorBrush x:Key="ToggleSwitchContainerBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleSwitchContainerBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleSwitchContainerBackgroundPressed" Color="Transparent"/>

                    <!-- ToggleSwitch — content (On/Off label) foreground -->
                    <SolidColorBrush x:Key="ToggleSwitchOnContentForeground" Color="#99FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleSwitchOffContentForeground" Color="#99FFFFFF"/>

                    <!-- NavigationView -->
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#0A0918"/>
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#B3FFFFFF"/>
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#05FFFFFF"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#0AFFFFFF"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#3B82F6"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#3B82F6"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#3B82F6"/>
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#0EA5E9</Color>
                    <Color x:Key="SystemAccentColorLight1">#0EA5E9</Color>
                    <Color x:Key="SystemAccentColorLight2">#0EA5E9</Color>
                    <Color x:Key="SystemAccentColorLight3">#0EA5E9</Color>
                    <Color x:Key="SystemAccentColorDark1">#0EA5E9</Color>
                    <Color x:Key="SystemAccentColorDark2">#0EA5E9</Color>
                    <Color x:Key="SystemAccentColorDark3">#0EA5E9</Color>

                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#0EA5E9"/>
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#0EA5E9"/>
                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#0EA5E9"/>
                    <SolidColorBrush x:Key="SliderTrackFill" Color="#F2F4FF"/>
                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#F2F4FF"/>
                    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#F2F4FF"/>
                    <SolidColorBrush x:Key="SliderThumbBackground" Color="#1A1A2E"/>
                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#1A1A2E"/>
                    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#333344"/>

                    <SolidColorBrush x:Key="TextControlBackground" Color="#F2F4FF"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#F2F4FF"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#F2F4FF"/>
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#0A000000"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#40000000"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#0EA5E9"/>
                    <SolidColorBrush x:Key="TextControlForeground" Color="#1A1A2E"/>
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#1A1A2E99"/>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0,0,0,2</Thickness>

                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#F2F4FF"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F2F4FF"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#F2F4FF"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#0A000000"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#40000000"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#0EA5E9"/>
                    <SolidColorBrush x:Key="ComboBoxForeground" Color="#1A1A2E"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F2F4FF"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#14000000"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="#1A1A2E"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#0A000000"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#0A000000"/>

                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#14000000"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#1A000000"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#22000000"/>
                    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#1A1A2E"/>
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#38BDF8"/>

                    <SolidColorBrush x:Key="SubNavItemBackgroundSelected" Color="#38BDF8"/>
                    <SolidColorBrush x:Key="SubNavItemForegroundSelected" Color="#F0F4FF"/>

                    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#38BDF8"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#38BDF8"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#38BDF8"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#14000000"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#1A1A2E99"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#1A1A2E99"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#38BDF8"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#38BDF8"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#38BDF8"/>
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#1A1A2E99"/>
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#1A1A2E99"/>
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#1A1A2E99"/>
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#1A1A2E"/>
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#1A1A2E"/>
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#333344"/>
                    <SolidColorBrush x:Key="ToggleSwitchContainerBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleSwitchContainerBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleSwitchContainerBackgroundPressed" Color="Transparent"/>

                    <SolidColorBrush x:Key="ToggleSwitchOnContentForeground" Color="#1A1A2E99"/>
                    <SolidColorBrush x:Key="ToggleSwitchOffContentForeground" Color="#1A1A2E99"/>

                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#F0F4FF"/>
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#1A1A2EB3"/>
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#1A1A2E"/>
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#1A1A2E"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#05000000"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#0A000000"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#38BDF8"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#38BDF8"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#38BDF8"/>
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#1A1A2E"/>
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#1A1A2E"/>
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#1A1A2E"/>
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

