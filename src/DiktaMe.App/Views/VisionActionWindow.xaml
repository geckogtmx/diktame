<Window x:Class="DiktaMe.App.Views.VisionActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vision">

    <ContentControl FontFamily="{StaticResource AppFont}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid Padding="16" RowSpacing="12" Background="{StaticResource AppSurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Thumbnail + Edit button -->
            <Grid Grid.Row="0" HorizontalAlignment="Center">
                <Border CornerRadius="6" Padding="4">
                    <Image x:Name="ThumbnailImage" MaxHeight="160" MaxWidth="360"
                           Stretch="Uniform"/>
                </Border>
                <Button Click="OnEdit" ToolTipService.ToolTip="Annotate screenshot"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,0,-4,-4" Padding="6" Opacity="0.85">
                    <FontIcon Glyph="&#xED63;" FontSize="14"/>
                </Button>
            </Grid>

            <!-- Text input + mic button -->
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="QueryInput" Grid.Column="0"
                         PlaceholderText="What should I look for? (optional)"
                         AcceptsReturn="False" MaxLength="500"
                         Foreground="{StaticResource AppTextBrush}"
                         KeyDown="QueryInput_KeyDown"/>
                <Button x:Name="MicButton" Grid.Column="1" Click="OnMicToggle"
                        Width="36" Height="36" Padding="0"
                        ToolTipService.ToolTip="Dictate query (click to start/stop)"
                        VerticalAlignment="Center">
                    <Grid>
                        <FontIcon x:Name="MicIcon" Glyph="&#xE720;" FontSize="16"/>
                        <Ellipse x:Name="RecordingDot" Width="8" Height="8"
                                 Fill="Red" Opacity="0"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,-2,-2,0"/>
                    </Grid>
                </Button>
            </Grid>

            <!-- Local/Cloud/None toggle -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16"
                        HorizontalAlignment="Center">
                <RadioButton x:Name="LocalRadio" Content="Quick (Local)" GroupName="Provider"
                             Foreground="{StaticResource AppTextBrush}"/>
                <RadioButton x:Name="CloudRadio" Content="Detailed (Cloud)" GroupName="Provider"
                             Foreground="{StaticResource AppTextBrush}"/>
                <RadioButton x:Name="NoneRadio" Content="None" GroupName="Provider"
                             Foreground="{StaticResource AppTextBrush}"
                             ToolTipService.ToolTip="No AI processing — raw image only"/>
            </StackPanel>

            <!-- Action buttons: 4×2 grid -->
            <Grid Grid.Row="3" ColumnSpacing="8" RowSpacing="8" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Click="OnSave" MinWidth="110" Grid.Row="0" Grid.Column="0"
                        ToolTipService.ToolTip="Save screenshot to file + copy image to clipboard">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                        <TextBlock Text="Save"/>
                    </StackPanel>
                </Button>

                <Button Click="OnClipboard" MinWidth="110" Grid.Row="0" Grid.Column="1"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="No query = copy image; with query = AI analysis to clipboard">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                        <TextBlock Text="Clipboard"/>
                    </StackPanel>
                </Button>

                <Button Click="OnChat" MinWidth="110" Grid.Row="0" Grid.Column="2"
                        ToolTipService.ToolTip="Open QuickChat with image attached">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8BD;" FontSize="14"/>
                        <TextBlock Text="Chat"/>
                    </StackPanel>
                </Button>

                <Button Click="OnNote" MinWidth="110" Grid.Row="1" Grid.Column="0"
                        ToolTipService.ToolTip="Analyze image, then record a voice note">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE70B;" FontSize="14"/>
                        <TextBlock Text="Note"/>
                    </StackPanel>
                </Button>

                <Button Click="OnOcr" MinWidth="110" Grid.Row="1" Grid.Column="1"
                        ToolTipService.ToolTip="Extract all text from image (OCR) to clipboard">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8D4;" FontSize="14"/>
                        <TextBlock Text="OCR"/>
                    </StackPanel>
                </Button>

                <Button Click="OnTable" MinWidth="110" Grid.Row="1" Grid.Column="2"
                        ToolTipService.ToolTip="Extract tabular data as TSV to clipboard">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE80A;" FontSize="14"/>
                        <TextBlock Text="Table"/>
                    </StackPanel>
                </Button>

                <Button Click="OnColor" MinWidth="110" Grid.Row="1" Grid.Column="3"
                        ToolTipService.ToolTip="Pick a color from the screenshot — hex copied to clipboard">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEF3C;" FontSize="14"/>
                        <TextBlock Text="Color"/>
                    </StackPanel>
                </Button>

                <Button Click="OnRecord" MinWidth="110" Grid.Row="0" Grid.Column="3"
                        ToolTipService.ToolTip="Record a video clip of this screen region">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7C8;" FontSize="14"/>
                        <TextBlock Text="Record"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </ContentControl>
</Window>
