<Window x:Class="DiktaMe.App.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dIKta.me">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="dIKta.me" FontSize="28" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

        <ProgressRing Grid.Row="1" IsActive="True" Width="48" Height="48"
                      HorizontalAlignment="Center"/>

        <ProgressBar Grid.Row="2" Width="250"
                     Minimum="0" Maximum="100"
                     Value="{x:Bind ViewModel.Progress, Mode=OneWay}"/>

        <TextBlock Grid.Row="3"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   FontSize="13" Opacity="0.7" HorizontalAlignment="Center"/>
    </Grid>
</Window>
