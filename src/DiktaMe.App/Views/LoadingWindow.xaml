<Window x:Class="DiktaMe.App.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dIKta.me">

    <ContentControl FontFamily="{StaticResource AppFont}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="0,32,0,40">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo (smaller than before, matches V1 proportions) -->
            <Image Grid.Row="0" Source="ms-appx:///Assets/loading-logo.png"
                   Width="90" Height="90" HorizontalAlignment="Center"/>

            <!-- Version number below logo -->
            <TextBlock Grid.Row="1" x:Name="VersionText"
                       FontSize="11" Foreground="{StaticResource AppTextDimBrush}"
                       HorizontalAlignment="Center"/>

            <!-- Spacer row 2 -->

            <!-- Bold status heading (WARMING UP, LOADING SETTINGS, etc.) -->
            <TextBlock Grid.Row="3" x:Name="StatusHeading"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource AppTextBrush}" CharacterSpacing="80"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>

            <!-- Subtitle description -->
            <TextBlock Grid.Row="4" x:Name="StatusSubtitle"
                       FontSize="12" Foreground="{StaticResource AppTextDimBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>

            <!-- Spacer row 5 -->

            <!-- Subtle progress bar -->
            <ProgressBar Grid.Row="6" Width="280" Height="3"
                         Minimum="0" Maximum="100"
                         Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                         Foreground="{StaticResource AppAccentBrush}" Background="{StaticResource AppSurface2Brush}"/>
        </Grid>
    </Grid>
    </ContentControl>
</Window>
