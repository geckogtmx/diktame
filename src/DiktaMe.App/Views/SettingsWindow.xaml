<Window
    x:Class="DiktaMe.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:settings="using:DiktaMe.App.Views.Settings"
    xmlns:l="using:WinUI3Localizer"
    Title="dIKta.me — Settings">

    <Grid x:Name="RootGrid">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop x:Name="BgGradStart" Offset="0.0"/>
                <GradientStop x:Name="BgGradMid" Offset="0.5"/>
                <GradientStop x:Name="BgGradEnd" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>
    <muxc:NavigationView x:Name="NavView"
                         PaneDisplayMode="Left"
                         IsBackButtonVisible="Collapsed"
                         IsSettingsVisible="False"
                         IsPaneToggleButtonVisible="False"
                         SelectionChanged="NavView_SelectionChanged"
                         DoubleTapped="NavView_DoubleTapped"
                         OpenPaneLength="250"
                         Background="{StaticResource AppBackgroundTranslucentBrush}"
                         FontFamily="{StaticResource AppFont}">
        <muxc:NavigationView.PaneFooter>
            <settings:UserPaneFooter x:Name="UserFooter"/>
        </muxc:NavigationView.PaneFooter>
        <muxc:NavigationView.PaneHeader>
            <!-- Native Pane Header keeps the logo explicitly outside the logical item sequence -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,8">
                <ImageIcon Source="ms-appx:///Assets/icon.png" Width="28" Height="28"/>
                <TextBlock Text="dIKta.me" FontSize="20" FontFamily="{StaticResource AppFontSemiBold}"
                           Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </muxc:NavigationView.PaneHeader>
        <muxc:NavigationView.MenuItems>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_General" Tag="general">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_Hardware" Tag="hardware">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE720;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_AIEngine" Tag="aiengine">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE964;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_Workflows" Tag="workflows">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE20B;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_DictationPresets" Tag="presets">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE71D;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_Snippets" Tag="snippets">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE943;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_Privacy" Tag="privacy">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE72E;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem x:Name="NavAccountItem" l:Uids.Uid="Nav_Account" Tag="account">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE77B;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_About" Tag="about">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE946;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
        </muxc:NavigationView.MenuItems>

        <Frame x:Name="ContentFrame"
               Background="{StaticResource AppSurface2TranslucentBrush}"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>
    </muxc:NavigationView>

    <!-- Subtle accent glow overlay in the top right -->
    <Border IsHitTestVisible="False"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border.Background>
            <LinearGradientBrush StartPoint="1,0" EndPoint="0.6,0.4">
                <GradientStop x:Name="GlowStop1" Offset="0.0"/>
                <GradientStop x:Name="GlowStop2" Offset="0.4"/>
                <GradientStop x:Name="GlowStop3" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
    </Border>

    <!-- Glassmorphic gradient overlay — subtle purple/magenta diagonal sweep.
         IsHitTestVisible=False lets all input pass through to controls below.
         Gradient stop colors are updated by code-behind on theme change. -->
    <Border IsHitTestVisible="False">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                <GradientStop x:Name="GlassStop1" Color="Transparent" Offset="0.0"/>
                <GradientStop x:Name="GlassStop2" Color="Transparent" Offset="0.35"/>
                <GradientStop x:Name="GlassStop3" Color="Transparent" Offset="0.6"/>
                <GradientStop x:Name="GlassStop4" Color="Transparent" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
    </Border>
    </Grid>
</Window>
