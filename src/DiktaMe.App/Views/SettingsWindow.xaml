<Window
    x:Class="DiktaMe.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:settings="using:DiktaMe.App.Views.Settings"
    xmlns:l="using:WinUI3Localizer"
    Title="dIKta.me — Settings">

    <Grid>
    <muxc:NavigationView x:Name="NavView"
                         PaneDisplayMode="Left"
                         IsBackButtonVisible="Collapsed"
                         IsSettingsVisible="False"
                         IsPaneToggleButtonVisible="False"
                         SelectionChanged="NavView_SelectionChanged"
                         DoubleTapped="NavView_DoubleTapped"
                         OpenPaneLength="250"
                         Background="{StaticResource AppBackgroundBrush}"
                         FontFamily="{StaticResource AppFont}">
        <muxc:NavigationView.PaneHeader>
            <StackPanel Orientation="Horizontal" Spacing="8" Padding="16,16,16,8">
                <Image Source="ms-appx:///Assets/icon.png" Width="28" Height="28"
                       VerticalAlignment="Center"/>
                <TextBlock Text="dIKta.me" FontSize="16"
                           FontFamily="{StaticResource AppFontSemiBold}"
                           Foreground="{StaticResource AppAccentBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </muxc:NavigationView.PaneHeader>
        <muxc:NavigationView.PaneFooter>
            <settings:UserPaneFooter x:Name="UserFooter"/>
        </muxc:NavigationView.PaneFooter>
        <muxc:NavigationView.MenuItems>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_General" Tag="general" Margin="16,0,0,0">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_Hardware" Tag="hardware" Margin="16,0,0,0">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE720;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_AIEngine" Tag="aiengine" Margin="16,0,0,0">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE774;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_Workflows" Tag="workflows" Margin="16,0,0,0">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE762;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_DictationPresets" Tag="presets" Margin="16,0,0,0">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE71D;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_Snippets" Tag="snippets" Margin="16,0,0,0">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8FD;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_Privacy" Tag="privacy" Margin="16,0,0,0">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE72E;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem x:Name="NavAccountItem" l:Uids.Uid="Nav_Account" Tag="account" Margin="16,0,0,0">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE77B;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_About" Tag="about" Margin="16,0,0,0">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE946;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
        </muxc:NavigationView.MenuItems>

        <Frame x:Name="ContentFrame"
               Background="{StaticResource AppSurface2Brush}"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>
    </muxc:NavigationView>

    <!-- Glassmorphic gradient overlay — subtle purple/magenta diagonal sweep.
         IsHitTestVisible=False lets all input pass through to controls below. -->
    <Border IsHitTestVisible="False">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                <GradientStop Color="#00161530" Offset="0.0"/>
                <GradientStop Color="#30663399" Offset="0.35"/>
                <GradientStop Color="#20993366" Offset="0.6"/>
                <GradientStop Color="#00161530" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
    </Border>
    </Grid>
</Window>
