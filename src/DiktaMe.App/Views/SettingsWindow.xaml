<Window
    x:Class="DiktaMe.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:settings="using:DiktaMe.App.Views.Settings"
    xmlns:l="using:WinUI3Localizer"
    Title="dIKta.me — Settings">

    <muxc:NavigationView x:Name="NavView"
                         PaneDisplayMode="Left"
                         IsBackButtonVisible="Collapsed"
                         IsSettingsVisible="False"
                         SelectionChanged="NavView_SelectionChanged"
                         DoubleTapped="NavView_DoubleTapped"
                         OpenPaneLength="210"
                         Background="{StaticResource V1BackgroundBrush}">
        <muxc:NavigationView.Resources>
            <!-- V1 pane backgrounds -->
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#002029"/>
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#002029"/>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#002a35"/>
            <!-- Nav item text/icon colors -->
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#e0e0e0"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#e0e0e0"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#e0e0e0"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#e0e0e0"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#e0e0e0"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#bbbbbb"/>
            <!-- Selected indicator + background -->
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#00607a"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#00303d"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#004052"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#003a4d"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#00303d"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#003a4d"/>
            <!-- Hamburger/toggle button -->
            <SolidColorBrush x:Key="NavigationViewButtonForegroundPointerOver" Color="#e0e0e0"/>
            <SolidColorBrush x:Key="NavigationViewButtonForegroundPressed" Color="#bbbbbb"/>
        </muxc:NavigationView.Resources>
        <muxc:NavigationView.PaneFooter>
            <settings:UserPaneFooter x:Name="UserFooter"/>
        </muxc:NavigationView.PaneFooter>
        <muxc:NavigationView.MenuItems>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_General" Tag="general">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_Hardware" Tag="hardware">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE720;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_AIEngine" Tag="aiengine">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE774;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_Workflows" Tag="workflows">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE762;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_DictationPresets" Tag="presets">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE71D;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_Snippets" Tag="snippets">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8FD;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_Privacy" Tag="privacy">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE72E;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem x:Name="NavAccountItem" l:Uids.Uid="Nav_Account" Tag="account">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE77B;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem l:Uids.Uid="Nav_About" Tag="about">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE946;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
        </muxc:NavigationView.MenuItems>

        <Frame x:Name="ContentFrame"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>
    </muxc:NavigationView>
</Window>
