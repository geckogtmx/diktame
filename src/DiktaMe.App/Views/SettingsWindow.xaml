<Window
    x:Class="DiktaMe.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:settings="using:DiktaMe.App.Views.Settings"
    Title="dIKta.me — Settings">

    <muxc:NavigationView x:Name="NavView"
                         PaneDisplayMode="Left"
                         IsBackButtonVisible="Collapsed"
                         IsSettingsVisible="False"
                         SelectionChanged="NavView_SelectionChanged"
                         OpenPaneLength="180">
        <muxc:NavigationView.PaneFooter>
            <settings:UserPaneFooter x:Name="UserFooter"/>
        </muxc:NavigationView.PaneFooter>
        <muxc:NavigationView.MenuItems>
            <muxc:NavigationViewItem Content="Account" Tag="account">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE77B;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="General" Tag="general">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Hotkeys" Tag="hotkeys">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE765;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="AI Engine" Tag="aiengine">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE774;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Dictation Presets" Tag="dictationmodes">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE70F;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Modes" Tag="modes">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE762;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Audio" Tag="audio">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE720;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Privacy" Tag="privacy">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE72E;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="API Keys" Tag="apikeys">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8D7;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Ollama" Tag="ollama">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE968;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Snippets" Tag="snippets">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8FD;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Control Panel" Tag="controlpanel">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7B5;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="About" Tag="about">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE946;"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
        </muxc:NavigationView.MenuItems>

        <Frame x:Name="ContentFrame"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>
    </muxc:NavigationView>
</Window>
