<Window x:Class="DiktaMe.App.Views.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:WinUI3Localizer"
        Title="dIKta.me — Setup Wizard">

    <Grid RowSpacing="16" Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Progress indicator -->
        <StackPanel Spacing="8">
            <TextBlock x:Name="StepLabel" FontSize="12" Opacity="0.5"/>
            <ProgressBar x:Name="StepProgress" Minimum="0" Maximum="7" Value="0" Height="4"/>
        </StackPanel>

        <!-- Content frame -->
        <Frame x:Name="ContentFrame" Grid.Row="1"/>

        <!-- Navigation buttons -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="HaveKeyButton" l:Uids.Uid="Wizard_HaveKey"
                    Grid.Column="0" Visibility="Collapsed"
                    Click="HaveKeyButton_Click">
                <Button.Resources>
                    <StaticResource x:Key="ButtonBackground" ResourceKey="SystemFillColorCriticalBrush"/>
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SystemFillColorCriticalBrush"/>
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SystemFillColorCriticalBrush"/>
                    <StaticResource x:Key="ButtonForeground" ResourceKey="TextOnAccentFillColorPrimaryBrush"/>
                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush"/>
                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextOnAccentFillColorSecondaryBrush"/>
                </Button.Resources>
            </Button>

            <Button x:Name="BackButton" l:Uids.Uid="Wizard_BackButton" Grid.Column="2"
                    Command="{x:Bind ViewModel.GoBackCommand}"
                    Visibility="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"/>

            <Button x:Name="NextButton" Grid.Column="3"
                    Content="{x:Bind ViewModel.NextButtonText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.GoNextCommand}"
                    IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}"/>
        </Grid>
    </Grid>
</Window>
