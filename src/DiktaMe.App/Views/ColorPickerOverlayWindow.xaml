<Window x:Class="DiktaMe.App.Views.ColorPickerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DiktaMe.App.Views"
        Title="dIKta.me Color Picker">

    <Grid>
        <!-- Screenshot of the screen as background (frozen frame) -->
        <Image x:Name="ScreenshotImage" Stretch="Fill" />

        <!-- Overlay canvas for cursor tracking -->
        <local:CrosshairCanvas x:Name="OverlayCanvas" Background="Transparent" />

        <!-- Color preview popup (follows cursor) -->
        <Border x:Name="ColorPreview"
                CornerRadius="6" Padding="8,6"
                Background="#E0202020"
                BorderBrush="#60FFFFFF" BorderThickness="1"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border x:Name="ColorSwatch" Width="24" Height="24"
                        CornerRadius="4" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="HexText" Text="#000000"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="White" FontFamily="Consolas"/>
                    <TextBlock x:Name="RgbText" Text="rgb(0, 0, 0)"
                               FontSize="11" Foreground="#B0FFFFFF"
                               FontFamily="Consolas"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Palette strip (accumulated picks) -->
        <Border x:Name="PaletteContainer"
                CornerRadius="8" Padding="12,8"
                Background="#D0181818"
                BorderBrush="#40FFFFFF" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,60" Visibility="Collapsed"
                IsHitTestVisible="False">
            <StackPanel Spacing="6">
                <StackPanel x:Name="PalettePanel" Orientation="Horizontal" Spacing="6" />
                <TextBlock x:Name="PaletteCountText" Text=""
                           Foreground="#B0FFFFFF" FontSize="11"
                           HorizontalAlignment="Center" FontFamily="Consolas"/>
            </StackPanel>
        </Border>

        <!-- Bottom hint text -->
        <TextBlock Text="Click to pick colors  |  Enter = Done  |  Backspace = Undo  |  Esc = Cancel/Finish"
                   Foreground="White" FontSize="14" Opacity="0.8"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,32" IsHitTestVisible="False" />
    </Grid>
</Window>
