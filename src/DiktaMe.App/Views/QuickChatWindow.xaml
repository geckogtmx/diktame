<Window x:Class="DiktaMe.App.Views.QuickChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiktaMe.App.ViewModels"
        xmlns:l="using:WinUI3Localizer"
        xmlns:data="using:DiktaMe.Core.Data"
        xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
        Title="Quick Chat">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8"
              Background="{ThemeResource LayerOnMicaBaseAltFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="ModelComboBox"
                      ItemsSource="{x:Bind ViewModel.AvailableModels}"
                      SelectedValue="{x:Bind ViewModel.SelectedModelId, Mode=TwoWay}"
                      SelectedValuePath="ModelId"
                      DisplayMemberPath="DisplayName"
                      PlaceholderText="Default model"
                      MinWidth="160" MaxWidth="240" Height="32"
                      FontSize="12"/>

            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.ConversationTitle, Mode=OneWay}"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       FontSize="13" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" MaxWidth="200"/>

            <Button Grid.Column="2"
                    Click="HistoryButton_Click"
                    ToolTipService.ToolTip="Conversation history"
                    Width="32" Height="32" Padding="0">
                <FontIcon Glyph="&#xE81C;" FontSize="14"/>
                <Button.Flyout>
                    <Flyout x:Name="HistoryFlyout" Placement="BottomEdgeAlignedRight">
                        <StackPanel Width="280" MaxHeight="400">
                            <TextBlock Text="Recent Conversations" FontWeight="SemiBold"
                                       FontSize="13" Margin="0,0,0,8"/>
                            <ListView x:Name="HistoryList"
                                      ItemsSource="{x:Bind ViewModel.RecentConversations}"
                                      SelectionMode="Single"
                                      SelectionChanged="HistoryList_SelectionChanged"
                                      MaxHeight="340">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="4"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="data:ConversationRecord">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Title, TargetNullValue='Untitled'}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock FontSize="10" Opacity="0.5"
                                                               Text="{x:Bind MessageCount}"/>
                                                    <TextBlock FontSize="10" Opacity="0.5"
                                                               Text="messages"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Click="DeleteConversation_Click"
                                                    Tag="{x:Bind Id}"
                                                    ToolTipService.ToolTip="Delete"
                                                    Width="24" Height="24" Padding="0"
                                                    Background="Transparent" BorderThickness="0"
                                                    VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE74D;" FontSize="11" Opacity="0.5"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <Button Grid.Column="3"
                    Command="{x:Bind ViewModel.ToggleSystemPromptCommand}"
                    ToolTipService.ToolTip="Toggle system prompt"
                    Width="32" Height="32" Padding="0">
                <FontIcon Glyph="&#xE713;" FontSize="14"/>
            </Button>

            <ToggleButton Grid.Column="4"
                          IsChecked="{x:Bind ViewModel.WebSearchEnabled, Mode=TwoWay}"
                          ToolTipService.ToolTip="Web search (Gemini only)"
                          Width="32" Height="32" Padding="0">
                <FontIcon Glyph="&#xE774;" FontSize="14"/>
            </ToggleButton>

            <Button Grid.Column="5"
                    Click="ExportButton_Click"
                    ToolTipService.ToolTip="Export as Markdown"
                    Width="32" Height="32" Padding="0">
                <FontIcon Glyph="&#xE792;" FontSize="14"/>
            </Button>

            <Button Grid.Column="6"
                    Command="{x:Bind ViewModel.NewConversationCommand}"
                    ToolTipService.ToolTip="New conversation"
                    Width="32" Height="32" Padding="0">
                <FontIcon Glyph="&#xE710;" FontSize="14"/>
            </Button>
        </Grid>

        <!-- System prompt (collapsible) -->
        <Grid Grid.Row="1" Padding="12,4"
              Visibility="{x:Bind ViewModel.IsSystemPromptVisible, Mode=OneWay}"
              Background="{ThemeResource LayerOnMicaBaseAltFillColorTertiaryBrush}">
            <TextBox Text="{x:Bind ViewModel.SystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="System prompt..."
                     TextWrapping="Wrap" AcceptsReturn="True"
                     MaxHeight="100" FontSize="12"/>
        </Grid>

        <!-- Message list -->
        <ListView x:Name="MessageList" Grid.Row="2"
                  ItemsSource="{x:Bind ViewModel.Messages}"
                  SelectionMode="None" Padding="12,8,12,8">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatMessageViewModel">
                    <Grid>
                        <!-- User message: right-aligned, accent background -->
                        <Border Padding="12,8" CornerRadius="12,12,4,12"
                                HorizontalAlignment="Right"
                                Visibility="{x:Bind UserVisibility}"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap"
                                       FontSize="13" Foreground="White"/>
                        </Border>

                        <!-- Assistant message: left-aligned, subtle background -->
                        <StackPanel HorizontalAlignment="Left"
                                    Visibility="{x:Bind AssistantVisibility}">
                            <Border Padding="12,8" CornerRadius="12,12,12,4"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <controls:MarkdownTextBlock Text="{x:Bind Text, Mode=OneWay}"
                                           FontSize="13"
                                           Background="Transparent"
                                           IsTextSelectionEnabled="True"
                                           LinkClicked="MarkdownText_LinkClicked"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="2"
                                        HorizontalAlignment="Left" Margin="4,2,0,0">
                                <Button Click="CopyButton_Click"
                                        Tag="{x:Bind Text, Mode=OneWay}"
                                        ToolTipService.ToolTip="Copy to clipboard"
                                        Width="28" Height="24" Padding="0"
                                        Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" Opacity="0.5"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Thinking indicator -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Padding="20,0,0,12"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          Width="16" Height="16"/>
            <TextBlock Text="Thinking..." FontSize="12" Opacity="0.6"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Clipboard attachment badge -->
        <Border Grid.Row="3" Padding="12,6,12,0"
                Visibility="{x:Bind ViewModel.HasClipboardAttachment, Mode=OneWay}"
                Background="{ThemeResource LayerOnMicaBaseAltFillColorSecondaryBrush}">
            <Border Padding="8,4" CornerRadius="6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    HorizontalAlignment="Left" MaxWidth="400">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8C8;" FontSize="12" VerticalAlignment="Center"
                              Opacity="0.7"/>
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind ViewModel.ClipboardPreview, Mode=OneWay}"
                               FontSize="11" Opacity="0.7"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="2"
                            Command="{x:Bind ViewModel.ClearClipboardAttachmentCommand}"
                            ToolTipService.ToolTip="Remove clipboard context"
                            Width="20" Height="20" Padding="0"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE711;" FontSize="10"/>
                    </Button>
                </Grid>
            </Border>
        </Border>

        <!-- Input row -->
        <Grid Grid.Row="4" Padding="12,8,12,12" ColumnSpacing="8"
              Background="{ThemeResource LayerOnMicaBaseAltFillColorSecondaryBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Command="{x:Bind ViewModel.AttachClipboardCommand}"
                    ToolTipService.ToolTip="Attach clipboard content"
                    Width="32" Height="32" Padding="0"
                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                <FontIcon Glyph="&#xE723;" FontSize="14"/>
            </Button>

            <TextBox x:Name="InputBox" Grid.Column="1"
                     l:Uids.Uid="QuickChat_Input"
                     Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Type a message..."
                     TextWrapping="Wrap" AcceptsReturn="False"
                     KeyDown="InputBox_KeyDown"
                     IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"/>

            <Button Grid.Column="2"
                    l:Uids.Uid="QuickChat_SendButton"
                    Command="{x:Bind ViewModel.SendCommand}"
                    Style="{ThemeResource AccentButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                <FontIcon Glyph="&#xE724;" FontSize="14"/>
            </Button>

            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{x:Bind ViewModel.TokenCountText, Mode=OneWay}"
                       FontSize="10" Opacity="0.4"
                       HorizontalAlignment="Right" Margin="0,2,0,0"/>
        </Grid>
    </Grid>
</Window>
