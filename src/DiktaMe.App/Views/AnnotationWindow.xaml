<Window x:Class="DiktaMe.App.Views.AnnotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Annotate">

    <ContentControl FontFamily="{StaticResource AppFont}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid Background="#1E1E2E">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0" Background="#2D2D3D" Padding="8,6" BorderBrush="#3D3D4D" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <!-- Shape tools -->
                    <Button x:Name="ArrowBtn" Click="OnToolSelected" Tag="Arrow" ToolTipService.ToolTip="Arrow (1)" Padding="8,6">
                        <FontIcon Glyph="&#xE76C;" FontSize="16"/>
                    </Button>
                    <Button x:Name="RectBtn" Click="OnToolSelected" Tag="Rectangle" ToolTipService.ToolTip="Rectangle (2)" Padding="8,6">
                        <FontIcon Glyph="&#xE7FB;" FontSize="16"/>
                    </Button>
                    <Button x:Name="EllipseBtn" Click="OnToolSelected" Tag="Ellipse" ToolTipService.ToolTip="Ellipse (3)" Padding="8,6">
                        <FontIcon Glyph="&#xEA3A;" FontSize="16"/>
                    </Button>
                    <Button x:Name="FreehandBtn" Click="OnToolSelected" Tag="Freehand" ToolTipService.ToolTip="Freehand (4)" Padding="8,6">
                        <FontIcon Glyph="&#xEE56;" FontSize="16"/>
                    </Button>
                    <Button x:Name="TextBtn" Click="OnToolSelected" Tag="Text" ToolTipService.ToolTip="Text (5)" Padding="8,6">
                        <FontIcon Glyph="&#xE8D2;" FontSize="16"/>
                    </Button>
                    <Button x:Name="StepBtn" Click="OnToolSelected" Tag="Step" ToolTipService.ToolTip="Numbered Step (6)" Padding="8,6">
                        <FontIcon Glyph="&#xE8B2;" FontSize="16"/>
                    </Button>
                    <Button x:Name="HighlightBtn" Click="OnToolSelected" Tag="Highlight" ToolTipService.ToolTip="Highlight (7)" Padding="8,6">
                        <FontIcon Glyph="&#xE891;" FontSize="16"/>
                    </Button>
                    <Button x:Name="BlurBtn" Click="OnToolSelected" Tag="Blur" ToolTipService.ToolTip="Blur/Redact (8)" Padding="8,6">
                        <FontIcon Glyph="&#xED1A;" FontSize="16"/>
                    </Button>

                    <Border Width="1" Background="#4D4D5D" Margin="4,2"/>

                    <!-- Color swatches -->
                    <Button Click="OnColorSelected" Tag="#FF0000" ToolTipService.ToolTip="Red" Padding="2" MinWidth="28" MinHeight="28">
                        <Border Width="20" Height="20" CornerRadius="3" Background="#FF0000"/>
                    </Button>
                    <Button Click="OnColorSelected" Tag="#0078D4" ToolTipService.ToolTip="Blue" Padding="2" MinWidth="28" MinHeight="28">
                        <Border Width="20" Height="20" CornerRadius="3" Background="#0078D4"/>
                    </Button>
                    <Button Click="OnColorSelected" Tag="#00CC6A" ToolTipService.ToolTip="Green" Padding="2" MinWidth="28" MinHeight="28">
                        <Border Width="20" Height="20" CornerRadius="3" Background="#00CC6A"/>
                    </Button>
                    <Button Click="OnColorSelected" Tag="#FFB900" ToolTipService.ToolTip="Yellow" Padding="2" MinWidth="28" MinHeight="28">
                        <Border Width="20" Height="20" CornerRadius="3" Background="#FFB900"/>
                    </Button>
                    <Button Click="OnColorSelected" Tag="#FFFFFF" ToolTipService.ToolTip="White" Padding="2" MinWidth="28" MinHeight="28">
                        <Border Width="20" Height="20" CornerRadius="3" Background="#FFFFFF" BorderBrush="#666" BorderThickness="1"/>
                    </Button>
                    <Button Click="OnColorSelected" Tag="#000000" ToolTipService.ToolTip="Black" Padding="2" MinWidth="28" MinHeight="28">
                        <Border Width="20" Height="20" CornerRadius="3" Background="#000000" BorderBrush="#666" BorderThickness="1"/>
                    </Button>

                    <Border Width="1" Background="#4D4D5D" Margin="4,2"/>

                    <!-- Width slider -->
                    <TextBlock Text="Width:" VerticalAlignment="Center" Foreground="#CCC" Margin="4,0"/>
                    <Slider x:Name="WidthSlider" Minimum="1" Maximum="10" Value="3"
                            Width="100" VerticalAlignment="Center"/>

                    <Border Width="1" Background="#4D4D5D" Margin="4,2"/>

                    <!-- Undo/Redo -->
                    <Button x:Name="UndoBtn" Click="OnUndo" ToolTipService.ToolTip="Undo (Ctrl+Z)" Padding="8,6">
                        <FontIcon Glyph="&#xE7A7;" FontSize="16"/>
                    </Button>
                    <Button x:Name="RedoBtn" Click="OnRedo" ToolTipService.ToolTip="Redo (Ctrl+Y)" Padding="8,6">
                        <FontIcon Glyph="&#xE7A6;" FontSize="16"/>
                    </Button>

                    <!-- Annotation count -->
                    <TextBlock x:Name="CountText" Text="" VerticalAlignment="Center"
                               Foreground="#888" Margin="8,0,0,0" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Canvas area: screenshot background + drawing overlay -->
            <Grid Grid.Row="1">
                <Image x:Name="BackgroundImage" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Canvas x:Name="DrawingCanvas"
                        PointerPressed="OnPointerPressed"
                        PointerMoved="OnPointerMoved"
                        PointerReleased="OnPointerReleased"
                        Background="Transparent"/>
            </Grid>

            <!-- Action bar -->
            <Border Grid.Row="2" Background="#2D2D3D" Padding="12,8" BorderBrush="#3D3D4D" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Click="OnCancel" MinWidth="80">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE711;" FontSize="14"/>
                            <TextBlock Text="Cancel"/>
                        </StackPanel>
                    </Button>
                    <Button Click="OnDone" MinWidth="80" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE73E;" FontSize="14"/>
                            <TextBlock Text="Done"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </ContentControl>
</Window>
