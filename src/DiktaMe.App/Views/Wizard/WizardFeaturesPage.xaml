<Page x:Class="DiktaMe.App.Views.Wizard.WizardFeaturesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:WinUI3Localizer">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,0">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" MaxWidth="440">

            <TextBlock l:Uids.Uid="Wizard_Features_Title" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextAlignment="Center"/>

            <TextBlock l:Uids.Uid="Wizard_Features_Subtitle" FontSize="13" Opacity="0.6"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

            <!-- Power License features (paywall items) -->
            <StackPanel Spacing="14" Margin="0,8,0,0">

                <StackPanel Spacing="2">
                    <TextBlock FontWeight="SemiBold" FontSize="14">
                        <Run Text="&#xE964; " FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                        <Run l:Uids.Uid="Wizard_Features_LocalAI"/>
                    </TextBlock>
                    <TextBlock l:Uids.Uid="Wizard_Features_LocalAI_Desc" FontSize="12"
                               Opacity="0.6" TextWrapping="Wrap" Margin="24,0,0,0"/>
                </StackPanel>

                <StackPanel Spacing="2">
                    <TextBlock FontWeight="SemiBold" FontSize="14">
                        <Run Text="&#xE8D7; " FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                        <Run l:Uids.Uid="Wizard_Features_BYOK"/>
                    </TextBlock>
                    <TextBlock l:Uids.Uid="Wizard_Features_BYOK_Desc" FontSize="12"
                               Opacity="0.6" TextWrapping="Wrap" Margin="24,0,0,0"/>
                </StackPanel>

                <StackPanel Spacing="2">
                    <TextBlock FontWeight="SemiBold" FontSize="14">
                        <Run Text="&#xE7B3; " FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                        <Run l:Uids.Uid="Wizard_Features_Vision"/>
                    </TextBlock>
                    <TextBlock l:Uids.Uid="Wizard_Features_Vision_Desc" FontSize="12"
                               Opacity="0.6" TextWrapping="Wrap" Margin="24,0,0,0"/>
                </StackPanel>

            </StackPanel>

            <TextBlock l:Uids.Uid="Wizard_Features_Footer" FontSize="12" Opacity="0.5"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       FontStyle="Italic" Margin="0,4,0,0"/>

            <HyperlinkButton l:Uids.Uid="Wizard_Features_GetNow" Padding="0"
                             HorizontalAlignment="Center" FontSize="14"
                             Click="GetNowLink_Click"/>

        </StackPanel>
    </ScrollViewer>
</Page>
