<Page x:Class="DiktaMe.App.Views.Wizard.WizardWelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:WinUI3Localizer">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="400">
        <Image Source="ms-appx:///Assets/loading-logo.png"
               Width="140" Height="140" HorizontalAlignment="Center"/>

        <TextBlock Text="dIKta.me" FontSize="36" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

        <TextBlock l:Uids.Uid="Wizard_Welcome_Title" FontSize="20" FontWeight="SemiBold"
                   HorizontalAlignment="Center"/>

        <TextBlock l:Uids.Uid="Wizard_Welcome_Description" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Opacity="0.7"/>

        <TextBlock l:Uids.Uid="Wizard_Welcome_Hint" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Opacity="0.5" Margin="0,16,0,0"/>
    </StackPanel>
</Page>
