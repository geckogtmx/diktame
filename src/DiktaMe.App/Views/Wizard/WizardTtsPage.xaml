<Page x:Class="DiktaMe.App.Views.Wizard.WizardTtsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:WinUI3Localizer">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel VerticalAlignment="Center" Spacing="12" MaxWidth="450" Margin="24,0">
        <TextBlock l:Uids.Uid="Wizard_Tts_Title" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock l:Uids.Uid="Wizard_Tts_Description" TextWrapping="Wrap" FontSize="13" Opacity="0.7"/>

        <RadioButtons x:Name="TtsRadio" MaxColumns="1" SelectionChanged="TtsRadio_SelectionChanged">
            <RadioButton x:Name="TtsOff" Tag="off" IsChecked="True">
                <StackPanel Spacing="2">
                    <TextBlock l:Uids.Uid="Wizard_Tts_Off_Title" FontWeight="SemiBold"/>
                    <TextBlock l:Uids.Uid="Wizard_Tts_Off_Description" FontSize="12" Opacity="0.6"/>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="TtsCloud" Tag="cloud">
                <StackPanel Spacing="2">
                    <TextBlock l:Uids.Uid="Wizard_Tts_Cloud_Title" FontWeight="SemiBold"/>
                    <TextBlock l:Uids.Uid="Wizard_Tts_Cloud_Description" FontSize="12" Opacity="0.6"/>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="TtsLocal" Tag="local">
                <StackPanel Spacing="2">
                    <TextBlock l:Uids.Uid="Wizard_Tts_Local_Title" FontWeight="SemiBold"/>
                    <TextBlock l:Uids.Uid="Wizard_Tts_Local_Description" FontSize="12" Opacity="0.6"/>
                </StackPanel>
            </RadioButton>
        </RadioButtons>

        <!-- Provider selection + API Key (BYOK cloud TTS path) -->
        <StackPanel x:Name="TtsCloudPanel" Spacing="10" Visibility="Collapsed">
            <ComboBox x:Name="TtsProviderCombo" Header="Provider" Width="280"
                      SelectionChanged="TtsProviderCombo_SelectionChanged">
                <ComboBoxItem Tag="deepgram" Content="Deepgram" IsSelected="True"/>
                <ComboBoxItem Tag="openai" Content="OpenAI"/>
                <ComboBoxItem Tag="gemini" Content="Gemini"/>
                <ComboBoxItem Tag="inworld" Content="Inworld"/>
            </ComboBox>
            <TextBlock x:Name="TtsKeyInfo" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
            <StackPanel x:Name="TtsKeyInputPanel" Spacing="8" Visibility="Collapsed">
                <PasswordBox x:Name="TtsKeyBox" PlaceholderText="API Key"
                             PasswordChanged="TtsKeyBox_PasswordChanged"/>
            </StackPanel>
        </StackPanel>

        <!-- Download progress panel (shown when Local is selected) -->
        <StackPanel x:Name="DownloadPanel" Spacing="8" Visibility="Collapsed">
            <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Value="0"/>
            <TextBlock x:Name="DownloadStatus" FontSize="12" Opacity="0.7"/>
            <TextBlock x:Name="DownloadError" FontSize="12" Foreground="Red"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Page>
