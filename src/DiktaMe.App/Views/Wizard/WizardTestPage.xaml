<Page x:Class="DiktaMe.App.Views.Wizard.WizardTestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="450">
        <TextBlock Text="Quick Test" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" FontSize="14" Opacity="0.7"
                   Text="Test your setup by recording a short phrase. This verifies your microphone and chosen providers are working."/>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" Padding="16" Margin="0,8,0,0">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
                <Button x:Name="RecordButton" Content="Record (3 seconds)"
                        HorizontalAlignment="Center"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="RecordButton_Click"/>

                <ProgressRing x:Name="RecordingProgress" IsActive="False"
                              Width="32" Height="32"/>

                <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontSize="13"
                           TextAlignment="Center" Opacity="0.8" Text=""/>
            </StackPanel>
        </Border>

        <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Opacity="0.5"
                   Text="This step is optional — you can skip it and test later."/>
    </StackPanel>
</Page>
