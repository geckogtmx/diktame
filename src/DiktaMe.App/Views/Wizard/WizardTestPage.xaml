<Page x:Class="DiktaMe.App.Views.Wizard.WizardTestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:WinUI3Localizer">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="450">
        <TextBlock l:Uids.Uid="Wizard_Test_Title" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock l:Uids.Uid="Wizard_Test_Description" TextWrapping="Wrap" FontSize="14" Opacity="0.7"/>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" Padding="16" Margin="0,8,0,0">
            <StackPanel Spacing="12">
                <!-- Microphone selector -->
                <StackPanel Spacing="8">
                    <TextBlock l:Uids.Uid="Wizard_Test_MicLabel" FontSize="13" Opacity="0.7"/>
                    <ComboBox x:Name="MicrophoneComboBox"
                              HorizontalAlignment="Stretch"
                              DisplayMemberPath="Name"
                              SelectedIndex="0"/>
                </StackPanel>

                <!-- Record button -->
                <Button x:Name="RecordButton" l:Uids.Uid="Wizard_Test_RecordButton"
                        HorizontalAlignment="Center"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="RecordButton_Click"/>

                <ProgressRing x:Name="RecordingProgress" IsActive="False"
                              Width="32" Height="32"/>

                <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontSize="13"
                           TextAlignment="Center" Opacity="0.8" Text=""/>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
