<Window x:Class="DiktaMe.App.Views.VideoActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Actions">

    <ContentControl FontFamily="{StaticResource AppFont}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid Padding="16" RowSpacing="12" Background="{StaticResource AppSurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with file info -->
            <StackPanel Grid.Row="0" Spacing="4" HorizontalAlignment="Center">
                <TextBlock x:Name="FileInfoText" Text="video.mp4"
                           FontSize="13" Foreground="{StaticResource AppTextDimBrush}"
                           HorizontalAlignment="Center" FontFamily="Consolas"/>
                <TextBlock x:Name="DurationText" Text=""
                           FontSize="11" Foreground="{StaticResource AppTextDimBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Optional custom prompt -->
            <TextBox x:Name="QueryInput" Grid.Row="1"
                     PlaceholderText="Custom prompt (optional — overrides action default)"
                     AcceptsReturn="False" MaxLength="500"
                     Foreground="{StaticResource AppTextBrush}"
                     KeyDown="QueryInput_KeyDown"/>

            <!-- Action buttons: 2x2 grid -->
            <Grid Grid.Row="2" ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Click="OnDescribe"
                        HorizontalAlignment="Stretch" Padding="12,10"
                        ToolTipService.ToolTip="Describe what happens in the recording">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71D;" FontSize="16"/>
                        <TextBlock Text="Describe" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="1" Click="OnDocument"
                        HorizontalAlignment="Stretch" Padding="12,10"
                        ToolTipService.ToolTip="Write step-by-step instructions for the workflow shown">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A5;" FontSize="16"/>
                        <TextBlock Text="Document" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="1" Grid.Column="0" Click="OnBugReport"
                        HorizontalAlignment="Stretch" Padding="12,10"
                        ToolTipService.ToolTip="Generate a structured bug report from the recording">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEBE8;" FontSize="16"/>
                        <TextBlock Text="Bug Report" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="1" Grid.Column="1" Click="OnSkip"
                        HorizontalAlignment="Stretch" Padding="12,10"
                        ToolTipService.ToolTip="Save video without AI analysis">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="16"/>
                        <TextBlock Text="Save Only" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Hint -->
            <TextBlock Grid.Row="3" Text="Esc = Save Only  |  AI actions use Gemini (cloud)"
                       FontSize="11" Foreground="{StaticResource AppTextDimBrush}"
                       HorizontalAlignment="Center" Opacity="0.7"/>
        </Grid>
    </ContentControl>
</Window>
