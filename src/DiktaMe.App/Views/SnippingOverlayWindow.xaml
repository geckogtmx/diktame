<Window x:Class="DiktaMe.App.Views.SnippingOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dIKta.me Vision">

    <Grid>
        <!-- Dark overlay canvas — selection rectangle is drawn in code-behind -->
        <Canvas x:Name="OverlayCanvas" Background="Transparent">
            <!-- Semi-transparent dark fill (drawn programmatically with cutout) -->
        </Canvas>

        <!-- Bottom hint text -->
        <TextBlock x:Name="HintText"
                   Text="Click = Window  |  Drag = Region  |  Esc = Cancel"
                   Foreground="White"
                   FontSize="14"
                   Opacity="0.7"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,32" />
    </Grid>
</Window>
