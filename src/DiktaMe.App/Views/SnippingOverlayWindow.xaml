<Window x:Class="DiktaMe.App.Views.SnippingOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DiktaMe.App.Views"
        Title="dIKta.me Vision">

    <Grid>
        <!-- Screenshot of the screen as background (simulates transparency) -->
        <Image x:Name="ScreenshotImage" Stretch="Fill" />

        <!-- Dark overlay canvas — selection rectangle drawn in code-behind -->
        <local:CrosshairCanvas x:Name="OverlayCanvas" Background="Transparent" />

        <!-- Bottom hint text -->
        <TextBlock x:Name="HintText"
                   Text="Click = Window  |  Drag = Region  |  Esc = Cancel"
                   Foreground="White"
                   FontSize="14"
                   Opacity="0.8"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,32" />
    </Grid>
</Window>
