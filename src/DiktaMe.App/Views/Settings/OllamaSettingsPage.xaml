<Page x:Class="DiktaMe.App.Views.Settings.OllamaSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:WinUI3Localizer"
      xmlns:converters="using:DiktaMe.App.Converters"
      xmlns:sys="using:DiktaMe.Core.SystemManagement"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:BoolNegationConverter x:Key="BoolNeg"/>
    </Page.Resources>

    <ScrollViewer Padding="24,24,24,32">
        <StackPanel Spacing="16" MaxWidth="700">
            <TextBlock l:Uids.Uid="Settings_Ollama_Title" FontSize="24" FontWeight="SemiBold"/>

            <!-- ═══════════════════════════════════════════════════════════
                 Section 1: Service Status (always visible)
                 ═══════════════════════════════════════════════════════════ -->
            <StackPanel Spacing="6" Padding="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Ollama" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.OllamaVersion, Mode=OneWay}" FontSize="12" Opacity="0.6"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="·" FontSize="12" Opacity="0.4" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.VramSummary, Mode=OneWay}" FontSize="12" Opacity="0.6"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button l:Uids.Uid="Settings_Ollama_CheckHealth" Command="{x:Bind ViewModel.CheckHealthCommand}"
                            IsEnabled="{x:Bind ViewModel.IsChecking, Mode=OneWay, Converter={StaticResource BoolNeg}}"/>
                    <Button l:Uids.Uid="Settings_Ollama_RestartService" Command="{x:Bind ViewModel.RestartServiceCommand}"
                            IsEnabled="{x:Bind ViewModel.IsChecking, Mode=OneWay, Converter={StaticResource BoolNeg}}"/>
                </StackPanel>

                <!-- Install Ollama (shown when Offline) -->
                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.ShowInstall, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsInstalling, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.IsInstalling, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.InstallOllamaCommand}"
                                IsEnabled="{x:Bind ViewModel.IsInstalling, Mode=OneWay, Converter={StaticResource BoolNeg}}">
                            <TextBlock Text="{x:Bind ViewModel.InstallButtonText, Mode=OneWay}"/>
                        </Button>
                        <HyperlinkButton NavigateUri="https://ollama.com/download"
                                         Visibility="{x:Bind ViewModel.ShowManualInstallLink, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock l:Uids.Uid="Settings_Ollama_ManualInstall"/>
                        </HyperlinkButton>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.InstallError, Mode=OneWay}" FontSize="12"
                               Foreground="Red" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.ShowInstallError, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <!-- 412 Rescue -->
                <InfoBar l:Uids.Uid="Settings_Ollama_RescueInfoBar" IsOpen="{x:Bind ViewModel.ShowRescue, Mode=OneWay}"
                         Severity="Warning"
                         Message="{x:Bind ViewModel.RescueMessage, Mode=OneWay}"
                         IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button l:Uids.Uid="Settings_Ollama_UseFallback" Command="{x:Bind ViewModel.UseFallbackCommand}"/>
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════════
                 Section 2: Default Model
                 ═══════════════════════════════════════════════════════════ -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <TextBlock l:Uids.Uid="Settings_Ollama_DefaultModel_Header" FontWeight="SemiBold"/>
                </Expander.Header>
                <StackPanel Spacing="8" Padding="0,8">
                    <TextBlock l:Uids.Uid="Settings_Ollama_DefaultModel_Hint" FontSize="12" Opacity="0.6"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox ItemsSource="{x:Bind ViewModel.InstalledModels, Mode=OneWay}"
                                  SelectedIndex="{x:Bind ViewModel.SelectedModelIndex, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  MinWidth="300"
                                  PlaceholderText="Select a model..."/>
                        <Button l:Uids.Uid="Settings_Ollama_Warmup" Command="{x:Bind ViewModel.WarmupModelCommand}"
                                IsEnabled="{x:Bind ViewModel.IsWarmingUp, Mode=OneWay, Converter={StaticResource BoolNeg}}"/>
                    </StackPanel>
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <TextBlock Text="Keep-alive" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="How long the model stays loaded in VRAM after use." FontSize="12" Opacity="0.6"/>
                        <ComboBox SelectedIndex="{x:Bind ViewModel.KeepAliveIndex, Mode=TwoWay}" MinWidth="200">
                            <ComboBoxItem Content="5 minutes"/>
                            <ComboBoxItem Content="10 minutes"/>
                            <ComboBoxItem Content="30 minutes"/>
                            <ComboBoxItem Content="1 hour"/>
                            <ComboBoxItem Content="2 hours"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- ═══════════════════════════════════════════════════════════
                 Section 3: Installed Models
                 ═══════════════════════════════════════════════════════════ -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock l:Uids.Uid="Settings_Ollama_InstalledModels_Header" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalDiskUsage, Mode=OneWay}" FontSize="12" Opacity="0.6"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="8" Padding="0,8">
                    <ListView ItemsSource="{x:Bind ViewModel.InstalledModels, Mode=OneWay}"
                              SelectionMode="None" MaxHeight="300">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="sys:OllamaModelDetail">
                                <Grid Padding="4,8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind ParameterSize}" FontSize="12" Opacity="0.6"/>
                                            <TextBlock Text="·" FontSize="12" Opacity="0.4"/>
                                            <TextBlock Text="{x:Bind QuantizationLevel}" FontSize="12" Opacity="0.6"/>
                                            <TextBlock Text="·" FontSize="12" Opacity="0.4"/>
                                            <TextBlock Text="{x:Bind Family}" FontSize="12" Opacity="0.6"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Content="Info" FontSize="12" Padding="8,4"
                                                Tag="{x:Bind}"
                                                Click="InfoButton_Click"/>
                                        <Button Content="Delete" FontSize="12" Padding="8,4"
                                                Tag="{x:Bind}"
                                                Click="DeleteButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Pull new model -->
                    <StackPanel Spacing="4" Margin="0,8,0,0">
                        <TextBlock l:Uids.Uid="Settings_Ollama_PullNew" FontWeight="SemiBold" FontSize="13"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{x:Bind ViewModel.PullModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="e.g. gemma3:4b" MinWidth="250"/>
                            <Button l:Uids.Uid="Settings_Ollama_Pull" Command="{x:Bind ViewModel.PullModelCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsPulling, Mode=OneWay, Converter={StaticResource BoolNeg}}"/>
                        </StackPanel>
                        <ProgressBar Value="{x:Bind ViewModel.PullProgress, Mode=OneWay}" Maximum="100"
                                     Visibility="{x:Bind ViewModel.IsPulling, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{x:Bind ViewModel.PullStatusText, Mode=OneWay}" FontSize="12" Opacity="0.7"
                                   Visibility="{x:Bind ViewModel.IsPulling, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- ═══════════════════════════════════════════════════════════
                 Section 4: Live VRAM Monitor
                 ═══════════════════════════════════════════════════════════ -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <TextBlock l:Uids.Uid="Settings_Ollama_LiveVram_Header" FontWeight="SemiBold"/>
                </Expander.Header>
                <StackPanel Spacing="8" Padding="0,8">
                    <TextBlock Text="{x:Bind ViewModel.GpuName, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock FontSize="13">
                            <Run Text="VRAM:"/>
                            <Run Text="{x:Bind ViewModel.VramUsedGB, Mode=OneWay}"/>
                            <Run Text="/"/>
                            <Run Text="{x:Bind ViewModel.VramTotalGB, Mode=OneWay}"/>
                            <Run Text="GB"/>
                        </TextBlock>
                    </StackPanel>
                    <ProgressBar Value="{x:Bind ViewModel.VramPercent, Mode=OneWay}" Maximum="100"/>

                    <TextBlock l:Uids.Uid="Settings_Ollama_LoadedModels" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,0"/>
                    <ListView ItemsSource="{x:Bind ViewModel.RunningModels, Mode=OneWay}"
                              SelectionMode="None" MaxHeight="150">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="sys:OllamaRunningModel">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="4,2">
                                    <TextBlock Text="{x:Bind Name}" FontSize="13"/>
                                    <TextBlock Text="·" FontSize="13" Opacity="0.4"/>
                                    <TextBlock Text="{x:Bind ParameterSize}" FontSize="12" Opacity="0.6"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <TextBlock FontSize="12" Opacity="0.6">
                            <Run Text="System RAM:"/>
                            <Run Text="{x:Bind ViewModel.RamSummary, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.LastInferenceSpeed, Mode=OneWay}" FontSize="12" Opacity="0.6"/>
                </StackPanel>
            </Expander>

            <!-- ═══════════════════════════════════════════════════════════
                 Section 5: Model Library (Live Search)
                 ═══════════════════════════════════════════════════════════ -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <TextBlock l:Uids.Uid="Settings_Ollama_ModelLibrary_Header" FontWeight="SemiBold"/>
                </Expander.Header>
                <StackPanel Spacing="8" Padding="0,8">
                    <TextBlock l:Uids.Uid="Settings_Ollama_ModelLibrary_Hint" FontSize="12" Opacity="0.6"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Search models..." MinWidth="300"/>
                        <Button l:Uids.Uid="Settings_Ollama_Search" Command="{x:Bind ViewModel.SearchModelsCommand}"
                                IsEnabled="{x:Bind ViewModel.IsSearching, Mode=OneWay, Converter={StaticResource BoolNeg}}"/>
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{x:Bind ViewModel.SearchStatusText, Mode=OneWay}" FontSize="12" Opacity="0.6"/>

                    <ListView ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                              SelectionMode="None" MaxHeight="400">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="sys:OllamaSearchResult">
                                <Grid Padding="4,8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{x:Bind PullCount}" FontSize="12" Opacity="0.5"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Description}" FontSize="12" Opacity="0.7"
                                                   TextWrapping="Wrap" MaxLines="2"/>
                                    </StackPanel>
                                    <HyperlinkButton Grid.Column="1" Content="View" FontSize="12" Padding="8,4"
                                                     Tag="{x:Bind Name}" Click="SearchView_Click"
                                                     VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Expander>

            <!-- ═══════════════════════════════════════════════════════════
                 Section 6: Advanced Settings
                 ═══════════════════════════════════════════════════════════ -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <TextBlock l:Uids.Uid="Settings_Ollama_Advanced_Header" FontWeight="SemiBold"/>
                </Expander.Header>
                <StackPanel Spacing="12" Padding="0,8">
                    <StackPanel Spacing="4">
                        <TextBlock l:Uids.Uid="Settings_Ollama_BaseUrl_Label" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock l:Uids.Uid="Settings_Ollama_BaseUrl_Hint" FontSize="12" Opacity="0.6"/>
                        <TextBox Text="{x:Bind ViewModel.OllamaBaseUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 PlaceholderText="http://localhost:11434" MinWidth="350"/>
                    </StackPanel>

                    <CheckBox l:Uids.Uid="Settings_Ollama_AutoWarmup"
                              IsChecked="{x:Bind ViewModel.AutoWarmup, Mode=TwoWay}"/>

                    <StackPanel Spacing="4">
                        <TextBlock l:Uids.Uid="Settings_Ollama_NumCtx_Label" FontWeight="SemiBold" FontSize="13"/>
                        <ComboBox SelectedIndex="{x:Bind ViewModel.NumCtxIndex, Mode=TwoWay}" MinWidth="150">
                            <ComboBoxItem Content="2048"/>
                            <ComboBoxItem Content="4096"/>
                            <ComboBoxItem Content="8192"/>
                            <ComboBoxItem Content="16384"/>
                        </ComboBox>
                    </StackPanel>

                    <HyperlinkButton l:Uids.Uid="Settings_Ollama_OpenWebsite"
                                     Command="{x:Bind ViewModel.OpenOllamaWebsiteCommand}"/>
                </StackPanel>
            </Expander>

            <!-- Model Info Flyout (shown as dialog) -->
            <ContentDialog x:Name="ModelInfoDialog" Title="{x:Bind ViewModel.ModelInfoTitle, Mode=OneWay}"
                           CloseButtonText="Close"
                           DefaultButton="Close">
                <StackPanel Spacing="8" MinWidth="300">
                    <TextBlock l:Uids.Uid="Settings_Ollama_ModelInfo_Family" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="{x:Bind ViewModel.ModelInfoDetail.Family, Mode=OneWay, FallbackValue=''}" FontSize="13"/>
                    <TextBlock l:Uids.Uid="Settings_Ollama_ModelInfo_Parameters" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="{x:Bind ViewModel.ModelInfoDetail.ParameterSize, Mode=OneWay, FallbackValue=''}" FontSize="13"/>
                    <TextBlock l:Uids.Uid="Settings_Ollama_ModelInfo_Quantization" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="{x:Bind ViewModel.ModelInfoDetail.QuantizationLevel, Mode=OneWay, FallbackValue=''}" FontSize="13"/>
                    <TextBlock l:Uids.Uid="Settings_Ollama_ModelInfo_ContextLength" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="{x:Bind ViewModel.ModelInfoDetail.ContextLength, Mode=OneWay, FallbackValue=''}" FontSize="13"/>
                </StackPanel>
            </ContentDialog>
        </StackPanel>
    </ScrollViewer>
</Page>
