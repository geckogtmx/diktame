<Page x:Class="DiktaMe.App.Views.Settings.OllamaSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="using:DiktaMe.App.Converters"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolNegationConverter x:Key="BoolNeg"/>
    </Page.Resources>

    <ScrollViewer Padding="24,24,24,32">
        <StackPanel Spacing="24" MaxWidth="600">
            <TextBlock Text="Ollama" FontSize="24" FontWeight="SemiBold"/>

            <!-- Status -->
            <StackPanel Spacing="4">
                <TextBlock Text="Status" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Version:" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.OllamaVersion, Mode=OneWay}" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="Check Health" Command="{x:Bind ViewModel.CheckHealthCommand}"
                        IsEnabled="{x:Bind ViewModel.IsChecking, Mode=OneWay, Converter={StaticResource BoolNeg}}"
                        Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Model Selection -->
            <StackPanel Spacing="4">
                <TextBlock Text="Default Model" FontWeight="SemiBold"/>
                <TextBlock Text="The Ollama model to use for local LLM processing" FontSize="12" Opacity="0.6"/>
                <TextBox Text="{x:Bind ViewModel.SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="e.g. llama3.2" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Installed Models -->
            <StackPanel Spacing="4">
                <TextBlock Text="Installed Models" FontWeight="SemiBold"/>
                <ListView ItemsSource="{x:Bind ViewModel.InstalledModels}" MaxHeight="200"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" FontSize="13" Padding="4,2"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- 412 Rescue -->
            <InfoBar IsOpen="{x:Bind ViewModel.ShowRescue, Mode=OneWay}"
                     Severity="Warning"
                     Title="Version Compatibility Issue"
                     Message="{x:Bind ViewModel.RescueMessage, Mode=OneWay}"
                     IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="Use Fallback Model" Command="{x:Bind ViewModel.UseFallbackCommand}"/>
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Separate Update button visible when rescue is shown -->
            <HyperlinkButton Content="Download latest Ollama"
                             Command="{x:Bind ViewModel.OpenOllamaWebsiteCommand}"
                             Visibility="{x:Bind ViewModel.ShowRescue, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
