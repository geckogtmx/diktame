<Page x:Class="DiktaMe.App.Views.Settings.OllamaSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:WinUI3Localizer"
      xmlns:converters="using:DiktaMe.App.Converters"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolNegationConverter x:Key="BoolNeg"/>
    </Page.Resources>

    <ScrollViewer Padding="24,24,24,32">
        <StackPanel Spacing="24" MaxWidth="600">
            <TextBlock l:Uids.Uid="Settings_Ollama_Title" FontSize="24" FontWeight="SemiBold"/>

            <!-- Status -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Ollama_Status_Label" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock l:Uids.Uid="Settings_Ollama_Version_Label" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.OllamaVersion, Mode=OneWay}" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                </StackPanel>
                <Button l:Uids.Uid="Settings_Ollama_CheckHealth" Command="{x:Bind ViewModel.CheckHealthCommand}"
                        IsEnabled="{x:Bind ViewModel.IsChecking, Mode=OneWay, Converter={StaticResource BoolNeg}}"
                        Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Install Ollama (shown when Offline) -->
            <StackPanel Spacing="8"
                        Visibility="{x:Bind ViewModel.ShowInstall, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsInstalling, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.IsInstalling, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.InstallOllamaCommand}"
                            IsEnabled="{x:Bind ViewModel.IsInstalling, Mode=OneWay, Converter={StaticResource BoolNeg}}">
                        <TextBlock Text="{x:Bind ViewModel.InstallButtonText, Mode=OneWay}"/>
                    </Button>
                    <HyperlinkButton NavigateUri="https://ollama.com/download"
                                     Visibility="{x:Bind ViewModel.ShowManualInstallLink, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock l:Uids.Uid="Settings_Ollama_ManualInstall"/>
                    </HyperlinkButton>
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.InstallError, Mode=OneWay}" FontSize="12"
                           Foreground="Red" TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.ShowInstallError, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <!-- Model Selection -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Ollama_DefaultModel_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_Ollama_DefaultModel_Description" FontSize="12" Opacity="0.6"/>
                <TextBox l:Uids.Uid="Settings_Ollama_DefaultModel_Placeholder" Text="{x:Bind ViewModel.SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Keep-Alive Duration -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Ollama_KeepAlive_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_Ollama_KeepAlive_Description" FontSize="12" Opacity="0.6"/>
                <ComboBox SelectedIndex="{x:Bind ViewModel.KeepAliveIndex, Mode=TwoWay}" MinWidth="200">
                    <ComboBoxItem Content="5 minutes" Tag="5m"/>
                    <ComboBoxItem Content="10 minutes" Tag="10m"/>
                    <ComboBoxItem Content="30 minutes" Tag="30m"/>
                    <ComboBoxItem Content="1 hour" Tag="1h"/>
                    <ComboBoxItem Content="2 hours" Tag="2h"/>
                </ComboBox>
            </StackPanel>

            <!-- Installed Models -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Ollama_InstalledModels_Label" FontWeight="SemiBold"/>
                <ListView ItemsSource="{x:Bind ViewModel.InstalledModels}" MaxHeight="200"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" FontSize="13" Padding="4,2"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- 412 Rescue -->
            <InfoBar l:Uids.Uid="Settings_Ollama_RescueInfoBar" IsOpen="{x:Bind ViewModel.ShowRescue, Mode=OneWay}"
                     Severity="Warning"
                     Message="{x:Bind ViewModel.RescueMessage, Mode=OneWay}"
                     IsClosable="False">
                <InfoBar.ActionButton>
                    <Button l:Uids.Uid="Settings_Ollama_UseFallback" Command="{x:Bind ViewModel.UseFallbackCommand}"/>
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Separate Update button visible when rescue is shown -->
            <HyperlinkButton l:Uids.Uid="Settings_Ollama_DownloadLink"
                             Command="{x:Bind ViewModel.OpenOllamaWebsiteCommand}"
                             Visibility="{x:Bind ViewModel.ShowRescue, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
