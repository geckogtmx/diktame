<Page x:Class="DiktaMe.App.Views.Settings.HardwareSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:WinUI3Localizer"
      Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid ColumnSpacing="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Sub-item list -->
        <Border Background="{StaticResource AppSurfaceTranslucentBrush}"
                Padding="24">
            <StackPanel Spacing="8">
                <TextBlock l:Uids.Uid="Settings_Hardware_Title" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"
                           Foreground="{StaticResource AppTextBrush}"/>
                <ListView ItemsSource="{x:Bind ViewModel.SubItems}"
                          SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.Resources>
                        <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="SubNavItemBackgroundSelected"/>
                        <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="SubNavItemBackgroundSelected"/>
                        <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="SubNavItemBackgroundSelected"/>
                        <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="SubNavItemForegroundSelected"/>
                    </ListView.Resources>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="4,6">
                                <TextBlock Text="{Binding Title}" FontSize="14"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <!-- Right: Detail pane -->
        <ScrollViewer Grid.Column="1" Padding="24,24,16,32"
                      Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel Spacing="16" MaxWidth="600">

                <!-- Microphone & Recording -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsMicrophoneSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Audio_RecordingDevice_Label" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextBrush}"/>
                            <TextBlock l:Uids.Uid="Settings_Audio_RecordingDevice_Description" FontSize="12"
                                       Foreground="{StaticResource AppTextDimBrush}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.Audio.Devices}"
                                      SelectedIndex="{x:Bind ViewModel.Audio.SelectedDeviceIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Audio_MaxDuration_Label" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextBrush}"/>
                            <TextBlock l:Uids.Uid="Settings_Audio_MaxDuration_Description" FontSize="12"
                                       Foreground="{StaticResource AppTextDimBrush}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.Audio.DurationLabels}"
                                      SelectedIndex="{x:Bind ViewModel.Audio.SelectedDurationIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock l:Uids.Uid="Settings_Audio_Ducking_Label" FontWeight="SemiBold"
                                               Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock l:Uids.Uid="Settings_Audio_Ducking_Description" FontSize="12"
                                               Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.Audio.DuckingEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock l:Uids.Uid="Settings_Audio_DuckLevel_Label" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <TextBlock l:Uids.Uid="Settings_Audio_DuckLevel_Prefix" FontSize="12"
                                               Foreground="{StaticResource AppTextDimBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.Audio.DuckLevelPercent, Mode=OneWay}" FontSize="12"
                                               Foreground="{StaticResource AppTextDimBrush}"/>
                                    <TextBlock l:Uids.Uid="Settings_Audio_DuckLevel_Suffix" FontSize="12"
                                               Foreground="{StaticResource AppTextDimBrush}"/>
                                </StackPanel>
                                <Slider Minimum="0" Maximum="100" StepFrequency="5"
                                        Value="{x:Bind ViewModel.Audio.DuckLevelPercent, Mode=TwoWay}"
                                        IsEnabled="{x:Bind ViewModel.Audio.DuckingEnabled, Mode=OneWay}"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock l:Uids.Uid="Settings_Audio_DuckRamp_Label" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <TextBlock l:Uids.Uid="Settings_Audio_DuckRamp_Prefix" FontSize="12"
                                               Foreground="{StaticResource AppTextDimBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.Audio.RampDownMs, Mode=OneWay}" FontSize="12"
                                               Foreground="{StaticResource AppTextDimBrush}"/>
                                    <TextBlock l:Uids.Uid="Settings_Audio_DuckRamp_Suffix" FontSize="12"
                                               Foreground="{StaticResource AppTextDimBrush}"/>
                                </StackPanel>
                                <Slider Minimum="0" Maximum="2000" StepFrequency="100"
                                        Value="{x:Bind ViewModel.Audio.RampDownMs, Mode=TwoWay}"
                                        IsEnabled="{x:Bind ViewModel.Audio.DuckingEnabled, Mode=OneWay}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Sound Feedback -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsSoundFeedbackSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock l:Uids.Uid="Settings_Audio_EnableSounds_Label" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                <TextBlock l:Uids.Uid="Settings_Audio_EnableSounds_Description" FontSize="12"
                                           Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.Audio.SoundEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock l:Uids.Uid="Settings_Audio_StartSound_Label" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextBrush}"/>
                                <TextBlock l:Uids.Uid="Settings_Audio_StartSound_Description" FontSize="12"
                                           Foreground="{StaticResource AppTextDimBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox ItemsSource="{x:Bind ViewModel.Audio.AvailableSounds}"
                                              SelectedIndex="{x:Bind ViewModel.Audio.SelectedStartSoundIndex, Mode=TwoWay}"
                                              MinWidth="120"
                                              IsEnabled="{x:Bind ViewModel.Audio.SoundEnabled, Mode=OneWay}"/>
                                    <Button Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                            Command="{x:Bind ViewModel.Audio.PreviewStartSoundCommand}"
                                            IsEnabled="{x:Bind ViewModel.Audio.SoundEnabled, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.Audio.TooltipPreview, Mode=OneWay}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock l:Uids.Uid="Settings_Audio_StopSound_Label" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextBrush}"/>
                                <TextBlock l:Uids.Uid="Settings_Audio_StopSound_Description" FontSize="12"
                                           Foreground="{StaticResource AppTextDimBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox ItemsSource="{x:Bind ViewModel.Audio.AvailableSounds}"
                                              SelectedIndex="{x:Bind ViewModel.Audio.SelectedStopSoundIndex, Mode=TwoWay}"
                                              MinWidth="120"
                                              IsEnabled="{x:Bind ViewModel.Audio.SoundEnabled, Mode=OneWay}"/>
                                    <Button Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                            Command="{x:Bind ViewModel.Audio.PreviewStopSoundCommand}"
                                            IsEnabled="{x:Bind ViewModel.Audio.SoundEnabled, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.Audio.TooltipPreview, Mode=OneWay}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock l:Uids.Uid="Settings_Audio_UtilitySound_Label" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextBrush}"/>
                                <TextBlock l:Uids.Uid="Settings_Audio_UtilitySound_Description" FontSize="12"
                                           Foreground="{StaticResource AppTextDimBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox ItemsSource="{x:Bind ViewModel.Audio.AvailableSounds}"
                                              SelectedIndex="{x:Bind ViewModel.Audio.SelectedUtilitySoundIndex, Mode=TwoWay}"
                                              MinWidth="120"
                                              IsEnabled="{x:Bind ViewModel.Audio.SoundEnabled, Mode=OneWay}"/>
                                    <Button Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                            Command="{x:Bind ViewModel.Audio.PreviewUtilitySoundCommand}"
                                            IsEnabled="{x:Bind ViewModel.Audio.SoundEnabled, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.Audio.TooltipPreview, Mode=OneWay}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
