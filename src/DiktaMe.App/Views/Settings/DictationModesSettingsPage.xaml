<Page x:Class="DiktaMe.App.Views.Settings.DictationModesSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:WinUI3Localizer"
      xmlns:vm="using:DiktaMe.App.ViewModels.Settings"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Mode list -->
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock l:Uids.Uid="Settings_DictationModes_Presets_Title" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4"/>

            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.ModeItems}"
                      SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModeListItem">
                        <Grid Padding="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Bottom toolbar: New / Move / Delete -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                <Button Content="+" ToolTipService.ToolTip="New Preset"
                        Command="{x:Bind ViewModel.CreateModeCommand}"
                        Width="36" Height="32"/>
                <Button ToolTipService.ToolTip="Move Up"
                        Command="{x:Bind ViewModel.MoveUpCommand}"
                        Width="36" Height="32">
                    <FontIcon Glyph="&#xE70E;" FontSize="12"/>
                </Button>
                <Button ToolTipService.ToolTip="Move Down"
                        Command="{x:Bind ViewModel.MoveDownCommand}"
                        Width="36" Height="32">
                    <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                </Button>
                <Button ToolTipService.ToolTip="Delete Preset"
                        Command="{x:Bind ViewModel.DeleteModeCommand}"
                        Width="36" Height="32">
                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Right: Preset editor -->
        <ScrollViewer Grid.Column="1"
                      Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel Spacing="20" MaxWidth="520">

                <!-- Title -->
                <StackPanel Spacing="4">
                    <TextBlock l:Uids.Uid="Settings_DictationModes_Title_Label" FontWeight="SemiBold"/>
                    <TextBox l:Uids.Uid="Settings_DictationModes_Title_Placeholder" Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Cloud Profile -->
                <TextBlock l:Uids.Uid="Settings_DictationModes_CloudProfile_Title" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>

                <!-- Cloud: Model -->
                <StackPanel Spacing="4">
                    <TextBlock l:Uids.Uid="Settings_DictationModes_LlmModel_Label" FontWeight="SemiBold"/>
                    <TextBlock l:Uids.Uid="Settings_DictationModes_LlmModel_Description" FontSize="12" Opacity="0.6"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{x:Bind ViewModel.CloudModelNames}"
                                  SelectedIndex="{x:Bind ViewModel.SelectedCloudModelIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  IsEnabled="{x:Bind ViewModel.IsLoadingModels, Mode=OneWay, Converter={StaticResource BoolNeg}}"/>
                        <Button Grid.Column="1" ToolTipService.ToolTip="Refresh model list"
                                Command="{x:Bind ViewModel.RefreshModelsCommand}">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        </Button>
                    </Grid>
                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{x:Bind ViewModel.IsLoadingModels, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                 Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Cloud: System Prompt -->
                <StackPanel Spacing="4">
                    <TextBlock l:Uids.Uid="Settings_DictationModes_CloudSystemPrompt_Label" FontWeight="SemiBold"/>
                    <TextBlock l:Uids.Uid="Settings_DictationModes_SystemPrompt_CloudDescription" FontSize="12" Opacity="0.6"/>
                    <TextBox l:Uids.Uid="Settings_DictationModes_CloudPrompt_Placeholder" Text="{x:Bind ViewModel.CloudSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="120" MaxHeight="200"/>
                </StackPanel>

                <!-- Cloud: Use LLM (dictation modes only) -->
                <StackPanel Spacing="4"
                            Visibility="{x:Bind ViewModel.IsDictationMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock l:Uids.Uid="Settings_DictationModes_CloudUseLlm_Label" FontWeight="SemiBold"/>
                    <TextBlock l:Uids.Uid="Settings_DictationModes_CloudUseLlm_Description" FontSize="12" Opacity="0.6"/>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.CloudUseLlm, Mode=TwoWay}"/>
                </StackPanel>

                <!-- Local Profile -->
                <TextBlock l:Uids.Uid="Settings_DictationModes_LocalProfile_Title" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0"/>

                <InfoBar l:Uids.Uid="Settings_DictationModes_OllamaInfoBar" IsOpen="True" IsClosable="False" Severity="Informational"
                         Margin="0,0,0,4"/>

                <!-- Local: System Prompt -->
                <StackPanel Spacing="4">
                    <TextBlock l:Uids.Uid="Settings_DictationModes_LocalSystemPrompt_Label" FontWeight="SemiBold"/>
                    <TextBox l:Uids.Uid="Settings_DictationModes_LocalPrompt_Placeholder" Text="{x:Bind ViewModel.LocalSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="120" MaxHeight="200"/>
                </StackPanel>

                <!-- Local: Use LLM (dictation modes only) -->
                <StackPanel Spacing="4"
                            Visibility="{x:Bind ViewModel.IsDictationMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock l:Uids.Uid="Settings_DictationModes_LocalUseLlm_Label" FontWeight="SemiBold"/>
                    <TextBlock l:Uids.Uid="Settings_DictationModes_LocalUseLlm_Description" FontSize="12" Opacity="0.6"/>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.LocalUseLlm, Mode=TwoWay}"/>
                </StackPanel>

                <!-- Save button -->
                <Button l:Uids.Uid="Settings_DictationModes_SaveButton" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SaveCommand}"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,24"/>
            </StackPanel>
        </ScrollViewer>

        <!-- No selection placeholder -->
        <TextBlock Grid.Column="1" l:Uids.Uid="Settings_DictationModes_NoSelection"
                   Opacity="0.5" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"/>
    </Grid>
</Page>
