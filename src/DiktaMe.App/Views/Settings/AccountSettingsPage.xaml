<Page x:Class="DiktaMe.App.Views.Settings.AccountSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="using:DiktaMe.App.Converters"
      xmlns:vm="using:DiktaMe.App.ViewModels.Settings"
      xmlns:l="using:WinUI3Localizer"
      Background="Transparent">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    </Page.Resources>

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock l:Uids.Uid="Settings_Account_Title" FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource V1TextPrimaryBrush}"/>

            <!-- Signed-out state -->
            <InfoBar x:Name="SignInBar" l:Uids.Uid="Settings_Account_SignInBar"
                     Severity="Informational" IsOpen="True" IsClosable="False"
                     Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                <InfoBar.ActionButton>
                    <Button l:Uids.Uid="Settings_Account_SignInButton" Command="{x:Bind ViewModel.SignInCommand}"/>
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Signed-in state -->
            <StackPanel Spacing="12"
                        Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                <!-- User info -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE77B;" FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.Email, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="13" Foreground="{StaticResource V1TextSecondaryBrush}"/>

                <!-- Wallet Balance -->
                <StackPanel Spacing="4" Margin="0,12,0,0">
                    <TextBlock l:Uids.Uid="Settings_Account_WalletBalance_Title" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource V1TextPrimaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.WalletBalanceFormatted, Mode=OneWay}"
                               FontSize="28" FontWeight="Bold"/>
                </StackPanel>

                <!-- Wallet Proxy toggle (routes STT+LLM through cloud wallet) -->
                <ToggleSwitch Header="Use Wallet Proxy (Cloud STT + LLM)"
                              IsOn="{x:Bind ViewModel.UseWalletProxy, Mode=TwoWay}"
                              Margin="0,8,0,0"
                              OnContent="Wallet active — all requests use cloud APIs"
                              OffContent="Off — using local/BYOK providers"/>

                <!-- Action buttons -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Command="{x:Bind ViewModel.TopUpCommand}" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            <TextBlock l:Uids.Uid="Settings_Account_TopUpButton"/>
                        </StackPanel>
                    </Button>
                    <HyperlinkButton l:Uids.Uid="Settings_Account_ManageAccountLink" Command="{x:Bind ViewModel.ManageAccountCommand}"/>
                </StackPanel>

                <!-- Transaction History -->
                <StackPanel Spacing="8" Margin="0,16,0,0">
                    <TextBlock l:Uids.Uid="Settings_Account_TransactionHistory_Title" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource V1TextPrimaryBrush}"/>

                    <ListView ItemsSource="{x:Bind ViewModel.RecentTransactions, Mode=OneWay}"
                              SelectionMode="None" IsItemClickEnabled="False"
                              MaxHeight="300">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:WalletTransactionItem">
                                <Grid Padding="4,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0" Glyph="{x:Bind TypeIcon}" FontSize="14"
                                              VerticalAlignment="Center" Opacity="0.7"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind TypeLabel}" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind DateFormatted}" FontSize="11"
                                                   Foreground="{StaticResource V1TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{x:Bind AmountFormatted}" FontSize="13"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="3" Text="{x:Bind BalanceAfterFormatted}" FontSize="11"
                                               Foreground="{StaticResource V1TextSecondaryBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <Button l:Uids.Uid="Settings_Account_SignOutButton" Command="{x:Bind ViewModel.SignOutCommand}"
                        Margin="0,16,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
