<Page x:Class="DiktaMe.App.Views.Settings.AccountSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="using:DiktaMe.App.Converters">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    </Page.Resources>

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="Account" FontSize="28" FontWeight="SemiBold"/>

            <!-- Signed-out state -->
            <InfoBar x:Name="SignInBar" Title="Try dIKta.me free"
                     Message="Sign in to get 15,000 words of AI processing — no API key needed."
                     Severity="Informational" IsOpen="True" IsClosable="False"
                     Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                <InfoBar.ActionButton>
                    <Button Content="Sign in" Command="{x:Bind ViewModel.SignInCommand}"/>
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Signed-in state -->
            <StackPanel Spacing="12"
                        Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE77B;" FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.Email, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Usage" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>

                <ProgressBar Value="{x:Bind ViewModel.UsagePercent, Mode=OneWay}"
                             Minimum="0" Maximum="100" Height="8"/>

                <TextBlock Text="{x:Bind ViewModel.UsageText, Mode=OneWay}" FontSize="13" Opacity="0.7"/>

                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="13" Opacity="0.7"/>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}"/>
                    <HyperlinkButton Content="Manage account" Command="{x:Bind ViewModel.ManageAccountCommand}"/>
                </StackPanel>

                <Button Content="Sign out" Command="{x:Bind ViewModel.SignOutCommand}"
                        Margin="0,16,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
