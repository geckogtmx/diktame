<Page x:Class="DiktaMe.App.Views.Settings.ApiKeysSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:WinUI3Localizer"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24,24,24,32">
        <StackPanel Spacing="28" MaxWidth="600">
            <TextBlock l:Uids.Uid="Settings_ApiKeys_Title" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock l:Uids.Uid="Settings_ApiKeys_Description" FontSize="12" Opacity="0.6"/>

            <!-- OpenAI -->
            <StackPanel Spacing="6">
                <TextBlock Text="OpenAI" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.OpenAiStatus, Mode=OneWay}" FontSize="12" Opacity="0.6"/>
                <PasswordBox Password="{x:Bind ViewModel.OpenAiKey, Mode=TwoWay}"
                             PlaceholderText="sk-..." HorizontalAlignment="Stretch"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save" Command="{x:Bind ViewModel.SaveOpenAiKeyCommand}"/>
                    <Button Content="Delete" Command="{x:Bind ViewModel.DeleteOpenAiKeyCommand}"/>
                </StackPanel>
            </StackPanel>

            <!-- Anthropic -->
            <StackPanel Spacing="6">
                <TextBlock Text="Anthropic" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.AnthropicStatus, Mode=OneWay}" FontSize="12" Opacity="0.6"/>
                <PasswordBox Password="{x:Bind ViewModel.AnthropicKey, Mode=TwoWay}"
                             PlaceholderText="sk-ant-..." HorizontalAlignment="Stretch"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save" Command="{x:Bind ViewModel.SaveAnthropicKeyCommand}"/>
                    <Button Content="Delete" Command="{x:Bind ViewModel.DeleteAnthropicKeyCommand}"/>
                </StackPanel>
            </StackPanel>

            <!-- Gemini -->
            <StackPanel Spacing="6">
                <TextBlock Text="Gemini" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.GeminiStatus, Mode=OneWay}" FontSize="12" Opacity="0.6"/>
                <PasswordBox Password="{x:Bind ViewModel.GeminiKey, Mode=TwoWay}"
                             PlaceholderText="AIza..." HorizontalAlignment="Stretch"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save" Command="{x:Bind ViewModel.SaveGeminiKeyCommand}"/>
                    <Button Content="Delete" Command="{x:Bind ViewModel.DeleteGeminiKeyCommand}"/>
                </StackPanel>
            </StackPanel>

            <!-- Deepgram -->
            <StackPanel Spacing="6">
                <TextBlock Text="Deepgram" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.DeepgramStatus, Mode=OneWay}" FontSize="12" Opacity="0.6"/>
                <PasswordBox l:Uids.Uid="Settings_ApiKeys_DeepgramPlaceholder" Password="{x:Bind ViewModel.DeepgramKey, Mode=TwoWay}"
                             HorizontalAlignment="Stretch"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save" Command="{x:Bind ViewModel.SaveDeepgramKeyCommand}"/>
                    <Button Content="Delete" Command="{x:Bind ViewModel.DeleteDeepgramKeyCommand}"/>
                </StackPanel>
            </StackPanel>

            <!-- Inworld -->
            <StackPanel Spacing="6">
                <TextBlock Text="Inworld" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.InworldStatus, Mode=OneWay}" FontSize="12" Opacity="0.6"/>
                <PasswordBox Password="{x:Bind ViewModel.InworldKey, Mode=TwoWay}"
                             PlaceholderText="Inworld API key" HorizontalAlignment="Stretch"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save" Command="{x:Bind ViewModel.SaveInworldKeyCommand}"/>
                    <Button Content="Delete" Command="{x:Bind ViewModel.DeleteInworldKeyCommand}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
