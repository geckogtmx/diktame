<Page x:Class="DiktaMe.App.Views.Settings.VisionSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer Padding="32,24,16,32">
        <StackPanel Spacing="16" MaxWidth="600">

            <!-- Title -->
            <TextBlock Text="Vision Settings" FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,4"/>

            <!-- Enable toggle -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Enable Vision" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                        <TextBlock Text="Allow screen capture analysis with an LLM." FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Provider -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Provider" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                    <TextBlock Text="Which LLM provider to use for vision requests." FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.ProviderOptions}"
                              SelectedIndex="{x:Bind ViewModel.SelectedProviderIndex, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <!-- Model ID -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Model" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                    <TextBlock Text="Model identifier (e.g. gemini-2.5-flash, moondream)." FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                    <TextBox Text="{x:Bind ViewModel.VisionModelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="gemini-2.5-flash"/>
                </StackPanel>
            </Border>

            <!-- Default query -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Default Query" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                    <TextBlock Text="The prompt sent with the screenshot when no voice query is recorded." FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                    <TextBox Text="{x:Bind ViewModel.DefaultQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="100" MaxHeight="200"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>

            <!-- Output mode -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Output Mode" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                    <TextBlock Text="Where to deliver the vision response." FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.OutputModeOptions}"
                              SelectedIndex="{x:Bind ViewModel.SelectedOutputModeIndex, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <!-- Auto-record voice -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Auto-Record Voice Query" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                        <TextBlock Text="Automatically start recording a voice query after capturing the screen." FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AutoRecordQuery, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Temperature -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Temperature" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                    <TextBlock Text="Controls response randomness (0.1 = focused, 1.0 = creative)." FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                    <Slider Minimum="0.1" Maximum="1.0" StepFrequency="0.1"
                            Value="{x:Bind ViewModel.Temperature, Mode=TwoWay}"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <!-- Max tokens -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Max Response Tokens" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                    <TextBlock Text="Maximum number of tokens in the LLM response." FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                    <NumberBox Value="{x:Bind ViewModel.MaxResponseTokens, Mode=TwoWay}"
                               Minimum="64" Maximum="16384" SpinButtonPlacementMode="Inline"
                               SmallChange="256" LargeChange="1024"
                               HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <!-- Ollama keep-alive -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Ollama Keep-Alive (seconds)" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                    <TextBlock Text="How long Ollama keeps the model loaded in memory after a request." FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                    <NumberBox Value="{x:Bind ViewModel.OllamaKeepAliveSeconds, Mode=TwoWay}"
                               Minimum="0" Maximum="3600" SpinButtonPlacementMode="Inline"
                               SmallChange="30" LargeChange="300"
                               HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <!-- Save button -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
                <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
