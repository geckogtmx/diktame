<Page x:Class="DiktaMe.App.Views.Settings.ModesSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Import shared converters -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Pipeline list -->
        <StackPanel Spacing="8">
            <TextBlock Text="Pipelines" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <ListView ItemsSource="{x:Bind ViewModel.ModeItems}"
                      SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="4,6">
                            <TextBlock Text="{Binding Title}" FontSize="14"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.6"
                                       Visibility="{Binding Subtitle, Converter={StaticResource NullToVis}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!-- Right: Detail pane -->
        <ScrollViewer Grid.Column="1" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel Spacing="20" MaxWidth="600">

                <!-- Mode Title -->
                <TextBlock Text="{x:Bind ViewModel.SelectedModeTitle, Mode=OneWay}"
                           FontSize="28" FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <!-- Ask: Output Mode (at top for Ask mode only) -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsAskSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Output Mode" FontWeight="SemiBold"/>
                    <TextBlock Text="How Ask pipeline results are delivered" FontSize="12" Opacity="0.6"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.AskOutputOptions}"
                              SelectedIndex="{x:Bind ViewModel.SelectedAskOutputIndex, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- Common: Cloud Model + Prompt -->
                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1" Padding="0,0,0,12"/>

                <StackPanel Spacing="4">
                    <TextBlock Text="Cloud Model" FontWeight="SemiBold"/>
                    <TextBlock Text="Model for Cloud profile (when using API providers)" FontSize="12" Opacity="0.6"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{x:Bind ViewModel.CloudModelNames}"
                                  SelectedIndex="{x:Bind ViewModel.SelectedCloudModelIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="1" Content="Refresh" Command="{x:Bind ViewModel.RefreshModelsCommand}"/>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.ShowPromptFields, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Cloud System Prompt" FontWeight="SemiBold"/>
                    <TextBox Text="{x:Bind ViewModel.CloudSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="150" MaxHeight="250"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <!-- Common: Local Model + Prompt -->
                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1" Padding="0,0,0,12"/>

                <StackPanel Spacing="4">
                    <TextBlock Text="Local Model" FontWeight="SemiBold"/>
                    <TextBlock Text="Model for Local profile (Ollama only)" FontSize="12" Opacity="0.6"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{x:Bind ViewModel.LocalModelNames}"
                                  SelectedIndex="{x:Bind ViewModel.SelectedLocalModelIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="1" Content="Refresh" Command="{x:Bind ViewModel.RefreshModelsCommand}"/>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.ShowPromptFields, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Local System Prompt" FontWeight="SemiBold"/>
                    <TextBox Text="{x:Bind ViewModel.LocalSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="150" MaxHeight="250"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <muxc:InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                              Message="Local profile uses the global Ollama model configured in the AI Engine tab."/>

                <!-- Notes: File path, LLM toggle, Timestamp, Preview -->
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsNoteSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1" Padding="0,0,0,12"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Note File Path" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{x:Bind ViewModel.NoteFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="Browse" Command="{x:Bind ViewModel.BrowseNoteFilePathCommand}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="LLM Processing" FontWeight="SemiBold"/>
                        <TextBlock Text="Enable AI formatting for notes" FontSize="12" Opacity="0.6"/>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.NoteUseLlmProcessing, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Timestamp Format" FontWeight="SemiBold"/>
                        <TextBlock Text="C# DateTime format string" FontSize="12" Opacity="0.6"/>
                        <TextBox Text="{x:Bind ViewModel.NoteTimestampFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Live Preview" FontWeight="SemiBold"/>
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" Padding="12" CornerRadius="4">
                            <TextBlock Text="{x:Bind ViewModel.NotePreviewText, Mode=OneWay}"
                                       FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Chat: Font, Opacity, Theme, History settings -->
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsChatSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1" Padding="0,0,0,12"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Font Size" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="10" Maximum="24" StepFrequency="1"
                                    Value="{x:Bind ViewModel.ChatFontSize, Mode=TwoWay}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.ChatFontSize, Mode=OneWay}"/>
                                <TextBlock Text="pt"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Window Opacity" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0.5" Maximum="1.0" StepFrequency="0.05"
                                    Value="{x:Bind ViewModel.ChatWindowOpacity, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ChatWindowOpacity, Mode=OneWay}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Theme" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{x:Bind ViewModel.ChatThemeOptions}"
                                  SelectedIndex="{x:Bind ViewModel.ChatSelectedThemeIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Forget on Close" FontWeight="SemiBold"/>
                        <TextBlock Text="Clear chat history when window closes" FontSize="12" Opacity="0.6"/>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.ChatForgetOnClose, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Max History Messages" FontWeight="SemiBold"/>
                        <muxc:NumberBox Value="{x:Bind ViewModel.ChatMaxHistoryMessages, Mode=TwoWay}"
                                        Minimum="0" Maximum="500" SpinButtonPlacementMode="Inline"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Show Timestamps" FontWeight="SemiBold"/>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.ChatShowTimestamps, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Enable Markdown" FontWeight="SemiBold"/>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.ChatEnableMarkdown, Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Bottom: Reset + Save buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
                    <!-- Reset button only visible for Notes or Chat -->
                    <Button Content="Reset to Defaults"
                            Command="{x:Bind ViewModel.ResetCommand}"
                            Visibility="{x:Bind ViewModel.CanReset, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

                    <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
