<Page x:Class="DiktaMe.App.Views.Settings.AIEngineSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24,24,24,32">
        <StackPanel Spacing="24" MaxWidth="600">
            <TextBlock Text="AI Engine" FontSize="24" FontWeight="SemiBold"/>

            <!-- STT Provider Mode -->
            <StackPanel Spacing="4">
                <TextBlock Text="Speech-to-Text (Ears)" FontWeight="SemiBold"/>
                <TextBlock Text="Choose how voice audio is transcribed to text" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.SttModes}"
                          SelectedIndex="{x:Bind ViewModel.SttModeIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- LLM Provider Mode -->
            <StackPanel Spacing="4">
                <TextBlock Text="Language Model (Brain)" FontWeight="SemiBold"/>
                <TextBlock Text="Choose how text is processed by AI" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.LlmModes}"
                          SelectedIndex="{x:Bind ViewModel.LlmModeIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Capability Summary -->
            <StackPanel Spacing="4">
                <TextBlock Text="Current Configuration" FontWeight="SemiBold"/>
                <Border CornerRadius="4" Padding="12,8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <TextBlock Text="{x:Bind ViewModel.CapabilitySummary, Mode=OneWay}"
                               FontSize="13" IsTextSelectionEnabled="True"/>
                </Border>
            </StackPanel>

            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                     Title="Per-mode overrides"
                     Message="Fine-grained provider and model selection is available on the Modes tab for each workflow mode."/>

            <!-- ── Deepgram STT Settings ─────────────────────────────── -->
            <TextBlock Text="Deepgram Settings" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0"/>

            <!-- Model -->
            <StackPanel Spacing="4">
                <TextBlock Text="Model" FontWeight="SemiBold"/>
                <TextBlock Text="Nova-3 has 47% lower word error rate than Nova-2" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.DeepgramModels}"
                          SelectedIndex="{x:Bind ViewModel.DeepgramModelIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Punctuate -->
            <StackPanel Spacing="4">
                <TextBlock Text="Auto-Punctuation" FontWeight="SemiBold"/>
                <TextBlock Text="Add punctuation marks and capitalization to transcripts" FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.DeepgramPunctuate, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Dictation -->
            <StackPanel Spacing="4">
                <TextBlock Text="Dictation Mode" FontWeight="SemiBold"/>
                <TextBlock Text="Say &quot;comma&quot;, &quot;period&quot;, &quot;question mark&quot; to insert punctuation. English only." FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.DeepgramDictation, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.IsDictationEnabled, Mode=OneWay}"/>
            </StackPanel>

            <!-- Smart Format -->
            <StackPanel Spacing="4">
                <TextBlock Text="Smart Formatting" FontWeight="SemiBold"/>
                <TextBlock Text="Auto-format dates, currency, phone numbers, emails. Includes punctuation." FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.DeepgramSmartFormat, Mode=TwoWay}"/>
                <TextBlock Text="Adds ~3 second buffer in streaming mode while formatting entities"
                           FontSize="11" Opacity="0.5" Visibility="{x:Bind ViewModel.DeepgramSmartFormat, Mode=OneWay}"/>
            </StackPanel>

            <!-- Replacements -->
            <StackPanel Spacing="4">
                <TextBlock Text="Find and Replace" FontWeight="SemiBold"/>
                <TextBlock Text="Server-side replacements applied before LLM. One per line: find:replace" FontSize="12" Opacity="0.6"/>
                <TextBox Text="{x:Bind ViewModel.DeepgramReplacements, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="80" MaxHeight="160"
                         PlaceholderText="monika:Monica&#x0a;zen desk:Zendesk"/>
                <TextBlock Text="Find terms must be lowercase. Complements Snippets (which run after LLM)."
                           FontSize="11" Opacity="0.5"/>
            </StackPanel>

            <!-- Streaming -->
            <StackPanel Spacing="4">
                <TextBlock Text="Real-Time Streaming" FontWeight="SemiBold"/>
                <TextBlock Text="Stream audio over WebSocket for instant transcription. Always operates in raw mode (no LLM)." FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.DeepgramStreaming, Mode=TwoWay}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
