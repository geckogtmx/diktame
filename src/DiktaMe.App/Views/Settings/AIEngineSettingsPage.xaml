<Page x:Class="DiktaMe.App.Views.Settings.AIEngineSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:WinUI3Localizer"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24,24,24,32">
        <StackPanel Spacing="24" MaxWidth="600">
            <TextBlock l:Uids.Uid="Settings_AIEngine_Title" FontSize="24" FontWeight="SemiBold"/>

            <!-- STT Provider Mode -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_AIEngine_STT_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_AIEngine_STT_Description" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.SttModes}"
                          SelectedIndex="{x:Bind ViewModel.SttModeIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- LLM Provider Mode -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_AIEngine_LLM_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_AIEngine_LLM_Description" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.LlmModes}"
                          SelectedIndex="{x:Bind ViewModel.LlmModeIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Capability Summary -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_AIEngine_CurrentConfig_Label" FontWeight="SemiBold"/>
                <Border CornerRadius="4" Padding="12,8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <TextBlock Text="{x:Bind ViewModel.CapabilitySummary, Mode=OneWay}"
                               FontSize="13" IsTextSelectionEnabled="True"/>
                </Border>
            </StackPanel>

            <InfoBar l:Uids.Uid="Settings_AIEngine_InfoBar" IsOpen="True" IsClosable="False" Severity="Informational"/>

            <!-- Deepgram STT Settings -->
            <TextBlock l:Uids.Uid="Settings_AIEngine_Deepgram_Section" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0"/>

            <!-- Model -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_AIEngine_Deepgram_Model_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_AIEngine_Deepgram_Model_Description" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.DeepgramModels}"
                          SelectedIndex="{x:Bind ViewModel.DeepgramModelIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Punctuate -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_AIEngine_Deepgram_Punctuate_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_AIEngine_Deepgram_Punctuate_Description" FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.DeepgramPunctuate, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Dictation -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_AIEngine_Deepgram_Dictation_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_AIEngine_Deepgram_Dictation_Description" FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.DeepgramDictation, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.IsDictationEnabled, Mode=OneWay}"/>
            </StackPanel>

            <!-- Smart Format -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_AIEngine_Deepgram_SmartFormat_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_AIEngine_Deepgram_SmartFormat_Description" FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.DeepgramSmartFormat, Mode=TwoWay}"/>
                <TextBlock l:Uids.Uid="Settings_AIEngine_Deepgram_SmartFormat_Warning"
                           FontSize="11" Opacity="0.5" Visibility="{x:Bind ViewModel.DeepgramSmartFormat, Mode=OneWay}"/>
            </StackPanel>

            <!-- Replacements -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_AIEngine_Deepgram_Replace_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_AIEngine_Deepgram_Replace_Description" FontSize="12" Opacity="0.6"/>
                <TextBox Text="{x:Bind ViewModel.DeepgramReplacements, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="80" MaxHeight="160"
                         PlaceholderText="monika:Monica&#x0a;zen desk:Zendesk"/>
                <TextBlock l:Uids.Uid="Settings_AIEngine_Deepgram_Replace_Help"
                           FontSize="11" Opacity="0.5"/>
            </StackPanel>

            <!-- Streaming -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_AIEngine_Deepgram_Streaming_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_AIEngine_Deepgram_Streaming_Description" FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.DeepgramStreaming, Mode=TwoWay}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
