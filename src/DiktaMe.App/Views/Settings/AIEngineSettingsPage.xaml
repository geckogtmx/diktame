<Page x:Class="DiktaMe.App.Views.Settings.AIEngineSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24,24,24,32">
        <StackPanel Spacing="24" MaxWidth="600">
            <TextBlock Text="AI Engine" FontSize="24" FontWeight="SemiBold"/>

            <!-- STT Provider Mode -->
            <StackPanel Spacing="4">
                <TextBlock Text="Speech-to-Text (Ears)" FontWeight="SemiBold"/>
                <TextBlock Text="Choose how voice audio is transcribed to text" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.SttModes}"
                          SelectedIndex="{x:Bind ViewModel.SttModeIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- LLM Provider Mode -->
            <StackPanel Spacing="4">
                <TextBlock Text="Language Model (Brain)" FontWeight="SemiBold"/>
                <TextBlock Text="Choose how text is processed by AI" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.LlmModes}"
                          SelectedIndex="{x:Bind ViewModel.LlmModeIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Capability Summary -->
            <StackPanel Spacing="4">
                <TextBlock Text="Current Configuration" FontWeight="SemiBold"/>
                <Border CornerRadius="4" Padding="12,8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <TextBlock Text="{x:Bind ViewModel.CapabilitySummary, Mode=OneWay}"
                               FontSize="13" IsTextSelectionEnabled="True"/>
                </Border>
            </StackPanel>

            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                     Title="Per-mode overrides"
                     Message="Fine-grained provider and model selection is available on the Modes tab for each workflow mode."/>
        </StackPanel>
    </ScrollViewer>
</Page>
