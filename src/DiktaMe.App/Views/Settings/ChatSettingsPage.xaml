<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="DiktaMe.App.Views.Settings.ChatSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="24" MaxWidth="800">

            <!-- Page header -->
            <StackPanel Spacing="8">
                <TextBlock Text="💬 Quick Chat" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Configure the Chat overlay window appearance and behavior"
                           Opacity="0.6" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Font Size -->
            <StackPanel Spacing="8">
                <TextBlock Text="Font Size" FontWeight="SemiBold"/>
                <TextBlock Text="Chat message text size (in points)" FontSize="12" Opacity="0.6"/>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Slider Value="{x:Bind ViewModel.FontSize, Mode=TwoWay}"
                            Minimum="10" Maximum="24" StepFrequency="1"
                            Width="300"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.FontSize, Mode=OneWay}" Width="30" VerticalAlignment="Center"/>
                    <TextBlock Text="pt" Opacity="0.6" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Window Opacity -->
            <StackPanel Spacing="8">
                <TextBlock Text="Window Opacity" FontWeight="SemiBold"/>
                <TextBlock Text="Chat window transparency (1.0 = fully opaque)" FontSize="12" Opacity="0.6"/>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Slider Value="{x:Bind ViewModel.WindowOpacity, Mode=TwoWay}"
                            Minimum="0.5" Maximum="1.0" StepFrequency="0.05"
                            Width="300"
                            VerticalAlignment="Center"/>
                    <TextBlock Width="40" VerticalAlignment="Center">
                        <Run Text="{x:Bind ViewModel.WindowOpacity, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <!-- Theme -->
            <StackPanel Spacing="8">
                <TextBlock Text="Theme" FontWeight="SemiBold"/>
                <TextBlock Text="Chat overlay color scheme" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                          SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                          Width="200"
                          HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- Forget on Close -->
            <StackPanel Spacing="8">
                <TextBlock Text="Forget on Close" FontWeight="SemiBold"/>
                <TextBlock Text="Clear chat history when closing the overlay (privacy mode)" FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.ForgetOnClose, Mode=TwoWay}"
                              OnContent="Enabled (history cleared)"
                              OffContent="Disabled (history persists)"/>
            </StackPanel>

            <!-- Max History Messages -->
            <StackPanel Spacing="8">
                <TextBlock Text="Maximum History Messages" FontWeight="SemiBold"/>
                <TextBlock Text="Number of messages to keep in chat history (0 = unlimited)" FontSize="12" Opacity="0.6"/>
                <NumberBox Value="{x:Bind ViewModel.MaxHistoryMessages, Mode=TwoWay}"
                           Minimum="0" Maximum="500" SpinButtonPlacementMode="Inline"
                           Width="200" HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- Show Timestamps -->
            <StackPanel Spacing="8">
                <TextBlock Text="Show Timestamps" FontWeight="SemiBold"/>
                <TextBlock Text="Display timestamp next to each message" FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.ShowTimestamps, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Enable Markdown -->
            <StackPanel Spacing="8">
                <TextBlock Text="Enable Markdown Rendering" FontWeight="SemiBold"/>
                <TextBlock Text="Render markdown formatting in chat messages (code blocks, bold, etc.)" FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.EnableMarkdown, Mode=TwoWay}"/>
            </StackPanel>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8"/>

            <!-- Cloud Profile System Prompt -->
            <StackPanel Spacing="8">
                <TextBlock Text="Cloud Profile — Chat System Prompt" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="This prompt guides the AI's personality and behavior in the chat overlay (Cloud profile)."
                           FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                <TextBox Text="{x:Bind ViewModel.CloudSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="150"
                         MaxHeight="250"
                         PlaceholderText="Enter system prompt for Cloud profile..."/>
            </StackPanel>

            <!-- Local Profile System Prompt -->
            <StackPanel Spacing="8">
                <TextBlock Text="Local Profile — Chat System Prompt" FontSize="18" FontWeight="SemiBold"/>
                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,0,0,8"
                         Message="Local profile uses the global Ollama model configured in the AI Engine tab."/>
                <TextBox Text="{x:Bind ViewModel.LocalSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="150"
                         MaxHeight="250"
                         PlaceholderText="Enter system prompt for Local profile..."/>
            </StackPanel>

            <!-- Save and Reset buttons -->
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <Button Content="Reset to Defaults" Command="{x:Bind ViewModel.ResetCommand}"/>
                <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
