<Page x:Class="DiktaMe.App.Views.Settings.WorkflowsSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:WinUI3Localizer"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:vm="using:DiktaMe.App.ViewModels.Settings"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Sub-item list -->
        <StackPanel Spacing="8">
            <TextBlock l:Uids.Uid="Settings_Workflows_Title" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <ListView ItemsSource="{x:Bind ViewModel.SubItems}"
                      SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="4,6">
                            <TextBlock Text="{Binding Title}" FontSize="14"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!-- Right: Detail pane -->
        <ScrollViewer Grid.Column="1" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel Spacing="20" MaxWidth="600">

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- Dictation Behaviors                                       -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.IsDictationBehaviorsSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                    <!-- Additional Key -->
                    <StackPanel Spacing="4">
                        <TextBlock l:Uids.Uid="Settings_General_AdditionalKey_Label" FontWeight="SemiBold"/>
                        <TextBlock l:Uids.Uid="Settings_General_AdditionalKey_Description" FontSize="12" Opacity="0.6"/>
                        <ComboBox ItemsSource="{x:Bind ViewModel.AdditionalKeyOptions}"
                                  SelectedIndex="{x:Bind ViewModel.SelectedAdditionalKeyIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Trailing Space -->
                    <StackPanel Spacing="4">
                        <TextBlock l:Uids.Uid="Settings_General_TrailingSpace_Label" FontWeight="SemiBold"/>
                        <TextBlock l:Uids.Uid="Settings_General_TrailingSpace_Description" FontSize="12" Opacity="0.6"/>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.TrailingSpace, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- Raw Mode Override -->
                    <StackPanel Spacing="4">
                        <TextBlock l:Uids.Uid="Settings_Workflows_RawModeOverride_Label" FontWeight="SemiBold"/>
                        <TextBlock l:Uids.Uid="Settings_Workflows_RawModeOverride_Description" FontSize="12" Opacity="0.6"/>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.RawModeOverride, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- Refine Voice Mode -->
                    <StackPanel Spacing="4">
                        <TextBlock l:Uids.Uid="Settings_Workflows_RefineVoiceMode_Label" FontWeight="SemiBold"/>
                        <TextBlock l:Uids.Uid="Settings_Workflows_RefineVoiceMode_Description" FontSize="12" Opacity="0.6"/>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.RefineVoiceMode, Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- Dictation Presets (CRUD)                                  -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.IsDictationPresetsSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Preset list + toolbar -->
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListView ItemsSource="{x:Bind ViewModel.DictationPresets.ModeItems}"
                                      SelectedIndex="{x:Bind ViewModel.DictationPresets.SelectedIndex, Mode=TwoWay}"
                                      SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModeListItem">
                                        <Grid Padding="4,6">
                                            <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                                <Button Content="+" ToolTipService.ToolTip="New Preset"
                                        Command="{x:Bind ViewModel.DictationPresets.CreateModeCommand}"
                                        Width="36" Height="32"/>
                                <Button ToolTipService.ToolTip="Move Up"
                                        Command="{x:Bind ViewModel.DictationPresets.MoveUpCommand}"
                                        Width="36" Height="32">
                                    <FontIcon Glyph="&#xE70E;" FontSize="12"/>
                                </Button>
                                <Button ToolTipService.ToolTip="Move Down"
                                        Command="{x:Bind ViewModel.DictationPresets.MoveDownCommand}"
                                        Width="36" Height="32">
                                    <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                                </Button>
                                <Button ToolTipService.ToolTip="Delete Preset"
                                        Command="{x:Bind ViewModel.DictationPresets.DeleteModeCommand}"
                                        Width="36" Height="32">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Preset editor -->
                        <ScrollViewer Grid.Column="1"
                                      Visibility="{x:Bind ViewModel.DictationPresets.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Spacing="16" MaxWidth="500">

                                <!-- Title -->
                                <StackPanel Spacing="4">
                                    <TextBlock l:Uids.Uid="Settings_DictationModes_Title_Label" FontWeight="SemiBold"/>
                                    <TextBox l:Uids.Uid="Settings_DictationModes_Title_Placeholder"
                                             Text="{x:Bind ViewModel.DictationPresets.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <!-- Cloud Profile -->
                                <TextBlock l:Uids.Uid="Settings_DictationModes_CloudProfile_Title" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>

                                <StackPanel Spacing="4">
                                    <TextBlock l:Uids.Uid="Settings_DictationModes_LlmModel_Label" FontWeight="SemiBold"/>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{x:Bind ViewModel.DictationPresets.CloudModelNames}"
                                                  SelectedIndex="{x:Bind ViewModel.DictationPresets.SelectedCloudModelIndex, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  IsEnabled="{x:Bind ViewModel.DictationPresets.IsLoadingModels, Mode=OneWay, Converter={StaticResource BoolNeg}}"/>
                                        <Button Grid.Column="1" ToolTipService.ToolTip="Refresh model list"
                                                Command="{x:Bind ViewModel.DictationPresets.RefreshModelsCommand}">
                                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock l:Uids.Uid="Settings_DictationModes_CloudSystemPrompt_Label" FontWeight="SemiBold"/>
                                    <TextBox Text="{x:Bind ViewModel.DictationPresets.CloudSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="100" MaxHeight="180"/>
                                </StackPanel>

                                <StackPanel Spacing="4"
                                            Visibility="{x:Bind ViewModel.DictationPresets.IsDictationMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <TextBlock l:Uids.Uid="Settings_DictationModes_CloudUseLlm_Label" FontWeight="SemiBold"/>
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.DictationPresets.CloudUseLlm, Mode=TwoWay}"/>
                                </StackPanel>

                                <!-- Local Profile -->
                                <TextBlock l:Uids.Uid="Settings_DictationModes_LocalProfile_Title" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0"/>

                                <StackPanel Spacing="4">
                                    <TextBlock l:Uids.Uid="Settings_DictationModes_LocalSystemPrompt_Label" FontWeight="SemiBold"/>
                                    <TextBox Text="{x:Bind ViewModel.DictationPresets.LocalSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="100" MaxHeight="180"/>
                                </StackPanel>

                                <StackPanel Spacing="4"
                                            Visibility="{x:Bind ViewModel.DictationPresets.IsDictationMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <TextBlock l:Uids.Uid="Settings_DictationModes_LocalUseLlm_Label" FontWeight="SemiBold"/>
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.DictationPresets.LocalUseLlm, Mode=TwoWay}"/>
                                </StackPanel>

                                <!-- Save button -->
                                <Button l:Uids.Uid="Settings_DictationModes_SaveButton" Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.DictationPresets.SaveCommand}"
                                        HorizontalAlignment="Right"
                                        Margin="0,12,0,24"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </StackPanel>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- Utility Pipelines (Ask, Refine, Translate, Note, Chat)    -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.IsUtilityPipelineSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                    <!-- Mode Title -->
                    <TextBlock Text="{x:Bind ViewModel.UtilityPipelines.SelectedModeTitle, Mode=OneWay}"
                               FontSize="28" FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <!-- Ask: Output Mode -->
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.UtilityPipelines.IsAskSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock l:Uids.Uid="Settings_Modes_OutputMode_Label" FontWeight="SemiBold"/>
                        <TextBlock l:Uids.Uid="Settings_Modes_OutputMode_Description" FontSize="12" Opacity="0.6"/>
                        <ComboBox ItemsSource="{x:Bind ViewModel.UtilityPipelines.AskOutputOptions}"
                                  SelectedIndex="{x:Bind ViewModel.UtilityPipelines.SelectedAskOutputIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Common: Cloud Model + Prompt -->
                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1" Padding="0,0,0,12"/>

                    <StackPanel Spacing="4">
                        <TextBlock l:Uids.Uid="Settings_Modes_CloudModel_Label" FontWeight="SemiBold"/>
                        <TextBlock l:Uids.Uid="Settings_Modes_CloudModel_Description" FontSize="12" Opacity="0.6"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{x:Bind ViewModel.UtilityPipelines.CloudModelNames}"
                                      SelectedIndex="{x:Bind ViewModel.UtilityPipelines.SelectedCloudModelIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                            <Button l:Uids.Uid="Settings_Modes_CloudRefreshButton" Grid.Column="1" Command="{x:Bind ViewModel.UtilityPipelines.RefreshModelsCommand}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.UtilityPipelines.ShowPromptFields, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock l:Uids.Uid="Settings_Modes_CloudPrompt_Label" FontWeight="SemiBold"/>
                        <TextBox Text="{x:Bind ViewModel.UtilityPipelines.CloudSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="150" MaxHeight="250"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <!-- Common: Local Model + Prompt -->
                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1" Padding="0,0,0,12"/>

                    <StackPanel Spacing="4">
                        <TextBlock l:Uids.Uid="Settings_Modes_LocalModel_Label" FontWeight="SemiBold"/>
                        <TextBlock l:Uids.Uid="Settings_Modes_LocalModel_Description" FontSize="12" Opacity="0.6"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{x:Bind ViewModel.UtilityPipelines.LocalModelNames}"
                                      SelectedIndex="{x:Bind ViewModel.UtilityPipelines.SelectedLocalModelIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                            <Button l:Uids.Uid="Settings_Modes_LocalRefreshButton" Grid.Column="1" Command="{x:Bind ViewModel.UtilityPipelines.RefreshModelsCommand}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.UtilityPipelines.ShowPromptFields, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock l:Uids.Uid="Settings_Modes_LocalPrompt_Label" FontWeight="SemiBold"/>
                        <TextBox Text="{x:Bind ViewModel.UtilityPipelines.LocalSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="150" MaxHeight="250"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <muxc:InfoBar l:Uids.Uid="Settings_Modes_OllamaInfoBar" IsOpen="True" IsClosable="False" Severity="Informational"/>

                    <!-- Notes fields -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.UtilityPipelines.IsNoteSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1" Padding="0,0,0,12"/>

                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Modes_NoteFilePath_Label" FontWeight="SemiBold"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{x:Bind ViewModel.UtilityPipelines.NoteFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button l:Uids.Uid="Settings_Modes_BrowseButton" Grid.Column="1" Command="{x:Bind ViewModel.UtilityPipelines.BrowseNoteFilePathCommand}"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Modes_LlmProcessing_Label" FontWeight="SemiBold"/>
                            <TextBlock l:Uids.Uid="Settings_Modes_LlmProcessing_Description" FontSize="12" Opacity="0.6"/>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.UtilityPipelines.NoteUseLlmProcessing, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Modes_TimestampFormat_Label" FontWeight="SemiBold"/>
                            <TextBlock l:Uids.Uid="Settings_Modes_TimestampFormat_Description" FontSize="12" Opacity="0.6"/>
                            <TextBox Text="{x:Bind ViewModel.UtilityPipelines.NoteTimestampFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Modes_LivePreview_Label" FontWeight="SemiBold"/>
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" Padding="12" CornerRadius="4">
                                <TextBlock Text="{x:Bind ViewModel.UtilityPipelines.NotePreviewText, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Chat fields -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.UtilityPipelines.IsChatSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1" Padding="0,0,0,12"/>

                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Modes_FontSize_Label" FontWeight="SemiBold"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="10" Maximum="24" StepFrequency="1"
                                        Value="{x:Bind ViewModel.UtilityPipelines.ChatFontSize, Mode=TwoWay}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.UtilityPipelines.ChatFontSize, Mode=OneWay}"/>
                                    <TextBlock l:Uids.Uid="Settings_Modes_FontSizeUnit"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Modes_WindowOpacity_Label" FontWeight="SemiBold"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="0.5" Maximum="1.0" StepFrequency="0.05"
                                        Value="{x:Bind ViewModel.UtilityPipelines.ChatWindowOpacity, Mode=TwoWay}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.UtilityPipelines.ChatWindowOpacity, Mode=OneWay}"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Modes_Theme_Label" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.UtilityPipelines.ChatThemeOptions}"
                                      SelectedIndex="{x:Bind ViewModel.UtilityPipelines.ChatSelectedThemeIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Modes_ForgetOnClose_Label" FontWeight="SemiBold"/>
                            <TextBlock l:Uids.Uid="Settings_Modes_ForgetOnClose_Description" FontSize="12" Opacity="0.6"/>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.UtilityPipelines.ChatForgetOnClose, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Modes_MaxHistory_Label" FontWeight="SemiBold"/>
                            <muxc:NumberBox Value="{x:Bind ViewModel.UtilityPipelines.ChatMaxHistoryMessages, Mode=TwoWay}"
                                            Minimum="0" Maximum="500" SpinButtonPlacementMode="Inline"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Modes_ShowTimestamps_Label" FontWeight="SemiBold"/>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.UtilityPipelines.ChatShowTimestamps, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Modes_EnableMarkdown_Label" FontWeight="SemiBold"/>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.UtilityPipelines.ChatEnableMarkdown, Mode=TwoWay}"/>
                        </StackPanel>

                        <!-- New Chat fields (SPEC_012) -->
                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Chat_AlwaysOnTop_Label" FontWeight="SemiBold"/>
                            <TextBlock l:Uids.Uid="Settings_Chat_AlwaysOnTop_Description" FontSize="12" Opacity="0.6"/>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.UtilityPipelines.ChatAlwaysOnTop, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Chat_DefaultModel_Label" FontWeight="SemiBold"/>
                            <TextBlock l:Uids.Uid="Settings_Chat_DefaultModel_Description" FontSize="12" Opacity="0.6"/>
                            <TextBox Text="{x:Bind ViewModel.UtilityPipelines.ChatDefaultModelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="(use profile default)"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Chat_DefaultSystemPrompt_Label" FontWeight="SemiBold"/>
                            <TextBlock l:Uids.Uid="Settings_Chat_DefaultSystemPrompt_Description" FontSize="12" Opacity="0.6"/>
                            <TextBox Text="{x:Bind ViewModel.UtilityPipelines.ChatDefaultSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="80" MaxHeight="200"
                                     PlaceholderText="(use built-in default)"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Chat_WebSearch_Label" FontWeight="SemiBold"/>
                            <TextBlock l:Uids.Uid="Settings_Chat_WebSearch_Description" FontSize="12" Opacity="0.6"/>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.UtilityPipelines.ChatWebSearchEnabled, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Bottom: Reset + Save buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
                        <Button l:Uids.Uid="Settings_Modes_ResetToDefaults"
                                Command="{x:Bind ViewModel.UtilityPipelines.ResetCommand}"
                                Visibility="{x:Bind ViewModel.UtilityPipelines.CanReset, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                        <Button l:Uids.Uid="Settings_Modes_SaveButton" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.UtilityPipelines.SaveCommand}"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
