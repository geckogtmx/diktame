<Page x:Class="DiktaMe.App.Views.Settings.WorkflowsSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:WinUI3Localizer"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:converters="using:DiktaMe.App.Converters"
      Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="LocalBoolToVis"/>
            <converters:InverseBoolToVisibilityConverter x:Key="LocalInverseBoolToVis"/>
        </ResourceDictionary>
    </Page.Resources>

    <Grid ColumnSpacing="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Sub-item list -->
        <Border Background="{StaticResource AppSurfaceTranslucentBrush}"
                Padding="24">
            <StackPanel Spacing="8">
                <TextBlock l:Uids.Uid="Settings_Workflows_Title" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"
                           Foreground="{StaticResource AppTextBrush}"/>
                <ListView ItemsSource="{x:Bind ViewModel.SubItems}"
                          SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.Resources>
                        <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="SubNavItemBackgroundSelected"/>
                        <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="SubNavItemBackgroundSelected"/>
                        <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="SubNavItemBackgroundSelected"/>
                        <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="SubNavItemForegroundSelected"/>
                    </ListView.Resources>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="4,6">
                                <TextBlock Text="{Binding Title}" FontSize="14"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <!-- Right: Detail pane -->
        <ScrollViewer Grid.Column="1" Padding="24,24,16,32"
                      Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel Spacing="16" MaxWidth="600">

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- Speak (TTS) — per-pipeline speak toggles                  -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsSpeakSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                    <TextBlock Text="Speak (TTS)" FontSize="28" FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}"
                               Margin="0,0,0,4"/>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock l:Uids.Uid="Settings_Tts_SpeakAsk_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock l:Uids.Uid="Settings_Tts_SpeakAsk_Description" FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.Tts.SpeakAskResponses, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock l:Uids.Uid="Settings_Tts_SpeakChat_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock l:Uids.Uid="Settings_Tts_SpeakChat_Description" FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.Tts.SpeakChatResponses, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock l:Uids.Uid="Settings_Tts_SpeakTranslate_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock l:Uids.Uid="Settings_Tts_SpeakTranslate_Description" FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.Tts.SpeakTranslations, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock l:Uids.Uid="Settings_Tts_SpeakNotifications_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock l:Uids.Uid="Settings_Tts_SpeakNotifications_Description" FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.Tts.SpeakNotifications, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock l:Uids.Uid="Settings_Tts_DuckOtherApps_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock l:Uids.Uid="Settings_Tts_DuckOtherApps_Description" FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.Tts.DuckDuringPlayback, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock l:Uids.Uid="Settings_Tts_ReadSelection_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                <TextBlock l:Uids.Uid="Settings_Tts_ReadSelection_Description" FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.Tts.ReadSelectionHotkey}" FontSize="14" FontWeight="Medium" Opacity="0.8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- Vision Pipeline Settings                                  -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsVisionSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                    <TextBlock Text="Vision" FontSize="28" FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}"
                               Margin="0,0,0,4"/>

                    <!-- Shared settings (above Cloud/Local tabs) -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Enable Vision" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Ctrl+Alt+S to capture and analyze screen content" FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.VisionEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Inject-at-cursor toggles (AI text always goes to clipboard; these control cursor injection) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Clip: Inject at Cursor" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Also inject AI text at cursor position (always copied to clipboard)" FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ClipInjectAtCursor, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="OCR: Inject at Cursor" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Also inject extracted text at cursor position (always copied to clipboard)" FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.OcrInjectAtCursor, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Color Picker: Inject at Cursor" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Also inject color value at cursor position (always copied to clipboard)" FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ColorPickerInjectAtCursor, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Video AI: Inject at Cursor" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Also inject Describe/Document/Bug Report result at cursor (always copied to clipboard)" FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.VideoAiInjectAtCursor, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Max Response Tokens" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                <TextBlock Text="Maximum length of the AI response" FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                                <muxc:NumberBox Value="{x:Bind ViewModel.VisionMaxResponseTokens, Mode=TwoWay}"
                                                Minimum="64" Maximum="16384" SpinButtonPlacementMode="Compact"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Max Image Dimension (px)" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                <TextBlock Text="Screenshots larger than this are downscaled before sending to the AI" FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                                <muxc:NumberBox Value="{x:Bind ViewModel.VisionMaxImageDimensionPx, Mode=TwoWay}"
                                                Minimum="512" Maximum="4096" SpinButtonPlacementMode="Compact"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Save Folder -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Save Folder" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                            <TextBlock Text="Where screenshots and recordings are saved (leave empty for default)" FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{x:Bind ViewModel.VisionSaveFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="%APPDATA%\DiktaMe\vision\"
                                         VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Browse" Command="{x:Bind ViewModel.BrowseVisionFolderCommand}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Screen Recording settings -->
                    <TextBlock Text="Screen Recording" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}"
                               Margin="0,8,0,0"/>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="16">
                            <!-- Video Quality -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Video Quality" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                <TextBlock Text="Higher quality produces larger files" FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                                <ComboBox ItemsSource="{x:Bind ViewModel.VideoQualityOptions}"
                                          SelectedIndex="{x:Bind ViewModel.VideoQualityIndex, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <!-- Mic Audio -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Microphone Audio" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Record microphone input in the video" FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.EnableMicAudio, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Mic Device Picker (visible when mic is on) -->
                            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.EnableMicAudio, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Microphone Device" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                <ComboBox ItemsSource="{x:Bind ViewModel.MicDevices}"
                                          SelectedItem="{x:Bind ViewModel.SelectedMicDevice, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <!-- System Audio -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="System Audio" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Record desktop/application audio via WASAPI loopback" FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.EnableSystemAudio, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Output Device Picker (visible when system audio is on) -->
                            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.EnableSystemAudio, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Output Device" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                <ComboBox ItemsSource="{x:Bind ViewModel.OutputDevices}"
                                          SelectedItem="{x:Bind ViewModel.SelectedOutputDevice, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <!-- Webcam Overlay -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Webcam Overlay" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Show picture-in-picture webcam bubble in recording" FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.EnableWebcam, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Webcam Size (visible only when webcam is on) -->
                            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.EnableWebcam, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Webcam Size" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                <ComboBox ItemsSource="{x:Bind ViewModel.WebcamSizeOptions}"
                                          SelectedIndex="{x:Bind ViewModel.WebcamSizeIndex, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <!-- Webcam Position (visible only when webcam is on) -->
                            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.EnableWebcam, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Webcam Position" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                <ComboBox ItemsSource="{x:Bind ViewModel.WebcamPositionOptions}"
                                          SelectedIndex="{x:Bind ViewModel.WebcamPositionIndex, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Cloud / Local segmented toggle -->
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,8" Padding="4"
                                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8"
                                Background="{StaticResource AppBackgroundTranslucentBrush}" HorizontalAlignment="Left">
                        <Button Content="Cloud" Command="{x:Bind ViewModel.SelectVisionCloudCommand}"
                                Style="{StaticResource SegmentedLeftActiveStyle}"
                                Visibility="{x:Bind ViewModel.IsVisionCloudTab, Mode=OneWay, Converter={StaticResource LocalBoolToVis}}"/>
                        <Button Content="Cloud" Command="{x:Bind ViewModel.SelectVisionCloudCommand}"
                                Style="{StaticResource SegmentedLeftStyle}"
                                Visibility="{x:Bind ViewModel.IsVisionCloudTab, Mode=OneWay, Converter={StaticResource LocalInverseBoolToVis}}"/>
                        <Button Content="Local" Command="{x:Bind ViewModel.SelectVisionLocalCommand}"
                                Style="{StaticResource SegmentedRightActiveStyle}"
                                Visibility="{x:Bind ViewModel.IsVisionCloudTab, Mode=OneWay, Converter={StaticResource LocalInverseBoolToVis}}"/>
                        <Button Content="Local" Command="{x:Bind ViewModel.SelectVisionLocalCommand}"
                                Style="{StaticResource SegmentedRightStyle}"
                                Visibility="{x:Bind ViewModel.IsVisionCloudTab, Mode=OneWay, Converter={StaticResource LocalBoolToVis}}"/>
                    </StackPanel>

                    <!-- Cloud tab: prompt only (model set in AI Engine) -->
                    <StackPanel Spacing="16"
                                Visibility="{x:Bind ViewModel.IsVisionCloudTab, Mode=OneWay, Converter={StaticResource LocalBoolToVis}}">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Default Query" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                <TextBlock Text="Sent with the screenshot when no voice query is recorded" FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                                <TextBox Text="{x:Bind ViewModel.VisionDefaultQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="80" MaxHeight="200"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="System Prompt (Cloud)" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                <TextBlock Text="Instructions sent to the cloud vision model with every request" FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                                <TextBox Text="{x:Bind ViewModel.VisionCloudSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="80" MaxHeight="200"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                        <muxc:InfoBar Title="Cloud Vision" Message="Model and provider are configured in AI Engine → Vision" IsOpen="True" IsClosable="False" Severity="Informational"/>
                    </StackPanel>

                    <!-- Local tab: prompt only (model set in AI Engine) -->
                    <StackPanel Spacing="16"
                                Visibility="{x:Bind ViewModel.IsVisionCloudTab, Mode=OneWay, Converter={StaticResource LocalInverseBoolToVis}}">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Default Query" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                <TextBlock Text="Sent with the screenshot when no voice query is recorded (local models may need simpler prompts)" FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                                <TextBox Text="{x:Bind ViewModel.VisionDefaultQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="80" MaxHeight="200"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="System Prompt (Local)" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                <TextBlock Text="Instructions sent to the local vision model with every request" FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                                <TextBox Text="{x:Bind ViewModel.VisionLocalSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="80" MaxHeight="200"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                        <muxc:InfoBar Title="Local Vision" Message="Model is configured in AI Engine → Vision → Local" IsOpen="True" IsClosable="False" Severity="Informational"/>
                    </StackPanel>

                    <!-- Action Prompts (collapsed by default) -->
                    <muxc:Expander Header="Action Prompts" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                   IsExpanded="False" Margin="0,4,0,0">
                        <StackPanel Spacing="16" Padding="0,8,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="OCR" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                <TextBox Text="{x:Bind ViewModel.OcrPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="160"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Table Extraction" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                <TextBox Text="{x:Bind ViewModel.TablePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="160"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Video: Describe" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                <TextBox Text="{x:Bind ViewModel.VideoDescribePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="160"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Video: Document" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                <TextBox Text="{x:Bind ViewModel.VideoDocumentPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="160"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Video: Bug Report" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                <TextBox Text="{x:Bind ViewModel.VideoBugReportPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="160"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Video: System Prompt" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                <TextBlock Text="Base instructions for all video analysis actions" FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                                <TextBox Text="{x:Bind ViewModel.VideoSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="160"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </StackPanel>
                    </muxc:Expander>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
                        <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveVisionCommand}"/>
                    </StackPanel>
                </StackPanel>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- Utility Pipelines (Ask, Refine, Translate, Note)          -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsUtilityPipelineSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                    <!-- Mode Title -->
                    <TextBlock Text="{x:Bind ViewModel.UtilityPipelines.SelectedModeTitle, Mode=OneWay}"
                               FontSize="28" FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}"
                               Margin="0,0,0,4"/>

                    <!-- Ask: Output Mode -->
                    <Border Style="{StaticResource SettingsCardStyle}"
                            Visibility="{x:Bind ViewModel.UtilityPipelines.IsAskSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Modes_OutputMode_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                            <TextBlock l:Uids.Uid="Settings_Modes_OutputMode_Description" FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.UtilityPipelines.AskOutputOptions}"
                                      SelectedIndex="{x:Bind ViewModel.UtilityPipelines.SelectedAskOutputIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- Cloud / Local segmented toggle -->
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,8" Padding="4"
                                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8"
                                Background="{StaticResource AppBackgroundTranslucentBrush}" HorizontalAlignment="Left">
                        <Button Content="Cloud" Command="{x:Bind ViewModel.UtilityPipelines.SelectCloudCommand}"
                                Style="{StaticResource SegmentedLeftActiveStyle}"
                                Visibility="{x:Bind ViewModel.UtilityPipelines.IsCloudTab, Mode=OneWay, Converter={StaticResource LocalBoolToVis}}"/>
                        <Button Content="Cloud" Command="{x:Bind ViewModel.UtilityPipelines.SelectCloudCommand}"
                                Style="{StaticResource SegmentedLeftStyle}"
                                Visibility="{x:Bind ViewModel.UtilityPipelines.IsCloudTab, Mode=OneWay, Converter={StaticResource LocalInverseBoolToVis}}"/>
                        <Button Content="Local" Command="{x:Bind ViewModel.UtilityPipelines.SelectLocalCommand}"
                                Style="{StaticResource SegmentedRightActiveStyle}"
                                Visibility="{x:Bind ViewModel.UtilityPipelines.IsCloudTab, Mode=OneWay, Converter={StaticResource LocalInverseBoolToVis}}"/>
                        <Button Content="Local" Command="{x:Bind ViewModel.UtilityPipelines.SelectLocalCommand}"
                                Style="{StaticResource SegmentedRightStyle}"
                                Visibility="{x:Bind ViewModel.UtilityPipelines.IsCloudTab, Mode=OneWay, Converter={StaticResource LocalBoolToVis}}"/>
                    </StackPanel>

                    <!-- ── Cloud tab content ─────────────────────────────── -->
                    <StackPanel Spacing="16"
                                Visibility="{x:Bind ViewModel.UtilityPipelines.IsCloudTab, Mode=OneWay, Converter={StaticResource LocalBoolToVis}}">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock l:Uids.Uid="Settings_Modes_CloudModel_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                <TextBlock l:Uids.Uid="Settings_Modes_CloudModel_Description" FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{x:Bind ViewModel.UtilityPipelines.CloudModelNames}"
                                              SelectedIndex="{x:Bind ViewModel.UtilityPipelines.SelectedCloudModelIndex, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"/>
                                    <Button l:Uids.Uid="Settings_Modes_CloudRefreshButton" Grid.Column="1" Command="{x:Bind ViewModel.UtilityPipelines.RefreshModelsCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}"
                                Visibility="{x:Bind ViewModel.UtilityPipelines.ShowPromptFields, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Spacing="4">
                                <TextBlock l:Uids.Uid="Settings_Modes_CloudPrompt_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                <TextBox Text="{x:Bind ViewModel.UtilityPipelines.CloudSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="150" MaxHeight="250"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── Local tab content ─────────────────────────────── -->
                    <StackPanel Spacing="16"
                                Visibility="{x:Bind ViewModel.UtilityPipelines.IsCloudTab, Mode=OneWay, Converter={StaticResource LocalInverseBoolToVis}}">

                        <Border Style="{StaticResource SettingsCardStyle}"
                                Visibility="{x:Bind ViewModel.UtilityPipelines.ShowPromptFields, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Spacing="4">
                                <TextBlock l:Uids.Uid="Settings_Modes_LocalPrompt_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                <TextBox Text="{x:Bind ViewModel.UtilityPipelines.LocalSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="150" MaxHeight="250"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>

                        <muxc:InfoBar l:Uids.Uid="Settings_Modes_OllamaInfoBar" IsOpen="True" IsClosable="False" Severity="Informational"/>
                    </StackPanel>

                    <!-- Notes fields -->
                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.UtilityPipelines.IsNoteSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock l:Uids.Uid="Settings_Modes_NoteFilePath_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{x:Bind ViewModel.UtilityPipelines.NoteFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button l:Uids.Uid="Settings_Modes_BrowseButton" Grid.Column="1" Command="{x:Bind ViewModel.UtilityPipelines.BrowseNoteFilePathCommand}"/>
                                    </Grid>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock l:Uids.Uid="Settings_Modes_LlmProcessing_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                        <TextBlock l:Uids.Uid="Settings_Modes_LlmProcessing_Description" FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.UtilityPipelines.NoteUseLlmProcessing, Mode=TwoWay}" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Spacing="4">
                                    <TextBlock l:Uids.Uid="Settings_Modes_TimestampFormat_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                    <TextBlock l:Uids.Uid="Settings_Modes_TimestampFormat_Description" FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                                    <TextBox Text="{x:Bind ViewModel.UtilityPipelines.NoteTimestampFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource AppFontMono}"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock l:Uids.Uid="Settings_Modes_LivePreview_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{StaticResource AppBorderBrush}"
                                            BorderThickness="1" Padding="12" CornerRadius="4">
                                        <TextBlock Text="{x:Bind ViewModel.UtilityPipelines.NotePreviewText, Mode=OneWay}"
                                                   FontFamily="{StaticResource AppFontMono}" FontSize="12" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Bottom: Reset + Save buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
                        <Button l:Uids.Uid="Settings_Modes_ResetToDefaults"
                                Command="{x:Bind ViewModel.UtilityPipelines.ResetCommand}"
                                Visibility="{x:Bind ViewModel.UtilityPipelines.CanReset, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                        <Button l:Uids.Uid="Settings_Modes_SaveButton" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.UtilityPipelines.SaveCommand}"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
