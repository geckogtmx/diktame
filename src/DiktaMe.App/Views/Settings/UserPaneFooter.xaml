<UserControl
    x:Class="DiktaMe.App.Views.Settings.UserPaneFooter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Button x:Name="UserButton" Click="UserButton_Click"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Background="Transparent"
            BorderThickness="0"
            Padding="12,8"
            Margin="4,4">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <!-- Signed-out: person outline icon -->
            <FontIcon x:Name="SignedOutIcon" Glyph="&#xE77B;"
                      FontSize="16" Visibility="Visible"/>

            <!-- Signed-in: avatar circle with initial + green status dot -->
            <Grid x:Name="AvatarContainer" Visibility="Collapsed">
                <Grid x:Name="AvatarCircle" Width="28" Height="28">
                    <!-- Fallback: colored circle with initial letter -->
                    <Ellipse x:Name="AvatarEllipse" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <TextBlock x:Name="AvatarInitial" Text=""
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <!-- Actual avatar image (hidden until URL is set) -->
                    <Ellipse x:Name="AvatarImage" Visibility="Collapsed">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="AvatarImageBrush" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
                <!-- Green online status dot -->
                <Ellipse x:Name="StatusDot"
                         Width="8" Height="8"
                         Fill="#22C55E"
                         Stroke="{StaticResource AppBackgroundBrush}"
                         StrokeThickness="2"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,0,0"/>
            </Grid>

            <!-- Text: display name + email (signed in) or "Sign in" (signed out) -->
            <StackPanel x:Name="TextPanel" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="DisplayNameText" Text=""
                           FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="140" Visibility="Collapsed"/>
                <TextBlock x:Name="UserText" Text="Sign in"
                           FontSize="10" Opacity="0.7"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="140"/>
            </StackPanel>
        </StackPanel>
    </Button>
</UserControl>
