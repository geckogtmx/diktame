<UserControl
    x:Class="DiktaMe.App.Views.Settings.UserPaneFooter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Button x:Name="UserButton" Click="UserButton_Click"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Background="Transparent"
            BorderThickness="0"
            Padding="12,8"
            Margin="4,4">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <!-- Signed-out: generic person outline -->
            <FontIcon x:Name="SignedOutIcon" Glyph="&#xE77B;" FontSize="16"
                      Visibility="Visible"/>

            <!-- Signed-in: colored avatar circle with initial -->
            <Grid x:Name="AvatarCircle" Width="24" Height="24"
                  Visibility="Collapsed">
                <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                <TextBlock x:Name="AvatarInitial" Text=""
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="UserText" Text="Sign in" FontSize="9"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       MaxWidth="120"/>
        </StackPanel>
    </Button>
</UserControl>
