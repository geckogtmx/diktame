<Page x:Class="DiktaMe.App.Views.Settings.HotkeysSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24,24,24,32">
        <StackPanel Spacing="24" MaxWidth="600">
            <TextBlock Text="Hotkeys" FontSize="24" FontWeight="SemiBold"/>

            <!-- Dictate -->
            <StackPanel Spacing="4">
                <TextBlock Text="Dictate" FontWeight="SemiBold"/>
                <TextBlock Text="Start voice dictation mode" FontSize="12" Opacity="0.6"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DictateBox"
                             Grid.Column="0"
                             Text="{x:Bind ViewModel.Dictate, Mode=TwoWay}"
                             IsReadOnly="True"
                             PlaceholderText="Click Record to set hotkey"
                             BorderThickness="2"
                             BorderBrush="{ThemeResource TextControlBorderBrush}"/>
                    <Button Grid.Column="1"
                            Content="Record"
                            Click="RecordDictate_Click"
                            MinWidth="80"/>
                    <Button Grid.Column="2"
                            Content="Reset"
                            Command="{x:Bind ViewModel.ResetDictateCommand}"
                            MinWidth="70"/>
                </Grid>
            </StackPanel>

            <!-- Refine -->
            <StackPanel Spacing="4">
                <TextBlock Text="Refine" FontWeight="SemiBold"/>
                <TextBlock Text="Start refine mode to improve selected text" FontSize="12" Opacity="0.6"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RefineBox"
                             Grid.Column="0"
                             Text="{x:Bind ViewModel.Refine, Mode=TwoWay}"
                             IsReadOnly="True"
                             PlaceholderText="Click Record to set hotkey"
                             BorderThickness="2"
                             BorderBrush="{ThemeResource TextControlBorderBrush}"/>
                    <Button Grid.Column="1"
                            Content="Record"
                            Click="RecordRefine_Click"
                            MinWidth="80"/>
                    <Button Grid.Column="2"
                            Content="Reset"
                            Command="{x:Bind ViewModel.ResetRefineCommand}"
                            MinWidth="70"/>
                </Grid>
            </StackPanel>

            <!-- Ask -->
            <StackPanel Spacing="4">
                <TextBlock Text="Ask" FontWeight="SemiBold"/>
                <TextBlock Text="Start ask mode to query AI about selected text" FontSize="12" Opacity="0.6"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AskBox"
                             Grid.Column="0"
                             Text="{x:Bind ViewModel.Ask, Mode=TwoWay}"
                             IsReadOnly="True"
                             PlaceholderText="Click Record to set hotkey"
                             BorderThickness="2"
                             BorderBrush="{ThemeResource TextControlBorderBrush}"/>
                    <Button Grid.Column="1"
                            Content="Record"
                            Click="RecordAsk_Click"
                            MinWidth="80"/>
                    <Button Grid.Column="2"
                            Content="Reset"
                            Command="{x:Bind ViewModel.ResetAskCommand}"
                            MinWidth="70"/>
                </Grid>
            </StackPanel>

            <!-- Translate -->
            <StackPanel Spacing="4">
                <TextBlock Text="Translate" FontWeight="SemiBold"/>
                <TextBlock Text="Translate selected text" FontSize="12" Opacity="0.6"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TranslateBox"
                             Grid.Column="0"
                             Text="{x:Bind ViewModel.Translate, Mode=TwoWay}"
                             IsReadOnly="True"
                             PlaceholderText="Click Record to set hotkey"
                             BorderThickness="2"
                             BorderBrush="{ThemeResource TextControlBorderBrush}"/>
                    <Button Grid.Column="1"
                            Content="Record"
                            Click="RecordTranslate_Click"
                            MinWidth="80"/>
                    <Button Grid.Column="2"
                            Content="Reset"
                            Command="{x:Bind ViewModel.ResetTranslateCommand}"
                            MinWidth="70"/>
                </Grid>
            </StackPanel>

            <!-- Oops -->
            <StackPanel Spacing="4">
                <TextBlock Text="Oops (Undo Last)" FontWeight="SemiBold"/>
                <TextBlock Text="Undo the last AI text injection" FontSize="12" Opacity="0.6"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OopsBox"
                             Grid.Column="0"
                             Text="{x:Bind ViewModel.Oops, Mode=TwoWay}"
                             IsReadOnly="True"
                             PlaceholderText="Click Record to set hotkey"
                             BorderThickness="2"
                             BorderBrush="{ThemeResource TextControlBorderBrush}"/>
                    <Button Grid.Column="1"
                            Content="Record"
                            Click="RecordOops_Click"
                            MinWidth="80"/>
                    <Button Grid.Column="2"
                            Content="Reset"
                            Command="{x:Bind ViewModel.ResetOopsCommand}"
                            MinWidth="70"/>
                </Grid>
            </StackPanel>

            <!-- Note -->
            <StackPanel Spacing="4">
                <TextBlock Text="Note" FontWeight="SemiBold"/>
                <TextBlock Text="Save voice note to file" FontSize="12" Opacity="0.6"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NoteBox"
                             Grid.Column="0"
                             Text="{x:Bind ViewModel.Note, Mode=TwoWay}"
                             IsReadOnly="True"
                             PlaceholderText="Click Record to set hotkey"
                             BorderThickness="2"
                             BorderBrush="{ThemeResource TextControlBorderBrush}"/>
                    <Button Grid.Column="1"
                            Content="Record"
                            Click="RecordNote_Click"
                            MinWidth="80"/>
                    <Button Grid.Column="2"
                            Content="Reset"
                            Command="{x:Bind ViewModel.ResetNoteCommand}"
                            MinWidth="70"/>
                </Grid>
            </StackPanel>

            <!-- Chat -->
            <StackPanel Spacing="4">
                <TextBlock Text="Chat" FontWeight="SemiBold"/>
                <TextBlock Text="Open Quick Chat overlay window" FontSize="12" Opacity="0.6"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ChatBox"
                             Grid.Column="0"
                             Text="{x:Bind ViewModel.Chat, Mode=TwoWay}"
                             IsReadOnly="True"
                             PlaceholderText="Click Record to set hotkey"
                             BorderThickness="2"
                             BorderBrush="{ThemeResource TextControlBorderBrush}"/>
                    <Button Grid.Column="1"
                            Content="Record"
                            Click="RecordChat_Click"
                            MinWidth="80"/>
                    <Button Grid.Column="2"
                            Content="Reset"
                            Command="{x:Bind ViewModel.ResetChatCommand}"
                            MinWidth="70"/>
                </Grid>
            </StackPanel>

            <!-- Info Box -->
            <InfoBar Severity="Informational"
                     IsOpen="True"
                     IsClosable="False"
                     Message="Click Record, then press your desired key combination. Changes save automatically. Restart required for new hotkeys to take effect."/>
        </StackPanel>
    </ScrollViewer>
</Page>
