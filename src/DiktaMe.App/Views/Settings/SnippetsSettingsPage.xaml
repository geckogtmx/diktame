<Page x:Class="DiktaMe.App.Views.Settings.SnippetsSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:config="using:DiktaMe.Core.Config"
      xmlns:converters="using:DiktaMe.App.Converters"
      xmlns:l="using:WinUI3Localizer"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock l:Uids.Uid="Settings_Snippets_Title" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                       FontSize="14" Opacity="0.5" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Snippet list -->
        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Snippets}"
                  SelectedItem="{x:Bind ViewModel.SelectedSnippet, Mode=TwoWay}"
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="config:Snippet">
                    <Grid Padding="4,6" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Trigger}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind Content}" Opacity="0.7"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button l:Uids.Uid="Settings_Snippets_AddButton" Command="{x:Bind ViewModel.AddSnippetCommand}"/>
            <Button l:Uids.Uid="Settings_Snippets_EditButton" Command="{x:Bind ViewModel.EditSelectedSnippetCommand}"/>
            <Button l:Uids.Uid="Settings_Snippets_DeleteButton" Command="{x:Bind ViewModel.DeleteSnippetCommand}"/>
        </StackPanel>

        <!-- Edit panel -->
        <Border Grid.Row="3"
                Visibility="{x:Bind ViewModel.IsEditing, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" Padding="16">
            <StackPanel Spacing="12" MaxWidth="500">
                <TextBox l:Uids.Uid="Settings_Snippets_TriggerInput"
                         Text="{x:Bind ViewModel.EditTrigger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox l:Uids.Uid="Settings_Snippets_ContentInput"
                         Text="{x:Bind ViewModel.EditContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button l:Uids.Uid="Settings_Snippets_SaveButton" Command="{x:Bind ViewModel.SaveSnippetCommand}"
                            Style="{ThemeResource AccentButtonStyle}"/>
                    <Button l:Uids.Uid="Settings_Snippets_CancelButton" Command="{x:Bind ViewModel.CancelEditCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
