<Page x:Class="DiktaMe.App.Views.Settings.SnippetsSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:config="using:DiktaMe.Core.Config"
      xmlns:converters="using:DiktaMe.App.Converters"
      xmlns:l="using:WinUI3Localizer"
      Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="32,24,32,32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Title + Count + Add button -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock l:Uids.Uid="Settings_Snippets_Title" FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                           FontSize="13" Foreground="{StaticResource AppTextDimBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.AddSnippetCommand}"
                    VerticalAlignment="Center" Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    <TextBlock l:Uids.Uid="Settings_Snippets_AddButton"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Snippet list -->
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Snippets}"
                  SelectedItem="{x:Bind ViewModel.SelectedSnippet, Mode=TwoWay}"
                  SelectionMode="Single"
                  ContainerContentChanging="ListView_ContainerContentChanging">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="config:Snippet">
                    <Border CornerRadius="6" Padding="16,12" MinHeight="52"
                            BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Trigger + Content -->
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <Border Background="{StaticResource AppNavActiveBrush}"
                                        CornerRadius="4" Padding="8,3"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{x:Bind Trigger}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource AppTextBrush}"/>
                                </Border>
                                <TextBlock Text="{x:Bind Content}" FontSize="12"
                                           Foreground="{StaticResource AppTextDimBrush}"
                                           TextTrimming="CharacterEllipsis" MaxLines="2"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Inline Edit + Delete buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                        VerticalAlignment="Center">
                                <Button ToolTipService.ToolTip="Edit" Tag="{Binding}"
                                        Click="EditButton_Click"
                                        Width="32" Height="32" Padding="0"
                                        Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE70F;" FontSize="14"
                                              Foreground="{StaticResource AppTextDimBrush}"/>
                                </Button>
                                <Button ToolTipService.ToolTip="Delete" Tag="{Binding}"
                                        Click="DeleteButton_Click"
                                        Width="32" Height="32" Padding="0"
                                        Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"
                                              Foreground="{StaticResource AppTextDimBrush}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Edit panel -->
        <Border Grid.Row="2"
                Visibility="{x:Bind ViewModel.IsEditing, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                Style="{StaticResource SettingsCardStyle}">
            <StackPanel Spacing="12" MaxWidth="500">
                <TextBlock Text="{x:Bind ViewModel.EditPanelTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"/>
                <TextBox l:Uids.Uid="Settings_Snippets_TriggerInput"
                         Text="{x:Bind ViewModel.EditTrigger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox l:Uids.Uid="Settings_Snippets_ContentInput"
                         Text="{x:Bind ViewModel.EditContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button l:Uids.Uid="Settings_Snippets_SaveButton" Command="{x:Bind ViewModel.SaveSnippetCommand}"
                            Style="{ThemeResource AccentButtonStyle}"/>
                    <Button l:Uids.Uid="Settings_Snippets_CancelButton" Command="{x:Bind ViewModel.CancelEditCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
