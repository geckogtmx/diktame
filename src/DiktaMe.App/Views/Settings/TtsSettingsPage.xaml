<Page x:Class="DiktaMe.App.Views.Settings.TtsSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:WinUI3Localizer"
      xmlns:converters="using:DiktaMe.App.Converters"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:BoolNegationConverter x:Key="BoolNeg"/>
    </Page.Resources>

    <ScrollViewer Padding="24,24,24,32">
        <StackPanel Spacing="24" MaxWidth="600">
            <TextBlock l:Uids.Uid="Settings_Tts_Title" FontSize="24" FontWeight="SemiBold"/>

            <!-- ═══ Provider Selection ═══ -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Tts_Provider_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_Tts_Provider_Description" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.ProviderLabels}"
                          SelectedIndex="{x:Bind ViewModel.SelectedProviderIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- ═══ Voice Selection ═══ -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Tts_Voice_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_Tts_Voice_Description" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.AvailableVoices, Mode=OneWay}"
                          SelectedIndex="{x:Bind ViewModel.SelectedVoiceIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- ═══ Speed Slider ═══ -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Tts_Speed_Label" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <TextBlock l:Uids.Uid="Settings_Tts_Speed_Prefix" FontSize="12" Opacity="0.6"/>
                    <TextBlock Text="{x:Bind ViewModel.Speed, Mode=OneWay}" FontSize="12" Opacity="0.6"/>
                    <TextBlock l:Uids.Uid="Settings_Tts_Speed_Suffix" FontSize="12" Opacity="0.6"/>
                </StackPanel>
                <Slider Minimum="0.5" Maximum="2.0" StepFrequency="0.1"
                        Value="{x:Bind ViewModel.Speed, Mode=TwoWay}"/>
            </StackPanel>

            <!-- ═══ Volume Slider ═══ -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Tts_Volume_Label" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <TextBlock l:Uids.Uid="Settings_Tts_Volume_Prefix" FontSize="12" Opacity="0.6"/>
                    <TextBlock Text="{x:Bind ViewModel.VolumePercent, Mode=OneWay}" FontSize="12" Opacity="0.6"/>
                    <TextBlock l:Uids.Uid="Settings_Tts_Volume_Suffix" FontSize="12" Opacity="0.6"/>
                </StackPanel>
                <Slider Minimum="0" Maximum="100" StepFrequency="5"
                        Value="{x:Bind ViewModel.VolumePercent, Mode=TwoWay}"/>
            </StackPanel>

            <!-- ═══ Max Words ═══ -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Tts_MaxWords_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_Tts_MaxWords_Description" FontSize="12" Opacity="0.6"/>
                <NumberBox Value="{x:Bind ViewModel.MaxSpeechWords, Mode=TwoWay}"
                           Minimum="0" Maximum="10000"
                           SpinButtonPlacementMode="Compact"
                           SmallChange="50" LargeChange="100"
                           HorizontalAlignment="Left" MinWidth="150"/>
            </StackPanel>

            <!-- ═══ Test Voice ═══ -->
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.TestVoiceCommand}"
                            IsEnabled="{x:Bind ViewModel.IsTestPlaying, Mode=OneWay, Converter={StaticResource BoolNeg}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="14"/>
                            <TextBlock l:Uids.Uid="Settings_Tts_TestVoice"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{x:Bind ViewModel.TestStatusText, Mode=OneWay}"
                               FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- ═══ When to Speak Section ═══ -->
            <TextBlock l:Uids.Uid="Settings_Tts_WhenToSpeak_Section"
                       FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/>

            <!-- Speak Ask Responses -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Tts_SpeakAsk_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_Tts_SpeakAsk_Description" FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.SpeakAskResponses, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Speak Chat Responses -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Tts_SpeakChat_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_Tts_SpeakChat_Description" FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.SpeakChatResponses, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Speak Translations -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Tts_SpeakTranslate_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_Tts_SpeakTranslate_Description" FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.SpeakTranslations, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Speak Notifications -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Tts_SpeakNotifications_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_Tts_SpeakNotifications_Description" FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.SpeakNotifications, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Duck Other Apps -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Tts_DuckOtherApps_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_Tts_DuckOtherApps_Description" FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.DuckDuringPlayback, Mode=TwoWay}"/>
            </StackPanel>

            <!-- ═══ Read Selection Hotkey (display only) ═══ -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Tts_ReadSelection_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_Tts_ReadSelection_Description" FontSize="12" Opacity="0.6"/>
                <TextBlock Text="{x:Bind ViewModel.ReadSelectionHotkey}" FontSize="14" FontWeight="Medium" Opacity="0.8"/>
            </StackPanel>

            <!-- ═══ Kokoro Model Section (visible only when Kokoro selected) ═══ -->
            <StackPanel Spacing="8"
                        Visibility="{x:Bind ViewModel.IsKokoroSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock l:Uids.Uid="Settings_Tts_Kokoro_Section"
                           FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/>

                <!-- Variant Selector -->
                <StackPanel Spacing="4">
                    <TextBlock l:Uids.Uid="Settings_Tts_Kokoro_Variant_Label" FontWeight="SemiBold"/>
                    <TextBlock l:Uids.Uid="Settings_Tts_Kokoro_Variant_Description" FontSize="12" Opacity="0.6"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.KokoroVariantLabels}"
                              SelectedIndex="{x:Bind ViewModel.SelectedKokoroVariantIndex, Mode=TwoWay}"
                              MinWidth="200"/>
                </StackPanel>

                <!-- Model Status + Download -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.DownloadStatusText, Mode=OneWay}"
                               FontSize="12" Opacity="0.7"/>

                    <!-- Download button (hidden when model already downloaded) -->
                    <Button Command="{x:Bind ViewModel.DownloadKokoroModelCommand}"
                            IsEnabled="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource BoolNeg}}"
                            Visibility="{x:Bind ViewModel.IsKokoroModelDownloaded, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="14"/>
                            <TextBlock l:Uids.Uid="Settings_Tts_Kokoro_Download"/>
                        </StackPanel>
                    </Button>

                    <!-- Download Progress Bar -->
                    <ProgressBar Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}"
                                 Maximum="100"
                                 Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
