<Page x:Class="DiktaMe.App.Views.Settings.GeneralSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:WinUI3Localizer"
      Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid ColumnSpacing="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Sub-item list -->
        <Border Background="{StaticResource AppSurfaceTranslucentBrush}"
                Padding="24">
            <StackPanel Spacing="8">
                <TextBlock l:Uids.Uid="Settings_General_Title" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"
                           Foreground="{StaticResource AppTextBrush}"/>
                <ListView ItemsSource="{x:Bind ViewModel.SubItems}"
                          SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.Resources>
                        <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="SubNavItemBackgroundSelected"/>
                        <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="SubNavItemBackgroundSelected"/>
                        <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="SubNavItemBackgroundSelected"/>
                        <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="SubNavItemForegroundSelected"/>
                    </ListView.Resources>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="4,6">
                                <TextBlock Text="{Binding Title}" FontSize="14"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <!-- Right: Detail pane -->
        <ScrollViewer Grid.Column="1" Padding="24,24,16,32">
            <Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 Application
                 ═══════════════════════════════════════════════════════════════ -->
            <StackPanel Spacing="16" MaxWidth="600"
                        Visibility="{x:Bind ViewModel.IsApplicationSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Application" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"/>

                <!-- Theme Selector -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Theme" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextBrush}"/>
                        <TextBlock Text="Choose the color palette for the app." FontSize="12"
                                   Foreground="{StaticResource AppTextDimBrush}"/>
                        <ComboBox ItemsSource="{x:Bind ViewModel.ThemeNames}"
                                  SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- Auto-start -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock l:Uids.Uid="Settings_General_AutoStart_Label" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                            <TextBlock l:Uids.Uid="Settings_General_AutoStart_Description" FontSize="12"
                                       Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AutoStart, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════════════
                 Control Panel
                 ═══════════════════════════════════════════════════════════════ -->
            <StackPanel Spacing="16" MaxWidth="600"
                        Visibility="{x:Bind ViewModel.IsControlPanelSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock l:Uids.Uid="Settings_ControlPanel_Title" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"/>
                <TextBlock l:Uids.Uid="Settings_ControlPanel_Description" FontSize="13"
                           Foreground="{StaticResource AppTextDimBrush}"/>

                <!-- ── General: Rows & Stats ─────────────────────────────── -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock l:Uids.Uid="Settings_ControlPanel_ShowModesRow_Label" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                <TextBlock l:Uids.Uid="Settings_ControlPanel_ShowModesRow_Description" FontSize="12"
                                           Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ShowModesRow, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock l:Uids.Uid="Settings_ControlPanel_ShowActionsRow_Label" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                <TextBlock l:Uids.Uid="Settings_ControlPanel_ShowActionsRow_Description" FontSize="12"
                                           Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ShowActionsRow, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock l:Uids.Uid="Settings_ControlPanel_ShowSessionStats_Label" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                <TextBlock l:Uids.Uid="Settings_ControlPanel_ShowSessionStats_Description" FontSize="12"
                                           Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ShowSessionStats, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock l:Uids.Uid="Settings_ControlPanel_ShowPerformanceStats_Label" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                <TextBlock l:Uids.Uid="Settings_ControlPanel_ShowPerformanceStats_Description" FontSize="12"
                                           Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ShowPerformanceStats, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Bar: Position, Layout & Behavior ──────────────────── -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock l:Uids.Uid="Settings_ControlPanel_AlwaysOnTop_Label" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                <TextBlock l:Uids.Uid="Settings_ControlPanel_AlwaysOnTop_Description" FontSize="12"
                                           Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AlwaysOnTop, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_ControlPanel_ExpandDirection_Label" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextBrush}"/>
                            <TextBlock l:Uids.Uid="Settings_ControlPanel_ExpandDirection_Description" FontSize="12"
                                       Foreground="{StaticResource AppTextDimBrush}"/>
                            <RadioButtons SelectedIndex="{x:Bind ViewModel.ExpandDirectionIndex, Mode=TwoWay}">
                                <RadioButton l:Uids.Uid="Settings_ControlPanel_ExpandDirection_Down"/>
                                <RadioButton l:Uids.Uid="Settings_ControlPanel_ExpandDirection_Up"/>
                            </RadioButtons>
                        </StackPanel>

                        <!-- Bar Position -->
                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_ControlPanel_BarPosition_Label" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextBrush}"/>
                            <TextBlock l:Uids.Uid="Settings_ControlPanel_BarPosition_Description" FontSize="12"
                                       Foreground="{StaticResource AppTextDimBrush}"/>
                            <Grid ColumnSpacing="4" RowSpacing="4" Margin="0,4,0,0" MaxWidth="320" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" Padding="8,6"
                                        l:Uids.Uid="Settings_ControlPanel_BarPosition_TopLeft"
                                        Command="{x:Bind ViewModel.SetBarPositionCommand}" CommandParameter="TopLeft"/>
                                <Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Padding="8,6"
                                        l:Uids.Uid="Settings_ControlPanel_BarPosition_TopCenter"
                                        Command="{x:Bind ViewModel.SetBarPositionCommand}" CommandParameter="TopCenter"/>
                                <Button Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" Padding="8,6"
                                        l:Uids.Uid="Settings_ControlPanel_BarPosition_TopRight"
                                        Command="{x:Bind ViewModel.SetBarPositionCommand}" CommandParameter="TopRight"/>
                                <Button Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" Padding="8,6"
                                        l:Uids.Uid="Settings_ControlPanel_BarPosition_BottomLeft"
                                        Command="{x:Bind ViewModel.SetBarPositionCommand}" CommandParameter="BottomLeft"/>
                                <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Padding="8,6"
                                        l:Uids.Uid="Settings_ControlPanel_BarPosition_BottomCenter"
                                        Command="{x:Bind ViewModel.SetBarPositionCommand}" CommandParameter="BottomCenter"/>
                                <Button Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" Padding="8,6"
                                        l:Uids.Uid="Settings_ControlPanel_BarPosition_BottomRight"
                                        Command="{x:Bind ViewModel.SetBarPositionCommand}" CommandParameter="BottomRight"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Visual Effects -->
                <TextBlock l:Uids.Uid="Settings_VisualEffects_Title" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"
                           Foreground="{StaticResource AppTextBrush}"/>
                <TextBlock l:Uids.Uid="Settings_VisualEffects_Description" FontSize="13"
                           Foreground="{StaticResource AppTextDimBrush}"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock l:Uids.Uid="Settings_VisualEffects_Enable_Label" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                <TextBlock l:Uids.Uid="Settings_VisualEffects_Enable_Description" FontSize="12"
                                           Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.VisualEffectsEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Spacing="4"
                                    Visibility="{x:Bind ViewModel.VisualEffectsEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock l:Uids.Uid="Settings_VisualEffects_Scope_Label" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextBrush}"/>
                            <TextBlock l:Uids.Uid="Settings_VisualEffects_Scope_Description" FontSize="12"
                                       Foreground="{StaticResource AppTextDimBrush}"/>
                            <RadioButtons SelectedIndex="{x:Bind ViewModel.VisualEffectsScopeIndex, Mode=TwoWay}">
                                <RadioButton l:Uids.Uid="Settings_VisualEffects_Scope_WholeApp"/>
                                <RadioButton l:Uids.Uid="Settings_VisualEffects_Scope_TopBarOnly"/>
                            </RadioButtons>
                        </StackPanel>

                        <StackPanel Spacing="4"
                                    Visibility="{x:Bind ViewModel.VisualEffectsEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock l:Uids.Uid="Settings_VisualEffects_Intensity_Label" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextBrush}"/>
                            <TextBlock l:Uids.Uid="Settings_VisualEffects_Intensity_Description" FontSize="12"
                                       Foreground="{StaticResource AppTextDimBrush}"/>
                            <Slider Minimum="0" Maximum="100"
                                    Value="{x:Bind ViewModel.VisualEffectsIntensityPercent, Mode=TwoWay}"
                                    StepFrequency="5" TickFrequency="25" TickPlacement="BottomRight"/>
                        </StackPanel>

                        <StackPanel Spacing="4"
                                    Visibility="{x:Bind ViewModel.VisualEffectsEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock l:Uids.Uid="Settings_Waveform_Style_Label" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextBrush}"/>
                            <TextBlock l:Uids.Uid="Settings_Waveform_Style_Description" FontSize="12"
                                       Foreground="{StaticResource AppTextDimBrush}"/>
                            <RadioButtons SelectedIndex="{x:Bind ViewModel.WaveformStyleIndex, Mode=TwoWay}">
                                <RadioButton l:Uids.Uid="Settings_Waveform_Style_Wave"/>
                                <RadioButton l:Uids.Uid="Settings_Waveform_Style_Bars"/>
                                <RadioButton l:Uids.Uid="Settings_Waveform_Style_Off"/>
                            </RadioButtons>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Idle Roller -->
                <TextBlock l:Uids.Uid="Settings_IdleRoller_Title" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"
                           Foreground="{StaticResource AppTextBrush}"/>
                <TextBlock l:Uids.Uid="Settings_IdleRoller_Description" FontSize="13"
                           Foreground="{StaticResource AppTextDimBrush}"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="16">
                        <!-- Master toggle -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock l:Uids.Uid="Settings_IdleRoll_Enable_Label" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                <TextBlock l:Uids.Uid="Settings_IdleRoll_Enable_Description" FontSize="12"
                                           Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IdleRollEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Sub-options (visible when enabled) -->
                        <StackPanel Spacing="12"
                                    Visibility="{x:Bind ViewModel.IdleRollEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <CheckBox IsChecked="{x:Bind ViewModel.IdleRollShowClock, Mode=TwoWay}"
                                      Foreground="{StaticResource AppTextBrush}">
                                <TextBlock l:Uids.Uid="Settings_IdleRoll_ShowClock_Label"
                                           Foreground="{StaticResource AppTextBrush}"/>
                            </CheckBox>
                            <CheckBox IsChecked="{x:Bind ViewModel.IdleRollShowWeather, Mode=TwoWay}"
                                      Foreground="{StaticResource AppTextBrush}">
                                <TextBlock l:Uids.Uid="Settings_IdleRoll_ShowWeather_Label"
                                           Foreground="{StaticResource AppTextBrush}"/>
                            </CheckBox>

                            <!-- Clock format dropdown (visible when clock enabled) -->
                            <StackPanel Spacing="4"
                                        Visibility="{x:Bind ViewModel.IdleRollShowClock, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock l:Uids.Uid="Settings_IdleRoll_ClockFormat_Label" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextBrush}"/>
                                <ComboBox ItemsSource="{x:Bind ViewModel.ClockFormatLabels}"
                                          SelectedIndex="{x:Bind ViewModel.IdleRollClockFormatIndex, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <!-- Hold duration slider -->
                            <StackPanel Spacing="4">
                                <TextBlock l:Uids.Uid="Settings_IdleRoll_HoldDuration_Label" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextBrush}"/>
                                <TextBlock l:Uids.Uid="Settings_IdleRoll_HoldDuration_Description" FontSize="12"
                                           Foreground="{StaticResource AppTextDimBrush}"/>
                                <Slider Minimum="5" Maximum="20"
                                        Value="{x:Bind ViewModel.IdleRollHoldSeconds, Mode=TwoWay}"
                                        StepFrequency="1" TickFrequency="5" TickPlacement="BottomRight"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Auto-Collapse -->
                <TextBlock l:Uids.Uid="Settings_AutoCollapse_Title" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"
                           Foreground="{StaticResource AppTextBrush}"/>
                <TextBlock l:Uids.Uid="Settings_AutoCollapse_Description" FontSize="13"
                           Foreground="{StaticResource AppTextDimBrush}"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock l:Uids.Uid="Settings_AutoCollapse_Enable_Label" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                <TextBlock l:Uids.Uid="Settings_AutoCollapse_Enable_Description" FontSize="12"
                                           Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AutoCollapseEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Spacing="4"
                                    Visibility="{x:Bind ViewModel.AutoCollapseEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock l:Uids.Uid="Settings_AutoCollapse_Delay_Label" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextBrush}"/>
                            <TextBlock l:Uids.Uid="Settings_AutoCollapse_Delay_Description" FontSize="12"
                                       Foreground="{StaticResource AppTextDimBrush}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.AutoCollapseDelayLabels}"
                                      SelectedIndex="{x:Bind ViewModel.AutoCollapseDelayIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Auto-Hide -->
                <TextBlock l:Uids.Uid="Settings_AutoHide_Title" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"
                           Foreground="{StaticResource AppTextBrush}"/>
                <TextBlock l:Uids.Uid="Settings_AutoHide_Description" FontSize="13"
                           Foreground="{StaticResource AppTextDimBrush}"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock l:Uids.Uid="Settings_AutoHide_Enable_Label" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                                <TextBlock l:Uids.Uid="Settings_AutoHide_Enable_Description" FontSize="12"
                                           Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AutoHideEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Spacing="4"
                                    Visibility="{x:Bind ViewModel.AutoHideEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock l:Uids.Uid="Settings_AutoHide_Delay_Label" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextBrush}"/>
                            <TextBlock l:Uids.Uid="Settings_AutoHide_Delay_Description" FontSize="12"
                                       Foreground="{StaticResource AppTextDimBrush}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.AutoHideDelayLabels}"
                                      SelectedIndex="{x:Bind ViewModel.AutoHideDelayIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════════════
                 Keyboard Shortcuts
                 ═══════════════════════════════════════════════════════════════ -->
            <StackPanel Spacing="16" MaxWidth="600"
                        Visibility="{x:Bind ViewModel.IsHotkeysSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Keyboard Shortcuts" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="20">
                        <!-- Dictate -->
                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Hotkeys_Dictate_Label" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextBrush}"/>
                            <TextBlock l:Uids.Uid="Settings_Hotkeys_Dictate_Description" FontSize="12"
                                       Foreground="{StaticResource AppTextDimBrush}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DictateBox" Grid.Column="0"
                                         Text="{x:Bind ViewModel.Hotkeys.Dictate, Mode=TwoWay}"
                                         IsReadOnly="True" PlaceholderText="Click Record to set hotkey"
                                         BorderThickness="2" BorderBrush="{ThemeResource TextControlBorderBrush}"/>
                                <Button Grid.Column="1" Content="Record" Click="RecordDictate_Click" MinWidth="80"/>
                                <Button Grid.Column="2" Content="Reset" Command="{x:Bind ViewModel.Hotkeys.ResetDictateCommand}" MinWidth="70"/>
                            </Grid>
                        </StackPanel>

                        <!-- Refine -->
                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Hotkeys_Refine_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                            <TextBlock l:Uids.Uid="Settings_Hotkeys_Refine_Description" FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RefineBox" Grid.Column="0"
                                         Text="{x:Bind ViewModel.Hotkeys.Refine, Mode=TwoWay}"
                                         IsReadOnly="True" PlaceholderText="Click Record to set hotkey"
                                         BorderThickness="2" BorderBrush="{ThemeResource TextControlBorderBrush}"/>
                                <Button Grid.Column="1" Content="Record" Click="RecordRefine_Click" MinWidth="80"/>
                                <Button Grid.Column="2" Content="Reset" Command="{x:Bind ViewModel.Hotkeys.ResetRefineCommand}" MinWidth="70"/>
                            </Grid>
                        </StackPanel>

                        <!-- Ask -->
                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Hotkeys_Ask_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                            <TextBlock l:Uids.Uid="Settings_Hotkeys_Ask_Description" FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AskBox" Grid.Column="0"
                                         Text="{x:Bind ViewModel.Hotkeys.Ask, Mode=TwoWay}"
                                         IsReadOnly="True" PlaceholderText="Click Record to set hotkey"
                                         BorderThickness="2" BorderBrush="{ThemeResource TextControlBorderBrush}"/>
                                <Button Grid.Column="1" Content="Record" Click="RecordAsk_Click" MinWidth="80"/>
                                <Button Grid.Column="2" Content="Reset" Command="{x:Bind ViewModel.Hotkeys.ResetAskCommand}" MinWidth="70"/>
                            </Grid>
                        </StackPanel>

                        <!-- Translate -->
                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Hotkeys_Translate_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                            <TextBlock l:Uids.Uid="Settings_Hotkeys_Translate_Description" FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TranslateBox" Grid.Column="0"
                                         Text="{x:Bind ViewModel.Hotkeys.Translate, Mode=TwoWay}"
                                         IsReadOnly="True" PlaceholderText="Click Record to set hotkey"
                                         BorderThickness="2" BorderBrush="{ThemeResource TextControlBorderBrush}"/>
                                <Button Grid.Column="1" Content="Record" Click="RecordTranslate_Click" MinWidth="80"/>
                                <Button Grid.Column="2" Content="Reset" Command="{x:Bind ViewModel.Hotkeys.ResetTranslateCommand}" MinWidth="70"/>
                            </Grid>
                        </StackPanel>

                        <!-- Oops -->
                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Hotkeys_Oops_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                            <TextBlock l:Uids.Uid="Settings_Hotkeys_Oops_Description" FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OopsBox" Grid.Column="0"
                                         Text="{x:Bind ViewModel.Hotkeys.Oops, Mode=TwoWay}"
                                         IsReadOnly="True" PlaceholderText="Click Record to set hotkey"
                                         BorderThickness="2" BorderBrush="{ThemeResource TextControlBorderBrush}"/>
                                <Button Grid.Column="1" Content="Record" Click="RecordOops_Click" MinWidth="80"/>
                                <Button Grid.Column="2" Content="Reset" Command="{x:Bind ViewModel.Hotkeys.ResetOopsCommand}" MinWidth="70"/>
                            </Grid>
                        </StackPanel>

                        <!-- Note -->
                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Hotkeys_Note_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                            <TextBlock l:Uids.Uid="Settings_Hotkeys_Note_Description" FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NoteBox" Grid.Column="0"
                                         Text="{x:Bind ViewModel.Hotkeys.Note, Mode=TwoWay}"
                                         IsReadOnly="True" PlaceholderText="Click Record to set hotkey"
                                         BorderThickness="2" BorderBrush="{ThemeResource TextControlBorderBrush}"/>
                                <Button Grid.Column="1" Content="Record" Click="RecordNote_Click" MinWidth="80"/>
                                <Button Grid.Column="2" Content="Reset" Command="{x:Bind ViewModel.Hotkeys.ResetNoteCommand}" MinWidth="70"/>
                            </Grid>
                        </StackPanel>

                        <!-- Chat -->
                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Hotkeys_Chat_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                            <TextBlock l:Uids.Uid="Settings_Hotkeys_Chat_Description" FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ChatBox" Grid.Column="0"
                                         Text="{x:Bind ViewModel.Hotkeys.Chat, Mode=TwoWay}"
                                         IsReadOnly="True" PlaceholderText="Click Record to set hotkey"
                                         BorderThickness="2" BorderBrush="{ThemeResource TextControlBorderBrush}"/>
                                <Button Grid.Column="1" Content="Record" Click="RecordChat_Click" MinWidth="80"/>
                                <Button Grid.Column="2" Content="Reset" Command="{x:Bind ViewModel.Hotkeys.ResetChatCommand}" MinWidth="70"/>
                            </Grid>
                        </StackPanel>

                        <!-- Read Selection -->
                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="Settings_Hotkeys_ReadSelection_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                            <TextBlock l:Uids.Uid="Settings_Hotkeys_ReadSelection_Description" FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ReadSelectionBox" Grid.Column="0"
                                         Text="{x:Bind ViewModel.Hotkeys.ReadSelection, Mode=TwoWay}"
                                         IsReadOnly="True" PlaceholderText="Click Record to set hotkey"
                                         BorderThickness="2" BorderBrush="{ThemeResource TextControlBorderBrush}"/>
                                <Button Grid.Column="1" Content="Record" Click="RecordReadSelection_Click" MinWidth="80"/>
                                <Button Grid.Column="2" Content="Reset" Command="{x:Bind ViewModel.Hotkeys.ResetReadSelectionCommand}" MinWidth="70"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <InfoBar l:Uids.Uid="Settings_Hotkeys_InfoBar" Severity="Informational"
                         IsOpen="True"
                         IsClosable="False"/>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════════════
                 Language
                 ═══════════════════════════════════════════════════════════════ -->
            <StackPanel Spacing="16" MaxWidth="600"
                        Visibility="{x:Bind ViewModel.IsLanguageSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Language" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"/>

                <!-- UI Language (requires restart) -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock l:Uids.Uid="Settings_General_UiLanguage_Label" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextBrush}"/>
                        <TextBlock l:Uids.Uid="Settings_General_UiLanguage_Description" FontSize="12"
                                   Foreground="{StaticResource AppTextDimBrush}"/>
                        <ComboBox ItemsSource="{x:Bind ViewModel.UiLanguages}"
                                  SelectedIndex="{x:Bind ViewModel.SelectedUiLanguageIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                        <InfoBar l:Uids.Uid="Settings_General_RestartInfoBar"
                                 Severity="Informational"
                                 IsOpen="{x:Bind ViewModel.ShowRestartWarning, Mode=OneWay}"
                                 IsClosable="False"
                                 Margin="0,4,0,0">
                            <InfoBar.ActionButton>
                                <Button l:Uids.Uid="Settings_General_RestartButton"
                                        Command="{x:Bind ViewModel.RestartAppCommand}"/>
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </StackPanel>
                </Border>

                <!-- Transcription Language -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock l:Uids.Uid="Settings_General_Language_Label" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextBrush}"/>
                        <TextBlock l:Uids.Uid="Settings_General_Language_Description" FontSize="12"
                                   Foreground="{StaticResource AppTextDimBrush}"/>
                        <ComboBox ItemsSource="{x:Bind ViewModel.Languages}"
                                  SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
