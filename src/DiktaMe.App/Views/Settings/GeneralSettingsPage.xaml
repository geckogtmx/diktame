<Page x:Class="DiktaMe.App.Views.Settings.GeneralSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:WinUI3Localizer"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24,24,24,32">
        <StackPanel Spacing="24" MaxWidth="600">
            <TextBlock l:Uids.Uid="Settings_General_Title" FontSize="24" FontWeight="SemiBold"/>

            <!-- UI Language (requires restart) -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_General_UiLanguage_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_General_UiLanguage_Description" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.UiLanguages}"
                          SelectedIndex="{x:Bind ViewModel.SelectedUiLanguageIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"/>
                <InfoBar l:Uids.Uid="Settings_General_RestartInfoBar"
                         Severity="Informational"
                         IsOpen="{x:Bind ViewModel.ShowRestartWarning, Mode=OneWay}"
                         IsClosable="False"
                         Margin="0,4,0,0">
                    <InfoBar.ActionButton>
                        <Button l:Uids.Uid="Settings_General_RestartButton"
                                Command="{x:Bind ViewModel.RestartAppCommand}"/>
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <!-- Transcription Language -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_General_Language_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_General_Language_Description" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.Languages}"
                          SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Auto-start -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_General_AutoStart_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_General_AutoStart_Description" FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.AutoStart, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Sound Feedback -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_General_SoundFeedback_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_General_SoundFeedback_Description" FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.SoundFeedback, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Additional Key -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_General_AdditionalKey_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_General_AdditionalKey_Description" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.AdditionalKeyOptions}"
                          SelectedIndex="{x:Bind ViewModel.SelectedAdditionalKeyIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Trailing Space -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_General_TrailingSpace_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_General_TrailingSpace_Description" FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.TrailingSpace, Mode=TwoWay}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
