<Page x:Class="DiktaMe.App.Views.Settings.PrivacySettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:WinUI3Localizer"
      Background="Transparent">

    <ScrollViewer Padding="24,24,24,32">
        <StackPanel Spacing="16" MaxWidth="600">
            <TextBlock l:Uids.Uid="Settings_Privacy_Title" FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource AppTextBrush}"/>

            <!-- Logging Intensity -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock l:Uids.Uid="Settings_Privacy_LoggingIntensity_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.PrivacyLevelLabel, Mode=OneWay}" FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                    <Slider Minimum="0" Maximum="3" StepFrequency="1"
                            SnapsTo="StepValues"
                            Value="{x:Bind ViewModel.PrivacyLevel, Mode=TwoWay}"/>
                    <Grid>
                        <TextBlock l:Uids.Uid="Settings_Privacy_Slider_Ghost" FontSize="11" Opacity="0.4" HorizontalAlignment="Left"/>
                        <TextBlock l:Uids.Uid="Settings_Privacy_Slider_Full" FontSize="11" Opacity="0.4" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- PII Scrubber -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock l:Uids.Uid="Settings_Privacy_PiiScrubber_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" TextWrapping="Wrap"/>
                        <TextBlock l:Uids.Uid="Settings_Privacy_PiiScrubber_Description" FontSize="12" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.PiiScrubEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- History Retention -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock l:Uids.Uid="Settings_Privacy_HistoryRetention_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                    <TextBlock l:Uids.Uid="Settings_Privacy_HistoryRetention_Description" FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                    <NumberBox Value="{x:Bind ViewModel.HistoryRetentionDays, Mode=TwoWay}"
                               Minimum="1" Maximum="365" SpinButtonPlacementMode="Compact"
                               HorizontalAlignment="Left" MinWidth="180"/>
                </StackPanel>
            </Border>

            <!-- Wipe Data -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock l:Uids.Uid="Settings_Privacy_DataManagement_Label" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                    <TextBlock l:Uids.Uid="Settings_Privacy_DataManagement_Description" FontSize="12" Foreground="{StaticResource AppTextDimBrush}"/>
                    <Button l:Uids.Uid="Settings_Privacy_WipeAllData"
                            Command="{x:Bind ViewModel.WipeAllDataCommand}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Background="#DC2626"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
