<Page x:Class="DiktaMe.App.Views.Settings.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:WinUI3Localizer"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24,24,24,32">
        <StackPanel Spacing="24" MaxWidth="600">
            <TextBlock l:Uids.Uid="Settings_About_Title" FontSize="24" FontWeight="SemiBold"/>

            <Image Source="ms-appx:///Assets/loading-logo.png"
                   Width="120" Height="120" HorizontalAlignment="Center"/>

            <TextBlock Text="dIKta.me" FontSize="36" FontWeight="Bold"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

            <TextBlock l:Uids.Uid="Settings_About_Version" FontSize="16" Opacity="0.7"/>

            <TextBlock l:Uids.Uid="Settings_About_Description" TextWrapping="Wrap" FontSize="13" Opacity="0.8"/>

            <StackPanel Spacing="8" Margin="0,16,0,0">
                <TextBlock l:Uids.Uid="Settings_About_TechStack_Title" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_About_TechStack_WinUI" FontSize="13" Opacity="0.7"/>
                <TextBlock l:Uids.Uid="Settings_About_TechStack_DotNet" FontSize="13" Opacity="0.7"/>
                <TextBlock l:Uids.Uid="Settings_About_TechStack_NAudio" FontSize="13" Opacity="0.7"/>
                <TextBlock l:Uids.Uid="Settings_About_TechStack_SQLite" FontSize="13" Opacity="0.7"/>
                <TextBlock l:Uids.Uid="Settings_About_TechStack_DPAPI" FontSize="13" Opacity="0.7"/>
            </StackPanel>

            <HyperlinkButton Content="dikta.me" NavigateUri="https://dikta.me" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
