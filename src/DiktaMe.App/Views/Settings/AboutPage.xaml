<Page x:Class="DiktaMe.App.Views.Settings.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:WinUI3Localizer"
      Background="Transparent">

    <ScrollViewer Padding="24,24,24,32">
        <StackPanel Spacing="16" MaxWidth="600">

            <TextBlock l:Uids.Uid="Settings_About_Title" FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource AppTextBrush}"/>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <Image Source="ms-appx:///Assets/loading-logo.png"
                           Width="120" Height="120" HorizontalAlignment="Center"/>

                    <TextBlock Text="dIKta.me" FontSize="36" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource AppAccentBrush}"/>

                    <TextBlock l:Uids.Uid="Settings_About_Version" FontSize="16"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource AppTextDimBrush}"/>

                    <TextBlock Text="UI DEBUG BUILD [v20]" FontSize="11"
                               HorizontalAlignment="Center"
                               Foreground="Red" FontWeight="Bold"/>

                    <TextBlock l:Uids.Uid="Settings_About_Description" TextWrapping="Wrap" FontSize="13"
                               Foreground="{StaticResource AppTextDimBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock l:Uids.Uid="Settings_About_TechStack_Title" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                    <TextBlock l:Uids.Uid="Settings_About_TechStack_WinUI" FontSize="13" Foreground="{StaticResource AppTextDimBrush}"/>
                    <TextBlock l:Uids.Uid="Settings_About_TechStack_DotNet" FontSize="13" Foreground="{StaticResource AppTextDimBrush}"/>
                    <TextBlock l:Uids.Uid="Settings_About_TechStack_NAudio" FontSize="13" Foreground="{StaticResource AppTextDimBrush}"/>
                    <TextBlock l:Uids.Uid="Settings_About_TechStack_SQLite" FontSize="13" Foreground="{StaticResource AppTextDimBrush}"/>
                    <TextBlock l:Uids.Uid="Settings_About_TechStack_DPAPI" FontSize="13" Foreground="{StaticResource AppTextDimBrush}"/>
                </StackPanel>
            </Border>

            <HyperlinkButton Content="dikta.me" NavigateUri="https://dikta.me"/>
        </StackPanel>
    </ScrollViewer>
</Page>
