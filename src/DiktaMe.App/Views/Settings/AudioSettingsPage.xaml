<Page x:Class="DiktaMe.App.Views.Settings.AudioSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24,24,24,32">
        <StackPanel Spacing="24" MaxWidth="600">
            <TextBlock Text="Audio" FontSize="24" FontWeight="SemiBold"/>

            <!-- Input Device -->
            <StackPanel Spacing="4">
                <TextBlock Text="Recording Device" FontWeight="SemiBold"/>
                <TextBlock Text="Microphone used for voice input" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.Devices}"
                          SelectedIndex="{x:Bind ViewModel.SelectedDeviceIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Max Recording Duration -->
            <StackPanel Spacing="4">
                <TextBlock Text="Maximum Recording Duration" FontWeight="SemiBold"/>
                <TextBlock Text="Auto-stop recording after this duration" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.DurationLabels}"
                          SelectedIndex="{x:Bind ViewModel.SelectedDurationIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Audio Ducking -->
            <StackPanel Spacing="4">
                <TextBlock Text="Audio Ducking" FontWeight="SemiBold"/>
                <TextBlock Text="Lower other app volumes while recording" FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.DuckingEnabled, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Duck Level Slider -->
            <StackPanel Spacing="4">
                <TextBlock Text="Duck Level" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <TextBlock Text="Other apps reduced to " FontSize="12" Opacity="0.6"/>
                    <TextBlock Text="{x:Bind ViewModel.DuckLevelPercent, Mode=OneWay}" FontSize="12" Opacity="0.6"/>
                    <TextBlock Text="% volume" FontSize="12" Opacity="0.6"/>
                </StackPanel>
                <Slider Minimum="0" Maximum="100" StepFrequency="5"
                        Value="{x:Bind ViewModel.DuckLevelPercent, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.DuckingEnabled, Mode=OneWay}"/>
            </StackPanel>

            <!-- Sound Feedback Section -->
            <TextBlock Text="Sound Feedback" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/>

            <StackPanel Spacing="4">
                <TextBlock Text="Enable Sounds" FontWeight="SemiBold"/>
                <TextBlock Text="Play audio cues when recording starts and stops" FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.SoundEnabled, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Dictate Start Sound -->
            <StackPanel Spacing="4">
                <TextBlock Text="Dictate Start Sound" FontWeight="SemiBold"/>
                <TextBlock Text="Played when dictation recording begins" FontSize="12" Opacity="0.6"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableSounds}"
                              SelectedIndex="{x:Bind ViewModel.SelectedStartSoundIndex, Mode=TwoWay}"
                              MinWidth="120"
                              IsEnabled="{x:Bind ViewModel.SoundEnabled, Mode=OneWay}"/>
                    <Button Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                            Command="{x:Bind ViewModel.PreviewStartSoundCommand}"
                            IsEnabled="{x:Bind ViewModel.SoundEnabled, Mode=OneWay}"
                            ToolTipService.ToolTip="Preview"/>
                </StackPanel>
            </StackPanel>

            <!-- Dictate Stop Sound -->
            <StackPanel Spacing="4">
                <TextBlock Text="Dictate Stop Sound" FontWeight="SemiBold"/>
                <TextBlock Text="Played when dictation recording stops" FontSize="12" Opacity="0.6"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableSounds}"
                              SelectedIndex="{x:Bind ViewModel.SelectedStopSoundIndex, Mode=TwoWay}"
                              MinWidth="120"
                              IsEnabled="{x:Bind ViewModel.SoundEnabled, Mode=OneWay}"/>
                    <Button Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                            Command="{x:Bind ViewModel.PreviewStopSoundCommand}"
                            IsEnabled="{x:Bind ViewModel.SoundEnabled, Mode=OneWay}"
                            ToolTipService.ToolTip="Preview"/>
                </StackPanel>
            </StackPanel>

            <!-- Utility Sound -->
            <StackPanel Spacing="4">
                <TextBlock Text="Utility Sound" FontWeight="SemiBold"/>
                <TextBlock Text="Played for Ask, Refine, Translate, and Note pipelines" FontSize="12" Opacity="0.6"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableSounds}"
                              SelectedIndex="{x:Bind ViewModel.SelectedUtilitySoundIndex, Mode=TwoWay}"
                              MinWidth="120"
                              IsEnabled="{x:Bind ViewModel.SoundEnabled, Mode=OneWay}"/>
                    <Button Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                            Command="{x:Bind ViewModel.PreviewUtilitySoundCommand}"
                            IsEnabled="{x:Bind ViewModel.SoundEnabled, Mode=OneWay}"
                            ToolTipService.ToolTip="Preview"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
