<Page x:Class="DiktaMe.App.Views.Settings.AudioSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:WinUI3Localizer"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24,24,24,32">
        <StackPanel Spacing="24" MaxWidth="600">
            <TextBlock l:Uids.Uid="Settings_Audio_Title" FontSize="24" FontWeight="SemiBold"/>

            <!-- Input Device -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Audio_RecordingDevice_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_Audio_RecordingDevice_Description" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.Devices}"
                          SelectedIndex="{x:Bind ViewModel.SelectedDeviceIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Max Recording Duration -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Audio_MaxDuration_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_Audio_MaxDuration_Description" FontSize="12" Opacity="0.6"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.DurationLabels}"
                          SelectedIndex="{x:Bind ViewModel.SelectedDurationIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Audio Ducking -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Audio_Ducking_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_Audio_Ducking_Description" FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.DuckingEnabled, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Duck Level Slider -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Audio_DuckLevel_Label" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <TextBlock l:Uids.Uid="Settings_Audio_DuckLevel_Prefix" FontSize="12" Opacity="0.6"/>
                    <TextBlock Text="{x:Bind ViewModel.DuckLevelPercent, Mode=OneWay}" FontSize="12" Opacity="0.6"/>
                    <TextBlock l:Uids.Uid="Settings_Audio_DuckLevel_Suffix" FontSize="12" Opacity="0.6"/>
                </StackPanel>
                <Slider Minimum="0" Maximum="100" StepFrequency="5"
                        Value="{x:Bind ViewModel.DuckLevelPercent, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.DuckingEnabled, Mode=OneWay}"/>
            </StackPanel>

            <!-- Sound Feedback Section -->
            <TextBlock l:Uids.Uid="Settings_Audio_SoundFeedback_Section" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/>

            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Audio_EnableSounds_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_Audio_EnableSounds_Description" FontSize="12" Opacity="0.6"/>
                <ToggleSwitch IsOn="{x:Bind ViewModel.SoundEnabled, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Dictate Start Sound -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Audio_StartSound_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_Audio_StartSound_Description" FontSize="12" Opacity="0.6"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableSounds}"
                              SelectedIndex="{x:Bind ViewModel.SelectedStartSoundIndex, Mode=TwoWay}"
                              MinWidth="120"
                              IsEnabled="{x:Bind ViewModel.SoundEnabled, Mode=OneWay}"/>
                    <Button Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                            Command="{x:Bind ViewModel.PreviewStartSoundCommand}"
                            IsEnabled="{x:Bind ViewModel.SoundEnabled, Mode=OneWay}"
                            ToolTipService.ToolTip="Preview"/>
                </StackPanel>
            </StackPanel>

            <!-- Dictate Stop Sound -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Audio_StopSound_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_Audio_StopSound_Description" FontSize="12" Opacity="0.6"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableSounds}"
                              SelectedIndex="{x:Bind ViewModel.SelectedStopSoundIndex, Mode=TwoWay}"
                              MinWidth="120"
                              IsEnabled="{x:Bind ViewModel.SoundEnabled, Mode=OneWay}"/>
                    <Button Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                            Command="{x:Bind ViewModel.PreviewStopSoundCommand}"
                            IsEnabled="{x:Bind ViewModel.SoundEnabled, Mode=OneWay}"
                            ToolTipService.ToolTip="Preview"/>
                </StackPanel>
            </StackPanel>

            <!-- Utility Sound -->
            <StackPanel Spacing="4">
                <TextBlock l:Uids.Uid="Settings_Audio_UtilitySound_Label" FontWeight="SemiBold"/>
                <TextBlock l:Uids.Uid="Settings_Audio_UtilitySound_Description" FontSize="12" Opacity="0.6"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableSounds}"
                              SelectedIndex="{x:Bind ViewModel.SelectedUtilitySoundIndex, Mode=TwoWay}"
                              MinWidth="120"
                              IsEnabled="{x:Bind ViewModel.SoundEnabled, Mode=OneWay}"/>
                    <Button Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                            Command="{x:Bind ViewModel.PreviewUtilitySoundCommand}"
                            IsEnabled="{x:Bind ViewModel.SoundEnabled, Mode=OneWay}"
                            ToolTipService.ToolTip="Preview"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
