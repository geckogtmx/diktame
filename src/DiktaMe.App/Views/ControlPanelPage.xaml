<Page
    x:Class="DiktaMe.App.Views.ControlPanelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DiktaMe.App.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:PipelineStateToColorConverter x:Key="StateToColor"/>
    </Page.Resources>

    <Grid Padding="24,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Status indicator -->
        <StackPanel Orientation="Horizontal" Spacing="16" Padding="0,4">
            <Ellipse Width="28" Height="28"
                     Fill="{x:Bind ViewModel.CurrentState, Converter={StaticResource StateToColor}, Mode=OneWay}"/>
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       FontSize="28" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Row 1: Modes Row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                    Visibility="{x:Bind ViewModel.ShowModesRow, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <Button Content="Standard" Command="{x:Bind ViewModel.SetModeCommand}" CommandParameter="Standard" MinWidth="90"/>
            <Button Content="Prompt" Command="{x:Bind ViewModel.SetModeCommand}" CommandParameter="Prompt" MinWidth="90"/>
            <Button Content="Professional" Command="{x:Bind ViewModel.SetModeCommand}" CommandParameter="Professional" MinWidth="90"/>
            <Button Content="RAW" Command="{x:Bind ViewModel.SetModeCommand}" CommandParameter="RAW" MinWidth="90"/>
            <TextBlock Text="{x:Bind ViewModel.ActiveMode, Mode=OneWay}"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       FontStyle="Italic" Opacity="0.6"/>
        </StackPanel>

        <!-- Row 2: Actions Row (quick toggles) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12"
                    Visibility="{x:Bind ViewModel.ShowActionsRow, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <ToggleButton Content="Sound" IsChecked="{x:Bind ViewModel.IsSoundEnabled, Mode=TwoWay}" MinWidth="80"/>
            <ToggleButton Content="Cloud" IsChecked="{x:Bind ViewModel.IsCloudMode, Mode=TwoWay}" MinWidth="80"/>
            <ToggleButton Content="+Key" IsChecked="{x:Bind ViewModel.IsAdditionalKeyEnabled, Mode=TwoWay}" MinWidth="80"/>
            <TextBlock Text="{x:Bind ViewModel.RefineMode, Mode=OneWay}"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       FontSize="12" Opacity="0.5"/>
        </StackPanel>

        <!-- Row 3: Session Stats -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="32"
                    Visibility="{x:Bind ViewModel.ShowSessionStats, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <!-- SESS -->
            <StackPanel Spacing="2">
                <TextBlock Text="SESS" FontSize="11" Opacity="0.5" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.SessionCount, Mode=OneWay}" FontSize="20" FontWeight="Bold"/>
            </StackPanel>
            <!-- WORDS -->
            <StackPanel Spacing="2">
                <TextBlock Text="WORDS" FontSize="11" Opacity="0.5" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.WordCount, Mode=OneWay}" FontSize="20" FontWeight="Bold"/>
            </StackPanel>
            <!-- WPM -->
            <StackPanel Spacing="2">
                <TextBlock Text="WPM" FontSize="11" Opacity="0.5" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.WordsPerMinute, Mode=OneWay}" FontSize="20" FontWeight="Bold"/>
            </StackPanel>
            <!-- TOK -->
            <StackPanel Spacing="2">
                <TextBlock Text="TOK" FontSize="11" Opacity="0.5" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.TokenCount, Mode=OneWay}" FontSize="20" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <!-- Row 4: Performance Stats -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="32"
                    Visibility="{x:Bind ViewModel.ShowPerformanceStats, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <StackPanel Spacing="2">
                <TextBlock Text="REC" FontSize="11" Opacity="0.5" FontWeight="SemiBold"/>
                <TextBlock FontSize="16">
                    <Run Text="{x:Bind ViewModel.LastRecordingMs, Mode=OneWay}"/><Run Text="ms"/>
                </TextBlock>
            </StackPanel>
            <StackPanel Spacing="2">
                <TextBlock Text="TRANS" FontSize="11" Opacity="0.5" FontWeight="SemiBold"/>
                <TextBlock FontSize="16">
                    <Run Text="{x:Bind ViewModel.LastTranscriptionMs, Mode=OneWay}"/><Run Text="ms"/>
                </TextBlock>
            </StackPanel>
            <StackPanel Spacing="2">
                <TextBlock Text="PROC" FontSize="11" Opacity="0.5" FontWeight="SemiBold"/>
                <TextBlock FontSize="16">
                    <Run Text="{x:Bind ViewModel.LastProcessingMs, Mode=OneWay}"/><Run Text="ms"/>
                </TextBlock>
            </StackPanel>
            <StackPanel Spacing="2">
                <TextBlock Text="INJ" FontSize="11" Opacity="0.5" FontWeight="SemiBold"/>
                <TextBlock FontSize="16">
                    <Run Text="{x:Bind ViewModel.LastInjectionMs, Mode=OneWay}"/><Run Text="ms"/>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Row 5: Provider badges + Settings button -->
        <Grid Grid.Row="5" VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Border CornerRadius="4" Padding="10,4"
                        Background="{ThemeResource SystemAccentColorDark2}">
                    <TextBlock Text="{x:Bind ViewModel.SttProviderName, Mode=OneWay}"
                               FontSize="11" Foreground="White"/>
                </Border>
                <Border CornerRadius="4" Padding="10,4"
                        Background="{ThemeResource SystemAccentColorDark2}">
                    <TextBlock Text="{x:Bind ViewModel.LlmProviderName, Mode=OneWay}"
                               FontSize="11" Foreground="White"/>
                </Border>
            </StackPanel>
            <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets"
                    Command="{x:Bind ViewModel.OpenSettingsCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    ToolTipService.ToolTip="Settings"/>
        </Grid>
    </Grid>
</Page>
