<Page
    x:Class="DiktaMe.App.Views.ControlPanelPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DiktaMe.App.Converters"
    xmlns:l="using:WinUI3Localizer"
    FontFamily="{StaticResource AppFont}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:PipelineStateToColorConverter x:Key="StateToColor"/>
    </Page.Resources>

    <Grid x:Name="RootGrid" VerticalAlignment="Top" Background="{StaticResource AppBackgroundBrush}" Padding="0" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>  <!-- VisionRow -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════
             Row 0: Header Bar — Status dot + text + badges + gear
             ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="HeaderBar" Grid.Row="0" Background="{StaticResource AppSurfaceBrush}"
              Padding="12,4,12,11" MinHeight="34">
            <!-- Transparent drag surface — SetTitleBar targets this, not the whole grid.
                 This gives buttons full pointer control (hold-click, etc.) -->
            <Border x:Name="DragRegion" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- Voice waveform container: fixed-size overlay with clipping to prevent
                 the Polyline's measured bounds from influencing Grid layout.
                 Negative margin counteracts HeaderBar padding so the waveform fills edge-to-edge. -->
            <Grid x:Name="WaveformContainer"
                  IsHitTestVisible="False"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Margin="-12,-4,-12,-11">
                <Polyline x:Name="WaveformLine"
                          Stroke="{StaticResource AppAccentBrush}"
                          StrokeThickness="1.5"
                          Opacity="0"
                          IsHitTestVisible="False"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          StrokeLineJoin="Round"/>
                <ContentControl x:Name="WaveformBars"
                                Opacity="0"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"/>
            </Grid>

            <!-- Status area with 3-layer cylinder roll -->
            <Grid x:Name="StatusRollContainer"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  Height="20">

                <!-- Layer A: Status dot + text (normal/home state) -->
                <StackPanel x:Name="StatusLayerA" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" Margin="0,-2,0,0" RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <CompositeTransform x:Name="LayerATransform"/>
                    </StackPanel.RenderTransform>
                    <Ellipse Width="10" Height="10"
                             Fill="{x:Bind ViewModel.CurrentState, Converter={StaticResource StateToColor}, Mode=OneWay}"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusTextBlock"
                               Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AppTextBrush}"
                               CharacterSpacing="100"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="0,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:Name="StatusTextScale" ScaleX="1.0" ScaleY="1.0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </StackPanel>

                <!-- Layer B: Logo + clock (branding) -->
                <StackPanel x:Name="StatusLayerB" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" Margin="0,-3,0,0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <CompositeTransform x:Name="LayerBTransform" TranslateY="20" ScaleY="0.3"/>
                    </StackPanel.RenderTransform>
                    <Image x:Name="BrandingLogo" Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BrandingDateText" FontSize="12" FontWeight="Normal"
                               Foreground="{StaticResource AppTextBrush}"
                               CharacterSpacing="50" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BrandingTimeText" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}"
                               CharacterSpacing="50" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Layer C: Weather icon + temperature -->
                <StackPanel x:Name="StatusLayerC" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" Margin="0,-4,0,0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <CompositeTransform x:Name="LayerCTransform" TranslateY="20" ScaleY="0.3"/>
                    </StackPanel.RenderTransform>
                    <TextBlock x:Name="WeatherIconText"
                               Text="{x:Bind ViewModel.WeatherIcon, Mode=OneWay}"
                               FontSize="14" VerticalAlignment="Center"
                               Foreground="{StaticResource AppTextBrush}"/>
                    <TextBlock x:Name="WeatherTempText"
                               Text="{x:Bind ViewModel.WeatherText, Mode=OneWay}"
                               FontSize="12" FontWeight="Normal"
                               Foreground="{StaticResource AppTextBrush}"
                               CharacterSpacing="50" VerticalAlignment="Center"
                               Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="HeaderButtons" Orientation="Horizontal" Spacing="5"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-1.5,0,0">
                <!-- Wallet balance badge (visible when AuthMode=Wallet) -->
                <Border Background="{StaticResource AppBorderBrush}" CornerRadius="3" Padding="6,2"
                        Visibility="{x:Bind ViewModel.ShowWalletBalance, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{x:Bind ViewModel.WalletBalanceFormatted, Mode=OneWay}"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource AppPerfGreenBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- STT indicator badge -->
                <Border Background="{StaticResource AppSurface2Brush}" CornerRadius="3" Padding="6,1" Width="36">
                    <ToolTipService.ToolTip>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.TooltipBadgeStt, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{x:Bind ViewModel.SttBadgeBrush, Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind ViewModel.SttProviderName, Mode=OneWay}" FontSize="10"
                                       Foreground="{x:Bind ViewModel.SttBadgeBrush, Mode=OneWay}"/>
                        </StackPanel>
                    </ToolTipService.ToolTip>
                    <TextBlock Text="STT" FontSize="11" FontWeight="Bold"
                               Foreground="{x:Bind ViewModel.SttBadgeBrush, Mode=OneWay}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- LLM indicator badge -->
                <Border Background="{StaticResource AppSurface2Brush}" CornerRadius="3" Padding="6,1" Width="36">
                    <ToolTipService.ToolTip>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.TooltipBadgeLlm, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{x:Bind ViewModel.LlmBadgeBrush, Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind ViewModel.LlmProviderName, Mode=OneWay}" FontSize="10"
                                       Foreground="{x:Bind ViewModel.LlmBadgeBrush, Mode=OneWay}"/>
                        </StackPanel>
                    </ToolTipService.ToolTip>
                    <TextBlock Text="LLM" FontSize="11" FontWeight="Bold"
                               Foreground="{x:Bind ViewModel.LlmBadgeBrush, Mode=OneWay}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- TTS indicator badge -->
                <Border Background="{StaticResource AppSurface2Brush}" CornerRadius="3" Padding="6,1" Width="36">
                    <ToolTipService.ToolTip>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.TooltipBadgeTts, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{x:Bind ViewModel.TtsBadgeBrush, Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind ViewModel.TtsProviderName, Mode=OneWay}" FontSize="10"
                                       Foreground="{x:Bind ViewModel.TtsBadgeBrush, Mode=OneWay}"/>
                        </StackPanel>
                    </ToolTipService.ToolTip>
                    <TextBlock Text="TTS" FontSize="11" FontWeight="Bold"
                               Foreground="{x:Bind ViewModel.TtsBadgeBrush, Mode=OneWay}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- Collapse/Expand toggle (hold 500ms to flip direction) -->
                <Button x:Name="CollapseButton"
                        Content="{x:Bind ViewModel.ExpandCollapseIcon, Mode=OneWay}"
                        FontFamily="Segoe MDL2 Assets"
                        Background="Transparent" Foreground="{StaticResource AppTextDimBrush}"
                        BorderThickness="0" Padding="6" FontSize="13"
                        VerticalAlignment="Center" MinWidth="0" MinHeight="0"/>
                <!-- Settings gear -->
                <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets"
                        Command="{x:Bind ViewModel.OpenSettingsCommand}"
                        Background="Transparent" Foreground="{StaticResource AppTextDimBrush}"
                        BorderThickness="0" Padding="6" FontSize="13"
                        VerticalAlignment="Center" MinWidth="0" MinHeight="0"/>
                <!-- Close (hide to tray) -->
                <Button Content="&#xE10A;" FontFamily="Segoe MDL2 Assets"
                        Command="{x:Bind ViewModel.CloseWindowCommand}"
                        Background="Transparent" Foreground="{StaticResource AppTextDimBrush}"
                        BorderThickness="0" Padding="6" FontSize="13"
                        VerticalAlignment="Center" MinWidth="0" MinHeight="0"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════
             Row 1: Dictation Presets (Dynamic 2×4 Grid)
             ═══════════════════════════════════════════════════════════════ -->
        <Border x:Name="ModesRow" Grid.Row="2"
                Visibility="{x:Bind ViewModel.ShowModesRowEffective, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <Grid Padding="8,6">
                <ItemsRepeater x:Name="ModesRepeater"
                               ItemsSource="{x:Bind ViewModel.AvailableModes, Mode=OneWay}"
                               ElementPrepared="ModesRepeater_ElementPrepared">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout Orientation="Horizontal"
                                           MaximumRowsOrColumns="4"
                                           MinItemWidth="80"
                                           MinItemHeight="42"
                                           MinColumnSpacing="6"
                                           MinRowSpacing="6"
                                           ItemsStretch="Fill"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:DictationModeItem" xmlns:vm="using:DiktaMe.App.ViewModels">
                            <Button Command="{Binding ElementName=RootPage, Path=ViewModel.SetModeCommand}"
                                    CommandParameter="{x:Bind Id}"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    MinHeight="42"
                                    Padding="4,3">
                                <Button.Background>
                                    <SolidColorBrush Color="{x:Bind BackgroundHex}"/>
                                </Button.Background>
                                <!-- Hover/pressed colors set programmatically in ModesRepeater_ElementPrepared
                                     because {x:Bind} on SolidColorBrush inside Button.Resources causes NRE
                                     (WinUI can't resolve brush references in ResourceDictionary context) -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{x:Bind Title}"
                                               FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{x:Bind ForegroundHex}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind Subtitle}"
                                               FontSize="9" Opacity="0.7"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{x:Bind ForegroundHex}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             Row 2: Cycle Buttons (6-column: STT | LLM | TTS | SOUND | +KEY | REFINE)
             ═══════════════════════════════════════════════════════════════ -->
        <Border x:Name="ActionsRow" Grid.Row="3"
                Visibility="{x:Bind ViewModel.ShowActionsRowEffective, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <Grid Padding="8,4" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- STT -->
                <Button Grid.Column="0"
                        Command="{x:Bind ViewModel.CycleSttCommand}"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderThickness="0" CornerRadius="4"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="2,4" MinWidth="0" MinHeight="0">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#00506a"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#003a4d"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#00709a"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#004052"/>
                    </Button.Resources>
                    <StackPanel HorizontalAlignment="Center" Spacing="1">
                        <TextBlock l:Uids.Uid="ControlPanel_Toggle_Stt"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextDimBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.SttStateLabel, Mode=OneWay}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{x:Bind ViewModel.SttStateBrush, Mode=OneWay}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- LLM -->
                <Button Grid.Column="1"
                        Command="{x:Bind ViewModel.CycleLlmCommand}"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderThickness="0" CornerRadius="4"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="2,4" MinWidth="0" MinHeight="0">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#00506a"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#003a4d"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#00709a"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#004052"/>
                    </Button.Resources>
                    <StackPanel HorizontalAlignment="Center" Spacing="1">
                        <TextBlock l:Uids.Uid="ControlPanel_Toggle_Llm"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextDimBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.LlmStateLabel, Mode=OneWay}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{x:Bind ViewModel.LlmStateBrush, Mode=OneWay}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- TTS -->
                <Button Grid.Column="2"
                        Command="{x:Bind ViewModel.CycleTtsCommand}"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderThickness="0" CornerRadius="4"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="2,4" MinWidth="0" MinHeight="0">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#00506a"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#003a4d"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#00709a"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#004052"/>
                    </Button.Resources>
                    <StackPanel HorizontalAlignment="Center" Spacing="1">
                        <TextBlock l:Uids.Uid="ControlPanel_Toggle_Tts"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextDimBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.TtsStateLabel, Mode=OneWay}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{x:Bind ViewModel.TtsStateBrush, Mode=OneWay}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- SOUND -->
                <Button Grid.Column="3"
                        Command="{x:Bind ViewModel.CycleSoundCommand}"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderThickness="0" CornerRadius="4"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="2,4" MinWidth="0" MinHeight="0">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#00506a"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#003a4d"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#00709a"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#004052"/>
                    </Button.Resources>
                    <StackPanel HorizontalAlignment="Center" Spacing="1">
                        <TextBlock l:Uids.Uid="ControlPanel_Toggle_Sound"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextDimBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.SoundStateLabel, Mode=OneWay}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{x:Bind ViewModel.SoundStateBrush, Mode=OneWay}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- +KEY -->
                <Button Grid.Column="4"
                        Command="{x:Bind ViewModel.CycleKeyCommand}"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderThickness="0" CornerRadius="4"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="2,4" MinWidth="0" MinHeight="0">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#00506a"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#003a4d"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#00709a"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#004052"/>
                    </Button.Resources>
                    <StackPanel HorizontalAlignment="Center" Spacing="1">
                        <TextBlock l:Uids.Uid="ControlPanel_Toggle_Key"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextDimBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.KeyStateLabel, Mode=OneWay}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{x:Bind ViewModel.KeyStateBrush, Mode=OneWay}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- REFINE -->
                <Button Grid.Column="5"
                        Command="{x:Bind ViewModel.CycleRefineCommand}"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderThickness="0" CornerRadius="4"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="2,4" MinWidth="0" MinHeight="0">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#00506a"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#003a4d"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#00709a"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#004052"/>
                    </Button.Resources>
                    <StackPanel HorizontalAlignment="Center" Spacing="1">
                        <TextBlock l:Uids.Uid="ControlPanel_Toggle_Refine"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextDimBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.RefineStateLabel, Mode=OneWay}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{x:Bind ViewModel.RefineStateBrush, Mode=OneWay}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             Vision Wizard Row — Single row, 5 panels (only one visible at a time)
             See SPEC_002 §21 for the canonical wizard flow.
             ═══════════════════════════════════════════════════════════════ -->
        <Border x:Name="VisionRow" Grid.Row="1"
                Visibility="{x:Bind ViewModel.ShowVisionRow, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Padding="8,4,8,12" Background="{StaticResource AppSurfaceBrush}">

                <!-- ── Panel 1: CaptureType — Image / Video / Color ── -->
                <Grid Visibility="{x:Bind ViewModel.IsStep_CaptureType, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                      ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{x:Bind ViewModel.VisionSelectImageCommand}"
                            Background="{StaticResource AppSurfaceBrush}" BorderThickness="0" CornerRadius="4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="2,6" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="Capture screenshot">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#00506a"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE722;" FontSize="12" Foreground="{StaticResource AppAccentBrush}"/>
                            <TextBlock Text="Image" FontSize="10" Foreground="{StaticResource AppTextBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Command="{x:Bind ViewModel.VisionSelectVideoCommand}"
                            Background="{StaticResource AppSurfaceBrush}" BorderThickness="0" CornerRadius="4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="2,6" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="Record video">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#00506a"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE714;" FontSize="12" Foreground="{StaticResource AppAccentBrush}"/>
                            <TextBlock Text="Video" FontSize="10" Foreground="{StaticResource AppTextBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Command="{x:Bind ViewModel.VisionSelectColorCommand}"
                            Background="{StaticResource AppSurfaceBrush}" BorderThickness="0" CornerRadius="4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="2,6" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="Pick colors">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#00506a"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xEF3C;" FontSize="12" Foreground="{StaticResource AppAccentBrush}"/>
                            <TextBlock Text="Color" FontSize="10" Foreground="{StaticResource AppTextBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3" Command="{x:Bind ViewModel.VisionExitModeCommand}"
                            Background="Transparent" BorderThickness="0" CornerRadius="4"
                            Padding="6,6" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="Cancel">
                        <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource AppTextDimBrush}"/>
                    </Button>
                </Grid>

                <!-- ── Panel 2: CaptureMode — Region / Full Screen ── -->
                <Grid Visibility="{x:Bind ViewModel.IsStep_CaptureMode, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                      ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{x:Bind ViewModel.VisionCaptureRegionCommand}"
                            Background="{StaticResource AppSurfaceBrush}" BorderThickness="0" CornerRadius="4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="2,6" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="Select a region">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#00506a"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE7A5;" FontSize="12" Foreground="{StaticResource AppAccentBrush}"/>
                            <TextBlock Text="Region" FontSize="10" Foreground="{StaticResource AppTextBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Command="{x:Bind ViewModel.VisionCaptureFullCommand}"
                            Background="{StaticResource AppSurfaceBrush}" BorderThickness="0" CornerRadius="4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="2,6" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="Capture full screen">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#00506a"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE740;" FontSize="12" Foreground="{StaticResource AppAccentBrush}"/>
                            <TextBlock Text="Full Screen" FontSize="10" Foreground="{StaticResource AppTextBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Command="{x:Bind ViewModel.VisionExitModeCommand}"
                            Background="Transparent" BorderThickness="0" CornerRadius="4"
                            Padding="6,6" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="Back">
                        <FontIcon Glyph="&#xE72B;" FontSize="10" Foreground="{StaticResource AppTextDimBrush}"/>
                    </Button>
                </Grid>

                <!-- ── Panel 3: Recording — REC dot + timer + pause + stop ── -->
                <Grid Visibility="{x:Bind ViewModel.IsStep_Recording, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                      ColumnSpacing="8" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#FF3333" VerticalAlignment="Center"
                             x:Name="RecordingDot"/>
                    <TextBlock Grid.Column="1" Text="REC" FontSize="10" FontWeight="Bold"
                               Foreground="#FF3333" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.RecordingTimerText, Mode=OneWay}"
                               FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                               Foreground="{StaticResource AppTextBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Command="{x:Bind ViewModel.VisionRecordingPauseToggleCommand}"
                            Background="{StaticResource AppSurfaceBrush}" BorderThickness="0" CornerRadius="4"
                            Padding="8,4" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="Pause / Resume">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#00506a"/>
                        </Button.Resources>
                        <FontIcon Glyph="&#xE769;" FontSize="12" Foreground="{StaticResource AppTextBrush}"/>
                    </Button>
                    <Button Grid.Column="4" Command="{x:Bind ViewModel.VisionRecordingStopCommand}"
                            Background="#992222" BorderThickness="0" CornerRadius="4"
                            Padding="10,4" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="Stop Recording">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#CC3333"/>
                        </Button.Resources>
                        <FontIcon Glyph="&#xE71A;" FontSize="12" Foreground="White"/>
                    </Button>
                </Grid>

                <!-- ── Panel 4: PostCapture — Image or Video actions ── -->
                <Grid Visibility="{x:Bind ViewModel.IsStep_PostCapture, Converter={StaticResource BoolToVis}, Mode=OneWay}">

                <!-- Panel 4a: Image PostCapture — Thumbnail + Save/Clip/Chat/Note/OCR/Edit/✕ -->
                <Grid Visibility="{x:Bind ViewModel.IsVideoPostCapture, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}"
                      ColumnSpacing="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Thumbnail preview -->
                    <Border Grid.Column="0" CornerRadius="3" MaxWidth="48" VerticalAlignment="Center">
                        <Image Source="{x:Bind ViewModel.VisionThumbnail, Mode=OneWay}"
                               Height="32" Stretch="Uniform"/>
                    </Border>

                    <!-- Group 1: Immediate actions (no AI query step) -->
                    <Button Grid.Column="1" Command="{x:Bind ViewModel.VisionChooseActionCommand}" CommandParameter="Save"
                            Background="{StaticResource AppSurfaceBrush}" BorderThickness="0" CornerRadius="4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="1,5" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="Save to file">
                        <Button.Resources><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#00506a"/></Button.Resources>
                        <StackPanel HorizontalAlignment="Center" Spacing="1">
                            <FontIcon Glyph="&#xE74E;" FontSize="11" Foreground="{StaticResource AppAccentBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Save" FontSize="8" Foreground="{StaticResource AppTextDimBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Command="{x:Bind ViewModel.VisionChooseActionCommand}" CommandParameter="Ocr"
                            Background="{StaticResource AppSurfaceBrush}" BorderThickness="0" CornerRadius="4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="1,5" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="OCR text extraction">
                        <Button.Resources><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#00506a"/></Button.Resources>
                        <StackPanel HorizontalAlignment="Center" Spacing="1">
                            <FontIcon Glyph="&#xE8AC;" FontSize="11" Foreground="{StaticResource AppAccentBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="OCR" FontSize="8" Foreground="{StaticResource AppTextDimBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3" Command="{x:Bind ViewModel.VisionChooseActionCommand}" CommandParameter="Edit"
                            Background="{StaticResource AppSurfaceBrush}" BorderThickness="0" CornerRadius="4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="1,5" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="Annotate image">
                        <Button.Resources><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#00506a"/></Button.Resources>
                        <StackPanel HorizontalAlignment="Center" Spacing="1">
                            <FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="{StaticResource AppAccentBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Edit" FontSize="8" Foreground="{StaticResource AppTextDimBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Group 2: AI query actions (proceed to query text field) -->
                    <Button Grid.Column="4" Command="{x:Bind ViewModel.VisionChooseActionCommand}" CommandParameter="Clipboard"
                            Background="#00607a" BorderThickness="0" CornerRadius="4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="1,5" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="AI analyze → clipboard">
                        <Button.Resources><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#007a9a"/></Button.Resources>
                        <StackPanel HorizontalAlignment="Center" Spacing="1">
                            <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Clip" FontSize="8" Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="5" Command="{x:Bind ViewModel.VisionChooseActionCommand}" CommandParameter="Chat"
                            Background="#00607a" BorderThickness="0" CornerRadius="4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="1,5" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="Open in Chat">
                        <Button.Resources><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#007a9a"/></Button.Resources>
                        <StackPanel HorizontalAlignment="Center" Spacing="1">
                            <FontIcon Glyph="&#xE8F2;" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Chat" FontSize="8" Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="6" Command="{x:Bind ViewModel.VisionChooseActionCommand}" CommandParameter="Note"
                            Background="#00607a" BorderThickness="0" CornerRadius="4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="1,5" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="Vision + voice note">
                        <Button.Resources><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#007a9a"/></Button.Resources>
                        <StackPanel HorizontalAlignment="Center" Spacing="1">
                            <FontIcon Glyph="&#xE70B;" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Note" FontSize="8" Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="7" Command="{x:Bind ViewModel.VisionExitModeCommand}"
                            Background="Transparent" BorderThickness="0" CornerRadius="4"
                            Padding="6,5" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="Cancel">
                        <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource AppTextDimBrush}"/>
                    </Button>
                </Grid>

                <!-- Panel 4b: Video PostCapture — Describe/Document/BugReport/Save/✕ -->
                <Grid Visibility="{x:Bind ViewModel.IsVideoPostCapture, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                      ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{x:Bind ViewModel.VisionChooseActionCommand}" CommandParameter="Clipboard"
                            Background="#00607a" BorderThickness="0" CornerRadius="4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="2,6" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="Describe video content">
                        <Button.Resources><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#007a9a"/></Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE8AC;" FontSize="12" Foreground="White"/>
                            <TextBlock Text="Describe" FontSize="10" Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Command="{x:Bind ViewModel.VisionChooseActionCommand}" CommandParameter="Chat"
                            Background="{StaticResource AppSurfaceBrush}" BorderThickness="0" CornerRadius="4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="2,6" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="Document steps">
                        <Button.Resources><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#00506a"/></Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE70B;" FontSize="12" Foreground="{StaticResource AppAccentBrush}"/>
                            <TextBlock Text="Document" FontSize="10" Foreground="{StaticResource AppTextBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Command="{x:Bind ViewModel.VisionChooseActionCommand}" CommandParameter="Note"
                            Background="{StaticResource AppSurfaceBrush}" BorderThickness="0" CornerRadius="4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="2,6" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="Generate bug report">
                        <Button.Resources><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#00506a"/></Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xEBE8;" FontSize="12" Foreground="{StaticResource AppAccentBrush}"/>
                            <TextBlock Text="Bug Report" FontSize="10" Foreground="{StaticResource AppTextBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3" Command="{x:Bind ViewModel.VisionChooseActionCommand}" CommandParameter="Save"
                            Background="{StaticResource AppSurfaceBrush}" BorderThickness="0" CornerRadius="4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="2,6" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="Save video only">
                        <Button.Resources><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#00506a"/></Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE74E;" FontSize="12" Foreground="{StaticResource AppAccentBrush}"/>
                            <TextBlock Text="Save" FontSize="10" Foreground="{StaticResource AppTextBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4" Command="{x:Bind ViewModel.VisionExitModeCommand}"
                            Background="Transparent" BorderThickness="0" CornerRadius="4"
                            Padding="6,6" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="Cancel">
                        <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource AppTextDimBrush}"/>
                    </Button>
                </Grid>

                </Grid> <!-- Close outer PostCapture Grid -->

                <!-- ── Panel 5: Query — TextBox + L/C/— + Go ── -->
                <Grid Visibility="{x:Bind ViewModel.IsStep_Query, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                      Loaded="QueryPanel_Loaded" ColumnSpacing="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.VisionQueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Ask about this image..."
                             FontSize="11" Padding="6,4" MinHeight="0" CornerRadius="4"
                             Background="#15FFFFFF" BorderThickness="1"
                             BorderBrush="{StaticResource AppBorderBrush}"
                             Foreground="{StaticResource AppTextBrush}"/>

                    <Button x:Name="VisionAiLocal" Grid.Column="1"
                            Click="VisionAiToggle_Click" Tag="0" ToolTipService.ToolTip="Local AI"
                            Background="{StaticResource AppSurfaceBrush}" BorderThickness="0" CornerRadius="4"
                            Padding="1,5" MinWidth="36" MinHeight="0">
                        <Button.Resources><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#00506a"/></Button.Resources>
                        <StackPanel HorizontalAlignment="Center" Spacing="1">
                            <FontIcon Glyph="&#xE968;" FontSize="11" Foreground="{StaticResource AppAccentBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="LOC" FontSize="8" Foreground="{StaticResource AppTextDimBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="VisionAiCloud" Grid.Column="2"
                            Click="VisionAiToggle_Click" Tag="1" ToolTipService.ToolTip="Cloud AI"
                            Background="{StaticResource AppSurfaceBrush}" BorderThickness="0" CornerRadius="4"
                            Padding="1,5" MinWidth="36" MinHeight="0">
                        <Button.Resources><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#00506a"/></Button.Resources>
                        <StackPanel HorizontalAlignment="Center" Spacing="1">
                            <FontIcon Glyph="&#xE753;" FontSize="11" Foreground="{StaticResource AppAccentBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="CLD" FontSize="8" Foreground="{StaticResource AppTextDimBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="VisionAiNone" Grid.Column="3"
                            Click="VisionAiToggle_Click" Tag="2" ToolTipService.ToolTip="No AI"
                            Background="{StaticResource AppSurfaceBrush}" BorderThickness="0" CornerRadius="4"
                            Padding="1,5" MinWidth="36" MinHeight="0">
                        <Button.Resources><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#00506a"/></Button.Resources>
                        <StackPanel HorizontalAlignment="Center" Spacing="1">
                            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{StaticResource AppAccentBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="NON" FontSize="8" Foreground="{StaticResource AppTextDimBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4" Command="{x:Bind ViewModel.VisionSubmitQueryCommand}"
                            Background="{StaticResource AppSurfaceBrush}" BorderThickness="0" CornerRadius="4"
                            Padding="1,5" MinWidth="36" MinHeight="0" ToolTipService.ToolTip="Submit query">
                        <Button.Resources><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#00506a"/></Button.Resources>
                        <StackPanel HorizontalAlignment="Center" Spacing="1">
                            <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="#FF8C00" HorizontalAlignment="Center"/>
                            <TextBlock Text="Go" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource AppTextDimBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ── Processing overlay — "Thinking..." ── -->
                <Grid Visibility="{x:Bind ViewModel.IsVisionProcessing, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                      Background="#E0101828" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <ProgressRing IsActive="True" Width="16" Height="16" Foreground="{StaticResource AppAccentBrush}"/>
                        <TextBlock Text="Thinking..." FontSize="11" Foreground="{StaticResource AppTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             Row 4: Session Stats (4-column metric grid)
             ═══════════════════════════════════════════════════════════════ -->
        <Border x:Name="SessionStatsRow" Grid.Row="4"
                Visibility="{x:Bind ViewModel.ShowSessionStatsEffective, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <Grid Background="Transparent" ColumnSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- REQ -->
                <StackPanel Grid.Column="0" Background="{StaticResource AppSurfaceBrush}"
                            Padding="4,6" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" Spacing="2"
                            ToolTipService.ToolTip="{x:Bind ViewModel.TooltipReq, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.RequestCount, Mode=OneWay}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource AppTextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock l:Uids.Uid="ControlPanel_Stat_Req" FontSize="8" CharacterSpacing="50"
                               Foreground="{StaticResource AppTextDimBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- CHAR -->
                <StackPanel Grid.Column="1" Background="{StaticResource AppSurfaceBrush}"
                            Padding="4,6" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" Spacing="2"
                            ToolTipService.ToolTip="{x:Bind ViewModel.TooltipChar, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.CharCount, Mode=OneWay}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource AppTextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock l:Uids.Uid="ControlPanel_Stat_Char" FontSize="8" CharacterSpacing="50"
                               Foreground="{StaticResource AppTextDimBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- WORDS -->
                <StackPanel Grid.Column="2" Background="{StaticResource AppSurfaceBrush}"
                            Padding="4,6" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" Spacing="2"
                            ToolTipService.ToolTip="{x:Bind ViewModel.TooltipWords, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.WordCount, Mode=OneWay}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource AppTextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock l:Uids.Uid="ControlPanel_Stat_Words" FontSize="8" CharacterSpacing="50"
                               Foreground="{StaticResource AppTextDimBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- WORD/MIN -->
                <StackPanel Grid.Column="3" Background="{StaticResource AppSurfaceBrush}"
                            Padding="4,6" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" Spacing="2"
                            ToolTipService.ToolTip="{x:Bind ViewModel.TooltipWordMin, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.WordsPerMinuteFormatted, Mode=OneWay}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource AppTextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock l:Uids.Uid="ControlPanel_Stat_WordMin" FontSize="8" CharacterSpacing="50"
                               Foreground="{StaticResource AppTextDimBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             Row 4: Performance Stats (5-column metric grid)
             ═══════════════════════════════════════════════════════════════ -->
        <Border x:Name="PerfStatsRow" Grid.Row="5"
                Visibility="{x:Bind ViewModel.ShowPerformanceStatsEffective, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <Grid Background="Transparent" ColumnSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- REC -->
                <StackPanel Grid.Column="0" Background="{StaticResource AppSurfaceBrush}"
                            Padding="2,4" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" Spacing="2"
                            ToolTipService.ToolTip="{x:Bind ViewModel.TooltipRec, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.LastRecordingFormatted, Mode=OneWay}"
                               FontSize="12" FontWeight="SemiBold"
                               FontFamily="{StaticResource AppFontMono}"
                               Foreground="{StaticResource AppPerfGreenBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock l:Uids.Uid="ControlPanel_Perf_Rec" FontSize="8" CharacterSpacing="50"
                               Foreground="{StaticResource AppTextDimBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- TRNS -->
                <StackPanel Grid.Column="1" Background="{StaticResource AppSurfaceBrush}"
                            Padding="2,4" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" Spacing="2"
                            ToolTipService.ToolTip="{x:Bind ViewModel.TooltipTrns, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.LastTranscriptionFormatted, Mode=OneWay}"
                               FontSize="12" FontWeight="SemiBold"
                               FontFamily="{StaticResource AppFontMono}"
                               Foreground="{StaticResource AppPerfGreenBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock l:Uids.Uid="ControlPanel_Perf_Trns" FontSize="8" CharacterSpacing="50"
                               Foreground="{StaticResource AppTextDimBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- PROC -->
                <StackPanel Grid.Column="2" Background="{StaticResource AppSurfaceBrush}"
                            Padding="2,4" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" Spacing="2"
                            ToolTipService.ToolTip="{x:Bind ViewModel.TooltipProc, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.LastProcessingFormatted, Mode=OneWay}"
                               FontSize="12" FontWeight="SemiBold"
                               FontFamily="{StaticResource AppFontMono}"
                               Foreground="{StaticResource AppPerfGreenBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock l:Uids.Uid="ControlPanel_Perf_Proc" FontSize="8" CharacterSpacing="50"
                               Foreground="{StaticResource AppTextDimBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- INJ -->
                <StackPanel Grid.Column="3" Background="{StaticResource AppSurfaceBrush}"
                            Padding="2,4" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" Spacing="2"
                            ToolTipService.ToolTip="{x:Bind ViewModel.TooltipInj, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.LastInjectionFormatted, Mode=OneWay}"
                               FontSize="12" FontWeight="SemiBold"
                               FontFamily="{StaticResource AppFontMono}"
                               Foreground="{StaticResource AppPerfGreenBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock l:Uids.Uid="ControlPanel_Perf_Inj" FontSize="8" CharacterSpacing="50"
                               Foreground="{StaticResource AppTextDimBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- TOT -->
                <StackPanel Grid.Column="4" Background="{StaticResource AppSurfaceBrush}"
                            Padding="2,4" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" Spacing="2"
                            ToolTipService.ToolTip="{x:Bind ViewModel.TooltipTot, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.LastTotalFormatted, Mode=OneWay}"
                               FontSize="12" FontWeight="SemiBold"
                               FontFamily="{StaticResource AppFontMono}"
                               Foreground="{StaticResource AppPerfGreenBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock l:Uids.Uid="ControlPanel_Perf_Tot" FontSize="8" CharacterSpacing="50"
                               Foreground="{StaticResource AppTextDimBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             Row 5: Footer — App branding
             ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="FooterRow" Grid.Row="6" Background="{StaticResource AppSurfaceBrush}" Padding="10,4,10,16"
              Visibility="{x:Bind ViewModel.ShowFooterEffective, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <TextBlock Text="dIKta.me V2.0" FontSize="10" FontWeight="Medium"
                       Foreground="#666666"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════
             Visual Effect Overlays (IsHitTestVisible=False = click-through)
             Voice glow: background color modulated directly in code-behind.
             Shimmer/edge overlays placed after content rows for higher Z-order.
             ═══════════════════════════════════════════════════════════════ -->

        <!-- Glassmorphic gradient overlay — subtle purple/magenta diagonal sweep.
             Placed BELOW shimmer/edge-glow overlays so processing effects render on top.
             Gradient stop colors are updated by code-behind on theme change. -->
        <Border Grid.RowSpan="6" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                    <GradientStop x:Name="GlassStop1" Color="#00161530" Offset="0.0"/>
                    <GradientStop x:Name="GlassStop2" Color="#30663399" Offset="0.35"/>
                    <GradientStop x:Name="GlassStop3" Color="#20993366" Offset="0.6"/>
                    <GradientStop x:Name="GlassStop4" Color="#00161530" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Edge glow highlight (top + side edges) -->
        <Border x:Name="EdgeGlow" Grid.Row="0" Grid.RowSpan="7"
                IsHitTestVisible="False" Opacity="0" BorderThickness="2,3,2,0">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop x:Name="EdgeGlowStop1" Color="#0000CCAA" Offset="0.0"/>
                    <GradientStop x:Name="EdgeGlowStop2" Color="#6000CCAA" Offset="0.5"/>
                    <GradientStop x:Name="EdgeGlowStop3" Color="#0000CCAA" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>

        <!-- Shimmer sweep: whole app -->
        <Border x:Name="ShimmerOverlayFull" Grid.Row="0" Grid.RowSpan="7"
                IsHitTestVisible="False" Opacity="0">
            <Border.Background>
                <LinearGradientBrush x:Name="ShimmerBrushFull" StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#00002029" Offset="0.0"/>
                    <GradientStop x:Name="ShimmerStop1Full" Color="#00002029" Offset="0.3"/>
                    <GradientStop x:Name="ShimmerStop2Full" Color="#2800AACC" Offset="0.5"/>
                    <GradientStop x:Name="ShimmerStop3Full" Color="#00002029" Offset="0.7"/>
                    <GradientStop Color="#00002029" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Shimmer sweep: header only -->
        <Border x:Name="ShimmerOverlayHeader" Grid.Row="0"
                IsHitTestVisible="False" Opacity="0">
            <Border.Background>
                <LinearGradientBrush x:Name="ShimmerBrushHeader" StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#00002029" Offset="0.0"/>
                    <GradientStop x:Name="ShimmerStop1Header" Color="#00002029" Offset="0.3"/>
                    <GradientStop x:Name="ShimmerStop2Header" Color="#2800AACC" Offset="0.5"/>
