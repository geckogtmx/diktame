<Page
    x:Class="DiktaMe.App.Views.ControlPanelPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DiktaMe.App.Converters">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:PipelineStateToColorConverter x:Key="StateToColor"/>

        <!-- V1 Color Palette (from V1 CSS variables) -->
        <SolidColorBrush x:Key="V1BackgroundBrush" Color="#002029"/>
        <SolidColorBrush x:Key="V1HeaderBrush" Color="#00303d"/>
        <SolidColorBrush x:Key="V1BorderBrush" Color="#004052"/>
        <SolidColorBrush x:Key="V1ActiveModeBrush" Color="#00607a"/>
        <SolidColorBrush x:Key="V1TextPrimaryBrush" Color="#e0e0e0"/>
        <SolidColorBrush x:Key="V1TextSecondaryBrush" Color="#888888"/>
        <SolidColorBrush x:Key="V1PerfGreenBrush" Color="#7aff9e"/>
        <SolidColorBrush x:Key="V1AuthBadgeBrush" Color="#ff8c00"/>
    </Page.Resources>

    <Grid Background="{StaticResource V1BackgroundBrush}" Padding="0" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════
             Row 0: Header Bar — Status dot + text + badges + gear
             ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="HeaderBar" Grid.Row="0" Background="{StaticResource V1HeaderBrush}"
              Padding="12,4" BorderBrush="{StaticResource V1BorderBrush}"
              BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10"
                         Fill="{x:Bind ViewModel.CurrentState, Converter={StaticResource StateToColor}, Mode=OneWay}"
                         VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource V1TextPrimaryBrush}"
                           CharacterSpacing="100"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel x:Name="HeaderButtons" Orientation="Horizontal" Spacing="5"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- STT badge -->
                <Border Background="{StaticResource V1BorderBrush}" CornerRadius="3" Padding="6,2">
                    <TextBlock Text="{x:Bind ViewModel.SttProviderName, Mode=OneWay}"
                               FontSize="10" FontWeight="Medium"
                               Foreground="{StaticResource V1TextPrimaryBrush}"/>
                </Border>
                <!-- LLM badge -->
                <Border Background="{StaticResource V1BorderBrush}" CornerRadius="3" Padding="6,2">
                    <TextBlock Text="{x:Bind ViewModel.LlmProviderName, Mode=OneWay}"
                               FontSize="10" FontWeight="Medium"
                               Foreground="{StaticResource V1TextPrimaryBrush}"/>
                </Border>
                <!-- Auth badge -->
                <Border Background="{StaticResource V1BorderBrush}" CornerRadius="3" Padding="6,2">
                    <TextBlock Text="{x:Bind ViewModel.AuthBadgeText, Mode=OneWay}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource V1AuthBadgeBrush}"/>
                </Border>
                <!-- Settings gear -->
                <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets"
                        Command="{x:Bind ViewModel.OpenSettingsCommand}"
                        Background="Transparent" Foreground="{StaticResource V1TextSecondaryBrush}"
                        BorderThickness="0" Padding="6" FontSize="14"
                        VerticalAlignment="Center" MinWidth="0" MinHeight="0"/>
                <!-- Close (hide to tray) -->
                <Button Content="&#xE10A;" FontFamily="Segoe MDL2 Assets"
                        Command="{x:Bind ViewModel.CloseWindowCommand}"
                        Background="Transparent" Foreground="{StaticResource V1TextSecondaryBrush}"
                        BorderThickness="0" Padding="6" FontSize="14"
                        VerticalAlignment="Center" MinWidth="0" MinHeight="0"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════
             Row 1: Dictation Presets (Dynamic 2×4 Grid)
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" BorderBrush="{StaticResource V1BorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{x:Bind ViewModel.ShowModesRow, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <Grid Padding="8,6">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.AvailableModes, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout Orientation="Horizontal"
                                           MaximumRowsOrColumns="4"
                                           MinItemWidth="80"
                                           MinItemHeight="42"
                                           MinColumnSpacing="6"
                                           MinRowSpacing="6"
                                           ItemsStretch="Fill"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:DictationModeItem" xmlns:vm="using:DiktaMe.App.ViewModels">
                            <Button Command="{Binding ElementName=RootPage, Path=ViewModel.SetModeCommand}"
                                    CommandParameter="{x:Bind Id}"
                                    BorderBrush="{StaticResource V1BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    MinHeight="42"
                                    Padding="4,3">
                                <Button.Background>
                                    <SolidColorBrush Color="{x:Bind BackgroundHex}"/>
                                </Button.Background>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{x:Bind Title}"
                                               FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{x:Bind ForegroundHex}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind Subtitle}"
                                               FontSize="9" Opacity="0.7"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{x:Bind ForegroundHex}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             Row 2: Toggle Switches (5-column grid)
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" BorderBrush="{StaticResource V1BorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{x:Bind ViewModel.ShowActionsRow, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <Grid Padding="8,6" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SOUND -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsSoundEnabled, Mode=TwoWay}"
                                  MinWidth="0" Padding="0" Margin="12,0,0,0"
                                  OffContent="" OnContent=""/>
                    <TextBlock Text="{x:Bind ViewModel.SoundLabel, Mode=OneWay}"
                               FontSize="9" FontWeight="SemiBold"
                               Foreground="{StaticResource V1TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- LOCAL -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsLocalMode, Mode=TwoWay}"
                                  MinWidth="0" Padding="0" Margin="12,0,0,0"
                                  OffContent="" OnContent=""/>
                    <TextBlock Text="{x:Bind ViewModel.LocalLabel, Mode=OneWay}"
                               FontSize="9" FontWeight="SemiBold"
                               Foreground="{StaticResource V1TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- +KEY -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsAdditionalKeyEnabled, Mode=TwoWay}"
                                  MinWidth="0" Padding="0" Margin="12,0,0,0"
                                  OffContent="" OnContent=""/>
                    <TextBlock Text="{x:Bind ViewModel.KeyLabel, Mode=OneWay}"
                               FontSize="9" FontWeight="SemiBold"
                               Foreground="{StaticResource V1TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- RAW -->
                <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="2">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsRawModeEnabled, Mode=TwoWay}"
                                  MinWidth="0" Padding="0" Margin="12,0,0,0"
                                  OffContent="" OnContent=""/>
                    <TextBlock Text="{x:Bind ViewModel.RawLabel, Mode=OneWay}"
                               FontSize="9" FontWeight="SemiBold"
                               Foreground="{StaticResource V1TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- REFINE -->
                <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="2">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsRefineVoice, Mode=TwoWay}"
                                  MinWidth="0" Padding="0" Margin="12,0,0,0"
                                  OffContent="" OnContent=""/>
                    <TextBlock Text="{x:Bind ViewModel.RefineLabel, Mode=OneWay}"
                               FontSize="9" FontWeight="SemiBold"
                               Foreground="{StaticResource V1TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             Row 3: Session Stats (4-column metric grid)
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" BorderBrush="{StaticResource V1BorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{x:Bind ViewModel.ShowSessionStats, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <Grid Background="{StaticResource V1BorderBrush}" ColumnSpacing="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- REQ -->
                <StackPanel Grid.Column="0" Background="{StaticResource V1HeaderBrush}"
                            Padding="4,6" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" Spacing="2"
                            ToolTipService.ToolTip="Requests this session">
                    <TextBlock Text="{x:Bind ViewModel.RequestCount, Mode=OneWay}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource V1TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="REQ" FontSize="8" CharacterSpacing="50"
                               Foreground="{StaticResource V1TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- CHAR -->
                <StackPanel Grid.Column="1" Background="{StaticResource V1HeaderBrush}"
                            Padding="4,6" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" Spacing="2"
                            ToolTipService.ToolTip="Characters produced">
                    <TextBlock Text="{x:Bind ViewModel.CharCount, Mode=OneWay}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource V1TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="CHAR" FontSize="8" CharacterSpacing="50"
                               Foreground="{StaticResource V1TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- WORDS -->
                <StackPanel Grid.Column="2" Background="{StaticResource V1HeaderBrush}"
                            Padding="4,6" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" Spacing="2"
                            ToolTipService.ToolTip="Words produced">
                    <TextBlock Text="{x:Bind ViewModel.WordCount, Mode=OneWay}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource V1TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="WORDS" FontSize="8" CharacterSpacing="50"
                               Foreground="{StaticResource V1TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- WORD/MIN -->
                <StackPanel Grid.Column="3" Background="{StaticResource V1HeaderBrush}"
                            Padding="4,6" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" Spacing="2"
                            ToolTipService.ToolTip="Words per minute since first request">
                    <TextBlock Text="{x:Bind ViewModel.WordsPerMinuteFormatted, Mode=OneWay}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource V1TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="WORD/MIN" FontSize="8" CharacterSpacing="50"
                               Foreground="{StaticResource V1TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             Row 4: Performance Stats (5-column metric grid)
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" BorderBrush="{StaticResource V1BorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{x:Bind ViewModel.ShowPerformanceStats, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <Grid Background="{StaticResource V1BorderBrush}" ColumnSpacing="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- REC -->
                <StackPanel Grid.Column="0" Background="{StaticResource V1HeaderBrush}"
                            Padding="2,4" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" Spacing="2"
                            ToolTipService.ToolTip="Recording duration">
                    <TextBlock Text="{x:Bind ViewModel.LastRecordingFormatted, Mode=OneWay}"
                               FontSize="12" FontWeight="SemiBold"
                               FontFamily="Consolas"
                               Foreground="{StaticResource V1PerfGreenBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="REC" FontSize="8" CharacterSpacing="50"
                               Foreground="{StaticResource V1TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- TRNS -->
                <StackPanel Grid.Column="1" Background="{StaticResource V1HeaderBrush}"
                            Padding="2,4" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" Spacing="2"
                            ToolTipService.ToolTip="Transcription latency">
                    <TextBlock Text="{x:Bind ViewModel.LastTranscriptionFormatted, Mode=OneWay}"
                               FontSize="12" FontWeight="SemiBold"
                               FontFamily="Consolas"
                               Foreground="{StaticResource V1PerfGreenBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="TRNS" FontSize="8" CharacterSpacing="50"
                               Foreground="{StaticResource V1TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- PROC -->
                <StackPanel Grid.Column="2" Background="{StaticResource V1HeaderBrush}"
                            Padding="2,4" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" Spacing="2"
                            ToolTipService.ToolTip="LLM processing latency">
                    <TextBlock Text="{x:Bind ViewModel.LastProcessingFormatted, Mode=OneWay}"
                               FontSize="12" FontWeight="SemiBold"
                               FontFamily="Consolas"
                               Foreground="{StaticResource V1PerfGreenBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="PROC" FontSize="8" CharacterSpacing="50"
                               Foreground="{StaticResource V1TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- INJ -->
                <StackPanel Grid.Column="3" Background="{StaticResource V1HeaderBrush}"
                            Padding="2,4" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" Spacing="2"
                            ToolTipService.ToolTip="Text injection latency">
                    <TextBlock Text="{x:Bind ViewModel.LastInjectionFormatted, Mode=OneWay}"
                               FontSize="12" FontWeight="SemiBold"
                               FontFamily="Consolas"
                               Foreground="{StaticResource V1PerfGreenBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="INJ" FontSize="8" CharacterSpacing="50"
                               Foreground="{StaticResource V1TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- TOT -->
                <StackPanel Grid.Column="4" Background="{StaticResource V1HeaderBrush}"
                            Padding="2,4" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" Spacing="2"
                            ToolTipService.ToolTip="Total pipeline duration">
                    <TextBlock Text="{x:Bind ViewModel.LastTotalFormatted, Mode=OneWay}"
                               FontSize="12" FontWeight="SemiBold"
                               FontFamily="Consolas"
                               Foreground="{StaticResource V1PerfGreenBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="TOT" FontSize="8" CharacterSpacing="50"
                               Foreground="{StaticResource V1TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             Row 5: Footer — App branding
             ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="5" Background="{StaticResource V1HeaderBrush}" Padding="10,4">
            <TextBlock Text="dIKta.me V2.0" FontSize="10" FontWeight="Medium"
                       Foreground="#666666"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
